---
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';

type Lang = 'zh' | 'en';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 本页在另一种语言下的路径；没有对应页面时指向对方首页 */
  altPath?: string;
}

const { lang, title, description, altPath } = Astro.props;
const isZh = lang === 'zh';
const base = isZh ? '' : '/en';
const path = Astro.url.pathname;
const other = altPath ?? (isZh ? `/en${path === '/' ? '/' : path}` : path.replace(/^\/en/, '') || '/');

const nav = isZh
  ? [
      { href: '/#work', label: '作品', match: '/work' },
      { href: '/notes/', label: '笔记', match: '/notes' },
      { href: '/now/', label: '现在', match: '/now' },
      { href: '/about/', label: '关于', match: '/about' },
    ]
  : [
      { href: '/en/#work', label: 'Work', match: '/en/work' },
      { href: '/en/notes/', label: 'Notes', match: '/en/notes' },
      { href: '/en/now/', label: 'Now', match: '/en/now' },
      { href: '/en/about/', label: 'About', match: '/en/about' },
    ];
const name = isZh ? '李睿涵' : 'Ruihan Li';
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={isZh ? 'zh-CN' : 'en'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isZh ? 'en' : 'zh-CN'} href={new URL(other, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f5f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="name" href={`${base}/`}>{name}</a>
        <nav aria-label={isZh ? '主导航' : 'Primary'}>
          {
            nav.map((n) => (
              <a href={n.href} aria-current={path.startsWith(n.match) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <a class="lang" href={other} hreflang={isZh ? 'en' : 'zh-CN'}>{isZh ? 'EN' : '中'}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap foot">
      <div>
        <p class="foot-name serif">{name}</p>
        <p class="muted">
          {isZh ? '用 Astro 搭建，AI Agent 协助完成。' : 'Built with Astro, with help from AI agents.'}
        </p>
      </div>
      <ul>
        <li><a href="mailto:494564549@qq.com">494564549@qq.com</a></li>
        <li><a href="https://github.com/HanGlen" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://blog.csdn.net/qq_42325493" target="_blank" rel="noopener">CSDN</a></li>
      </ul>
    </footer>

    <Lightbox lang={lang} />

    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .top-inner {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 19px;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  nav a {
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--ink-2);
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--bg-2);
  }

  .lang {
    margin-left: 6px;
    font-family: var(--mono);
    font-size: 12px;
    border: 1px solid var(--line-2);
  }

  .foot {
    margin-top: var(--gap);
    padding-top: 32px;
    padding-bottom: 48px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .foot p {
    margin: 0;
  }

  .foot-name {
    font-size: 18px;
    font-weight: 600;
  }

  .foot ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }

  .foot ul a {
    color: var(--ink-2);
  }

  .foot ul a:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 520px) {
    nav a {
      padding: 6px 7px;
      font-size: 13.5px;
    }
    .name {
      font-size: 17px;
    }
  }
</style>
