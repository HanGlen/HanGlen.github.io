---
/** 可点击的流水线：每一步都附一条真实记录（来自 issue #1805 的评论和合并记录） */
export interface Step {
  key: string;
  title: string;
  actor: string;
  what: string;
  record: { who: string; when: string; ref: string; body: string[] };
}

interface Props {
  steps: Step[];
  recordLabel: string;
  hint: string;
}

const { steps, recordLabel, hint } = Astro.props;
---

<div class="pipe" data-pipe>
  <p class="hint">{hint}</p>
  <div class="rail" role="tablist">
    {
      steps.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`pipe-tab-${s.key}`}
          aria-controls={`pipe-panel-${s.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class={s.actor.includes('HanGlen') || s.actor.includes('车主') ? 'human' : ''}
        >
          <span class="dot" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="t">{s.title}</span>
          <span class="a">{s.actor}</span>
        </button>
      ))
    }
  </div>

  {
    steps.map((s, i) => (
      <section
        class="panel"
        role="tabpanel"
        id={`pipe-panel-${s.key}`}
        aria-labelledby={`pipe-tab-${s.key}`}
        hidden={i !== 0}
      >
        <p class="what">{s.what}</p>
        <article class="record">
          <header>
            <span class="who">{s.record.who}</span>
            <span class="meta">
              {s.record.when} · {s.record.ref}
            </span>
          </header>
          <div class="body">
            {s.record.body.map((line) => (
              <p>{line}</p>
            ))}
          </div>
          <footer>{recordLabel}</footer>
        </article>
      </section>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pipe]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + tabs.length) % tabs.length;
        select(n);
        tabs[n].focus();
      });
    });
  });
</script>

<style>
  .hint {
    margin: 0 0 14px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .rail {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
  }

  button {
    appearance: none;
    background: none;
    border: 0;
    border-top: 3px solid transparent;
    margin-top: -2px;
    padding: 14px 10px 16px 0;
    text-align: left;
    font: inherit;
    color: var(--ink-3);
    cursor: pointer;
    display: grid;
    gap: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  button:hover {
    color: var(--ink);
  }

  button[aria-selected='true'] {
    color: var(--ink);
    border-top-color: var(--accent);
  }

  button.human[aria-selected='true'] {
    border-top-color: var(--ink);
  }

  .dot {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent-ink);
  }

  .human .dot {
    color: var(--ink);
  }

  .t {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.35;
  }

  .a {
    font-size: 12px;
    line-height: 1.4;
  }

  .panel {
    margin-top: 20px;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: start;
  }

  .panel[hidden] {
    display: none;
  }

  .what {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.5;
  }

  .record {
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .record header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    background: var(--bg-2);
  }

  .who {
    font-weight: 600;
  }

  .meta {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .body {
    padding: 14px 16px 6px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .body p {
    margin: 0 0 8px;
  }

  .record footer {
    padding: 8px 16px 12px;
    font-size: 12px;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .rail {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(120px, 1fr);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .rail::-webkit-scrollbar {
      display: none;
    }
    button {
      flex-shrink: 0;
    }
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
