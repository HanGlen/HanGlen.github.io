---
import type { Content } from '../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const e = t.experience;
---

<section class="section" id="experience">
  <div class="wrap">
    <p class="kicker reveal">{e.kicker}</p>
    <h2 class="h2 reveal">{e.heading}</h2>

    <ol class="timeline">
      {
        e.items.map((it) => (
          <li class="reveal">
            <p class="time">{it.time}</p>
            <div>
              <h3>{it.org}</h3>
              <p class="role">{it.role}</p>
              <ul>
                {it.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="grid2">
      <div class="reveal">
        <p class="kicker">{t.skills.kicker}</p>
        <dl class="skills">
          {
            t.skills.groups.map((g) => (
              <div>
                <dt>{g.title}</dt>
                <dd>
                  <ul class="chips">
                    {g.items.map((x) => <li class="chip">{x}</li>)}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="reveal">
        <p class="kicker">{t.writing.kicker}</p>
        <ul class="posts">
          {
            t.writing.items.map((w) => (
              <li>
                <a class="post card" href={w.href} target="_blank" rel="noopener">
                  <span class="post-title">{w.title}</span>
                  <span class="post-desc">{w.desc}</span>
                  <span class="post-link">
                    {w.label} <span aria-hidden="true">↗</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section contact" id="contact">
  <div class="wrap">
    <div class="contact-card card reveal">
      <p class="kicker">{t.contact.kicker}</p>
      <h2>
        <span>{t.contact.heading[0]}</span>
        <span class="gradient-text">{t.contact.heading[1]}</span>
      </h2>
      <div class="contact-actions">
        <a class="btn primary" href={`mailto:${t.contact.email}`}>
          {t.contact.emailLabel} <span class="mono">{t.contact.email}</span>
        </a>
        <a class="btn" href={t.contact.github} target="_blank" rel="noopener">
          {t.contact.githubLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  <footer class="wrap foot">
    <span>{t.footer}</span>
    <a href={t.nav.switchHref}>{t.nav.switchLabel}</a>
  </footer>
</section>

<style>
  .timeline {
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 24px;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
  }

  .time {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
  }

  h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
  }

  .role {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--accent);
  }

  .timeline ul {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .timeline ul li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    color: var(--text-2);
  }

  .timeline ul li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.75em;
    width: 7px;
    height: 1px;
    background: var(--text-3);
  }

  .grid2 {
    margin-top: var(--section);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(32px, 5vw, 72px);
  }

  .skills {
    margin: 24px 0 0;
    display: grid;
    gap: 22px;
  }

  .skills dt {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .skills dd {
    margin: 0;
  }

  .posts {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .post {
    display: grid;
    gap: 8px;
    padding: 22px;
    transition: border-color 0.2s, transform 0.2s;
  }

  .post:hover {
    border-color: rgba(143, 162, 255, 0.4);
    transform: translateY(-2px);
  }

  .post-title {
    font-weight: 600;
  }

  .post-desc {
    font-size: 14px;
    color: var(--text-2);
  }

  .post-link {
    margin-top: 6px;
    font-size: 13px;
    color: var(--accent);
  }

  /* 联系 */
  .contact-card {
    padding: clamp(36px, 7vw, 88px) clamp(24px, 6vw, 80px);
    overflow: hidden;
    background:
      radial-gradient(600px 300px at 90% 0%, rgba(143, 162, 255, 0.18), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
  }

  .contact-card h2 {
    margin: 22px 0 0;
    font-size: clamp(28px, 4.4vw, 52px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 650;
  }

  :lang(zh-CN) .contact-card h2 {
    letter-spacing: 0;
  }

  .contact-card h2 span {
    display: block;
  }

  .contact-actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 15px;
    font-weight: 500;
    transition: transform 0.2s, background 0.2s;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn.primary {
    background: var(--text);
    color: var(--bg);
    border-color: transparent;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 13px;
    opacity: 0.7;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 40px;
    padding-bottom: 40px;
    font-size: 13px;
    color: var(--text-3);
  }

  .foot a:hover {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .timeline > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .grid2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .btn .mono {
      display: none;
    }
  }
</style>
