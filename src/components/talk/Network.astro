---
/**
 * 演讲第 1 部分「我是谁」：中间是我，周围是做过和在做的事，全部正常显示。
 * 颜色是分组（学校 / 工作 / 跑团 / 现在合作），同组的点挨在一起；形状是状态（实心 / 空心 / 虚线）。
 * 悬停或聚焦一个点，右边出大字卡片；← → 依次切换。点的圆心压在坐标上，文字挂在点下面。
 */
import { talk } from '../../i18n/talk';

const m = talk.me;
const nodes = m.nodes;
const C = { x: 480, y: 370 };
const pos = (id: string) => (id === 'center' ? C : nodes.find((n) => n.id === id)!);
const edges = nodes.flatMap((n) => (n.links ?? ['center']).map((to) => ({ id: n.id, group: n.group, status: n.status, from: pos(to), to: n })));
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
---

<section class="slide me" data-slide data-notes={m.notes} aria-labelledby="me-title" data-network>
  <header class="head">
    <p class="no">{m.no}</p>
    <h2 id="me-title">{m.title}</h2>
    <p class="lead">{m.lead}</p>
  </header>

  <div class="body t-body">
    <div class="graph">
      <div class="stage">
        <svg viewBox="0 0 1000 760" aria-hidden="true" preserveAspectRatio="none">
          {
            edges.map((e) => (
              <line
                x1={e.from.x}
                y1={e.from.y}
                x2={e.to.x}
                y2={e.to.y}
                class={`edge g-${e.group} st-${e.status}`}
                data-edge={e.id}
                vector-effect="non-scaling-stroke"
              />
            ))
          }
        </svg>

        <div class="center" style={`left:${pct(C.x, 1000)};top:${pct(C.y, 760)}`}>
          <span class="serif">我</span>
        </div>

        {
          nodes.map((n, i) => (
            <button
              type="button"
              class={`node g-${n.group} st-${n.status}`}
              style={`left:${pct(n.x, 1000)};top:${pct(n.y, 760)};--d:${0.25 + i * 0.05}s`}
              data-node={n.id}
              aria-label={`${n.title}：${n.lines.join('')}`}
            >
              <i class="dot" aria-hidden="true" />
              <span class="lab">{n.label}</span>
            </button>
          ))
        }
      </div>
    </div>

    <aside class="panel" aria-live="polite">
      <div class="card idle" data-idle>
        <p class="name serif">{m.name}</p>
        <p class="role">{m.role}</p>
        <div class="legend">
          <ul>
            {
              m.legendGroup.map((l) => (
                <li>
                  <i class={`sw g-${l.k}`} />
                  {l.v}
                </li>
              ))
            }
          </ul>
          <ul>
            {
              m.legendStatus.map((l) => (
                <li>
                  <i class={`shape st-${l.k}`} />
                  {l.v}
                </li>
              ))
            }
          </ul>
        </div>
        <p class="hint">{m.hint}</p>
      </div>

      {
        nodes.map((n) => (
          <div class={`card g-${n.group}`} data-card={n.id} hidden>
            <p class="tag">
              <i class={`sw g-${n.group}`} />
              {m.groupName[n.group]} · {m.statusName[n.status]}
              {n.when && !n.quiet && <span> · {n.when}</span>}
            </p>
            <h3 class="serif">{n.title}</h3>
            {n.lines.map((l) => <p class="line">{l}</p>)}
            {n.stat && (
              <p class="stat">
                <b class="serif">{n.stat.v}</b>
                <span>{n.stat.k}</span>
              </p>
            )}
            {n.steps && (
              <ol class="steps">
                {n.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
            )}
            {n.img && (
              <figure>
                <img src={n.img.src} alt={n.img.alt} loading="lazy" decoding="async" width="908" height="552" />
                <figcaption>{n.img.cap}</figcaption>
              </figure>
            )}
          </div>
        ))
      }

      <p class="end serif">{m.end}</p>
    </aside>
  </div>
</section>

<style>
  .me {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 5vh, 64px) var(--pad) clamp(20px, 4vh, 44px);
    gap: clamp(12px, 2vh, 24px);
    --school: var(--cat-gold);
    --work: var(--cat-blue);
    --trpg: var(--accent);
    --partner: var(--ok);
  }

  .head {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: 6px 20px;
  }

  .no {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(14px, 1.1vw, 18px);
    color: var(--accent-ink);
  }

  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(32px, 3.4vw, 60px);
    line-height: 1.1;
  }

  .lead {
    margin: 0;
    font-size: clamp(16px, 1.4vw, 24px);
    color: var(--ink-2);
  }

  .body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(320px, 1fr);
    gap: clamp(20px, 3vw, 56px);
    align-items: center;
  }

  .graph {
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    container-type: size;
  }

  .stage {
    position: relative;
    width: min(100cqw, 100cqh * 1000 / 760);
    aspect-ratio: 1000 / 760;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    stroke: var(--line-2);
    stroke-width: 1.2;
    transition: stroke 0.4s, stroke-width 0.4s, opacity 0.4s;
  }

  .edge.st-idea {
    stroke-dasharray: 4 5;
  }

  .edge {
    stroke-width: 1.6;
    opacity: 0.55;
  }
  .edge.g-school {
    stroke: var(--school);
  }
  .edge.g-work {
    stroke: var(--work);
  }
  .edge.g-trpg {
    stroke: var(--trpg);
  }
  .edge.g-partner {
    stroke: var(--partner);
  }
  .edge.on {
    opacity: 1;
    stroke-width: 3;
  }

  .center {
    position: absolute;
    width: clamp(64px, 9cqw, 112px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 0 0 10px var(--accent-soft), 0 0 0 22px color-mix(in srgb, var(--accent-soft) 50%, transparent);
    font-size: clamp(24px, 3.4cqw, 44px);
    font-weight: 600;
    z-index: 2;
  }

  /* 按钮本身就是那个点，圆心压在坐标上；文字绝对定位挂在点下面 */
  .node {
    --c: var(--school);
    --s: clamp(16px, 2.1cqw, 26px);
    position: absolute;
    width: var(--s);
    height: var(--s);
    padding: 0;
    transform: translate(-50%, -50%);
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    z-index: 3;
    transition: transform 0.35s var(--ease);
    animation: pop 0.6s var(--ease) both;
    animation-delay: var(--d);
  }

  .node::before {
    content: '';
    position: absolute;
    inset: -14px;
  }

  .node.g-work {
    --c: var(--work);
  }
  .node.g-trpg {
    --c: var(--trpg);
  }
  .node.g-partner {
    --c: var(--partner);
  }

  .dot {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c);
    border: 3px solid var(--c);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--c) 16%, transparent);
    transition: box-shadow 0.35s;
  }

  .st-doing .dot {
    background: var(--bg);
  }

  .st-idea .dot {
    background: var(--bg);
    border-style: dashed;
    border-width: 2px;
    box-shadow: none;
  }

  .lab {
    position: absolute;
    left: 50%;
    top: calc(100% + 6px);
    transform: translateX(-50%);
    font-size: clamp(14px, 1.95cqw, 22px);
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    text-shadow: 0 0 4px var(--bg), 0 0 8px var(--bg), 0 0 12px var(--bg);
  }

  .st-idea .lab {
    font-weight: 500;
    color: var(--ink-2);
  }

  .node.on {
    transform: translate(-50%, -50%) scale(1.18);
    z-index: 4;
  }

  .node.on .dot {
    box-shadow: 0 0 0 10px color-mix(in srgb, var(--c) 22%, transparent), 0 0 28px color-mix(in srgb, var(--c) 45%, transparent);
  }

  .node:focus-visible {
    outline: none;
  }

  .node:focus-visible .lab {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: var(--r-sm);
  }

  /* —— 右侧卡片 —— */
  .panel {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .card {
    --c: var(--school);
    padding: clamp(22px, 2.4vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    border-top: 4px solid var(--c);
    animation: in 0.45s var(--ease);
    overflow: auto;
    max-height: 100%;
  }

  .card.g-work {
    --c: var(--work);
  }
  .card.g-trpg {
    --c: var(--trpg);
  }
  .card.g-partner {
    --c: var(--partner);
  }

  .card.idle {
    border-top-color: var(--ink);
  }

  .card[hidden] {
    display: none;
  }

  .name {
    margin: 0;
    font-size: clamp(34px, 3.4vw, 60px);
    font-weight: 600;
    line-height: 1.1;
  }

  .role {
    margin: 8px 0 0;
    font-size: clamp(16px, 1.35vw, 22px);
    color: var(--ink-2);
  }

  .legend {
    margin-top: clamp(18px, 3vh, 32px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .legend ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: clamp(14px, 1.05vw, 17px);
    color: var(--ink-2);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sw {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--school);
    flex: none;
  }
  .sw.g-work {
    background: var(--work);
  }
  .sw.g-trpg {
    background: var(--trpg);
  }
  .sw.g-partner {
    background: var(--partner);
  }

  .shape {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2.5px solid var(--ink-2);
    background: var(--ink-2);
    flex: none;
  }
  .shape.st-doing {
    background: transparent;
  }
  .shape.st-idea {
    background: transparent;
    border-style: dashed;
    border-width: 2px;
  }

  .hint {
    margin: clamp(18px, 3vh, 32px) 0 0;
    font-size: clamp(14px, 1.1vw, 18px);
    color: var(--accent-ink);
  }

  .tag {
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: clamp(13px, 1vw, 16px);
    color: var(--ink-3);
  }

  .tag span {
    font-family: var(--mono);
  }

  h3 {
    margin: 0 0 clamp(10px, 1.6vh, 18px);
    font-size: clamp(28px, 2.6vw, 46px);
    font-weight: 600;
    line-height: 1.15;
  }

  .line {
    margin: 0 0 10px;
    font-size: clamp(17px, 1.45vw, 25px);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .stat {
    margin: clamp(12px, 2vh, 22px) 0 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stat b {
    font-size: clamp(34px, 3.4vw, 60px);
    font-weight: 600;
    line-height: 1;
    color: var(--c);
  }

  .stat span {
    font-size: clamp(14px, 1.1vw, 18px);
    color: var(--ink-3);
  }

  .steps {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    counter-reset: s;
  }

  .steps li {
    counter-increment: s;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    font-size: clamp(13px, 1vw, 16px);
  }

  .steps li::before {
    content: counter(s) ' ';
    font-family: var(--mono);
    color: var(--c);
  }

  figure {
    margin: 16px 0 0;
  }

  figure img {
    display: block;
    width: 100%;
    max-height: 34vh;
    object-fit: cover;
    object-position: center;
    border-radius: var(--r-sm);
  }

  figcaption {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .end {
    margin: 16px 0 0;
    font-size: clamp(18px, 1.6vw, 26px);
    font-weight: 600;
    color: var(--ink);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.4);
    }
  }

  .card.back {
    animation-name: in-back;
  }

  @keyframes in {
    from {
      opacity: 0;
      transform: translateX(40px);
      filter: blur(6px);
    }
  }

  @keyframes in-back {
    from {
      opacity: 0;
      transform: translateX(-40px);
      filter: blur(6px);
    }
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: auto 1fr;
    }
    .lead {
      grid-column: 1 / -1;
    }
    .body {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .graph {
      height: auto;
      container-type: inline-size;
    }
    .stage {
      width: 100%;
    }
    .lab {
      font-size: clamp(10px, 2.6cqw, 14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node,
    .card {
      animation: none;
    }
    .node {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-network]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const idle = root.querySelector<HTMLElement>('[data-idle]')!;
    let cur = -1;

    function show(i: number) {
      if (i === cur) return;
      const id = nodes[i].dataset.node!;
      const back = cur > i;
      cur = i;
      nodes.forEach((n, j) => n.classList.toggle('on', j === i));
      root.querySelectorAll<SVGLineElement>('[data-edge]').forEach((e) => e.classList.toggle('on', e.dataset.edge === id));
      idle.hidden = true;
      root.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => {
        c.hidden = c.dataset.card !== id;
        c.classList.toggle('back', back);
      });
    }

    nodes.forEach((n, i) => {
      n.addEventListener('pointerenter', () => show(i));
      n.addEventListener('focus', () => show(i));
      n.addEventListener('click', () => show(i));
    });

    // 这一页在台上时，← → 依次讲下一个点
    document.addEventListener('keydown', (e) => {
      if (!root.classList.contains('is-current')) return;
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = cur < 0 ? (e.key === 'ArrowRight' ? 0 : nodes.length - 1) : (cur + (e.key === 'ArrowRight' ? 1 : -1) + nodes.length) % nodes.length;
      nodes[next].focus({ preventScroll: true });
    });
  }
</script>
