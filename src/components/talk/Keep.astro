---
/**
 * 演讲 05「怎么维护和迭代」：收反馈、开单 → 接上流水线 → 两条时间线。
 * 版式照 04（共用 Talk.astro 里的 .t-steps）：顶上步骤条，左图右文，例子在底部色块。
 * 全程跟着同一条真实反馈（HAN-1688）走；最后一步把它和一个大需求（装备商店）的时间线并排。
 */
import { talk } from '../../i18n/talk';

const k = talk.keep;
const L = k.levels;

// 时间线：第一个点到第二个点是「等」的那一段，画成虚线、压到 0–36%，旁边写实际等了多久；
// 后面的点按真实时间铺在 36–100%。挨得太近的点至少隔 4%，顺序不变。
const ms = (t: string) => new Date(`${t}:00+08:00`).getTime();
const dur = (a: string, b: string) => {
  const m = Math.round((ms(b) - ms(a)) / 60000);
  const d = Math.floor(m / 1440);
  const h = Math.floor((m % 1440) / 60);
  const mm = m % 60;
  return d ? `${d} 天 ${h} 小时` : `${h} 小时 ${mm} 分`;
};
const GAP = 36;
const MIN = 4;
const lanes = k.tl.lanes.map((lane) => {
  const p = lane.pts;
  const t0 = ms(p[1].t);
  const t1 = ms(p[p.length - 1].t);
  const xs = p.map((pt, i) => (i === 0 ? 0 : GAP + ((ms(pt.t) - t0) / (t1 - t0)) * (100 - GAP)));
  for (let i = xs.length - 2; i >= 1; i--) xs[i] = Math.min(xs[i], xs[i + 1] - MIN);
  return { ...lane, xs, wait: dur(p[0].t, p[1].t) };
});
---

<section class="slide t-slide keep" data-slide data-notes={k.notes} aria-labelledby="keep-title">
  <header class="t-head">
    <p class="no">{k.no}</p>
    <h2 id="keep-title">{k.title}</h2>
    <p class="lead">{k.lead}</p>
  </header>

  <div class="body t-body t-steps" data-stepper style={`--n: ${L.length}`}>
    <ol class="line" role="tablist" aria-label={k.title}>
      {
        L.map((l, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true">{i + 1}</i>
              <span>{l.k}</span>
              <em>{l.tag}</em>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="main">
      <div class="stage">
        <!-- 1 收反馈、开单：小程序里一句话 → 飞书表的一行 → 定时任务开成单 -->
        <div class="frame" data-pane="0">
          <div class="flow">
            <div class="phone fin" style="--d:0">
              <p class="ph">{k.intake.app}</p>
              <p class="bubble">{k.intake.quote}</p>
            </div>
            <span class="arr fin" style="--d:2">→</span>
            <div class="sheet fin" style="--d:3">
              <p class="sh">{k.intake.table}</p>
              <div class="tr th">
                {k.intake.cols.map((c) => <span>{c}</span>)}
              </div>
              <div class="tr hot">
                <span>{k.intake.row.t}</span>
                <b class="pill flip"><span class="new">{k.intake.row.st}</span><span class="ok">{k.intake.done}</span></b>
              </div>
              {
                [0, 1].map(() => (
                  <div class="tr ghost" aria-hidden="true">
                    <span class="bar" />
                    <b class="pill">{k.intake.done}</b>
                  </div>
                ))
              }
            </div>
            <span class="arr fin" style="--d:5">→</span>
            <div class="clockbox fin" style="--d:6">
              <span class="clock" aria-hidden="true">◷</span>
              <b>{k.open.clock}</b>
              <small>{k.open.clockV}</small>
            </div>
            <span class="arr fin" style="--d:7">→</span>
            <span class="chip card fin" style="--d:8">{k.open.card}</span>
          </div>
        </div>

        <!-- 2 接上流水线：框外是杂乱的需求；从分诊 AI 到合并整体框起来，就是 04 那套系统 -->
        <div class="frame" data-pane="1" hidden>
          <div class="joinrow">
            <div class="pile fin" style="--d:0">
              <p class="pk">{k.join.pile}</p>
              <ul>
                {k.join.sources.map((x, i) => <li class={i === 0 ? 'on' : ''} style={`--r:${[-3, 2, -1][i]}deg`}>{x}</li>)}
              </ul>
              <span class="chip card">{k.join.card}</span>
            </div>
            <span class="arr fin" style="--d:1">→</span>
            <div class="sysbox fin" style="--d:2">
              <p class="ck">{k.join.flow}</p>
              <div class="flow">
                <div class="butler">
                  <b>{k.join.butler}</b>
                  <span>{k.join.butlerV}</span>
                </div>
                <span class="arr">→</span>
                <ul class="lanes">
                  {k.join.lanes.map((x, i) => <li class={i === 0 ? 'on' : ''}>{x}</li>)}
                </ul>
              </div>
              <ol class="chain">
                {
                  k.join.chain.map((c, i) => (
                    <li class={`fin${i === 3 || i === 4 ? ' gate' : ''}${i === k.join.chain.length - 1 ? ' done' : ''}`} style={`--d:${4 + i}`}>
                      <b>{c.k}</b>
                      <span>{c.ex}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>

        <!-- 3 两条时间线：每个点是一步，悬停、聚焦或点一下看时间和事 -->
        <div class="frame" data-pane="2" hidden>
          <div class="tl" data-tl>
            {
              lanes.map((lane, li) => (
                <div class="lane fin" style={`--d:${li * 2}`}>
                  <p class="lh">
                    <b class="serif">{lane.k}</b>
                    <span>{lane.v}</span>
                    <em>{lane.sum}</em>
                    <small>{lane.sub}</small>
                  </p>
                  <div class="track">
                    <span class="wait" style={`width:${lane.xs[1]}%`}>
                      <small>
                        {lane.gap.k} · {lane.wait}
                      </small>
                    </span>
                    <span class="run" style={`left:${lane.xs[1]}%`} />
                    {lane.pts.map((pt, i) => (
                      <button
                        type="button"
                        class={`dot${pt.end ? ' end' : ''}`}
                        style={`left:${lane.xs[i]}%`}
                        data-at={pt.at}
                        data-k={pt.k}
                        aria-label={`${pt.at} ${pt.k}`}
                      />
                    ))}
                    <span class="t0">{lane.pts[0].at}</span>
                    <span class="t1">{lane.pts[lane.pts.length - 1].at}</span>
                  </div>
                </div>
              ))
            }
            <p class="out" data-tl-out data-hint={k.tl.hint} aria-live="polite">{k.tl.hint}</p>
          </div>
        </div>
      </div>

      <aside class="side" aria-live="polite">
        {
          L.map((l, i) => (
            <div class="sp" data-pane={String(i)} hidden={i !== 0}>
              <h3 class="serif">{l.q}</h3>
              <p class="plain">{l.plain}</p>
            </div>
          ))
        }
        <p class="t-hint">{k.hint}</p>
      </aside>
    </div>

    {
      L.map((l, i) => (
        <div class="ex" data-pane={String(i)} hidden={i !== 0}>
          <b>{k.caseK}</b>
          <p>{l.case}</p>
          {l.src && (
            <details class="src">
              <summary>{k.srcK}</summary>
              <p>{l.src}</p>
            </details>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .stage {
    min-width: 0;
  }

  .flow {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 16px);
  }

  .arr {
    flex: none;
    font-size: clamp(18px, 1.6vw, 28px);
    color: var(--ink-3);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em 0.9em;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--line-2);
    background: var(--card);
    font-size: clamp(14px, 1.3vw, 24px);
    white-space: nowrap;
  }

  .chip.card {
    font-family: var(--mono);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .pill {
    flex: none;
    padding: 2px 10px;
    border-radius: var(--r-pill);
    font-size: clamp(12px, 0.95vw, 16px);
    font-weight: 600;
    color: var(--ink-3);
    background: var(--bg-2);
  }

  .pill.new {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }

  .pill.ok {
    color: var(--ok);
    background: var(--ok-soft);
  }

  /* 小程序里的一屏：只画一个圆角框，不画手机外壳 */
  .phone {
    flex: 1 1 0;
    min-width: 0;
    padding: clamp(14px, 1.4vw, 24px);
    border: 1.5px solid var(--line-2);
    border-radius: calc(var(--r) * 1.6);
    background: var(--card);
    box-shadow: var(--shadow);
  }

  .ph,
  .sh {
    margin: 0 0 12px;
    font-size: clamp(13px, 1vw, 17px);
    font-weight: 600;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .bubble {
    margin: 0;
    padding: 0.7em 0.9em;
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    font-size: clamp(16px, 1.45vw, 26px);
    line-height: 1.45;
  }

  .log {
    margin: 0;
    padding-left: 0.9em;
    border-left: 3px solid var(--accent);
    font-size: clamp(15px, 1.3vw, 23px);
    line-height: 1.45;
  }

  .sheet {
    flex: 1.3 1 0;
    min-width: 0;
    padding: clamp(14px, 1.4vw, 24px);
    border: 1.5px solid var(--line-2);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
  }

  .tr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0.55em 0;
    border-top: 1px solid var(--line);
    font-size: clamp(15px, 1.3vw, 23px);
  }

  .tr.th {
    border-top: 0;
    font-size: clamp(12px, 0.95vw, 15px);
    color: var(--ink-3);
  }

  .tr.hot span {
    font-weight: 600;
  }

  .tr.ghost {
    opacity: 0.5;
  }

  .bar {
    flex: 1;
    max-width: 60%;
    height: 0.6em;
    border-radius: var(--r-pill);
    background: var(--line-2);
  }

  .clockbox,
  .butler,
  .pipe,
  .note {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: clamp(12px, 1.2vw, 20px);
    border-radius: var(--r);
    border: 1.5px solid var(--line-2);
    background: var(--card);
  }

  .clockbox {
    flex: none;
    align-items: center;
    text-align: center;
    border-style: dashed;
  }

  .clock {
    font-size: clamp(26px, 2.4vw, 42px);
    line-height: 1;
    color: var(--accent);
  }

  .clockbox b,
  .butler b,
  .pipe b {
    font-size: clamp(16px, 1.45vw, 26px);
  }

  .clockbox small,
  .butler span,
  .pipe span,
  .note small {
    font-size: clamp(12px, 0.95vw, 16px);
    color: var(--ink-3);
  }

  .butler {
    flex: none;
    border-color: var(--ink);
  }

  .pipe {
    flex: 1 1 0;
    min-width: 0;
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .note {
    flex: none;
  }

  .note b {
    font-family: var(--mono);
    font-size: clamp(16px, 1.45vw, 26px);
  }

  .lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .lanes li {
    padding: 0.4em 0.8em;
    border-radius: var(--r-sm);
    border: 1.5px dashed var(--line-2);
    font-size: clamp(14px, 1.2vw, 21px);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .lanes li.on {
    border-style: solid;
    border-color: var(--accent);
    color: var(--ink);
    background: var(--card);
  }

  /* 2：那一行状态变了 */
  /* 1：那一行的状态先是「新反馈」，定时任务开单后翻成「已转单」 */
  .pill.flip {
    display: inline-grid;
    padding: 0;
    background: none;
  }

  .pill.flip span {
    grid-area: 1 / 1;
    padding: 2px 10px;
    border-radius: var(--r-pill);
    text-align: center;
  }

  .pill.flip .new {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }

  .pill.flip .ok {
    color: var(--ok);
    background: var(--ok-soft);
    opacity: 0;
  }

  .frame:not([hidden]) .pill.flip .new {
    animation: keep-out 0.4s var(--ease) both;
    animation-delay: 1.6s;
  }

  .frame:not([hidden]) .pill.flip .ok {
    animation: keep-pop 0.5s var(--ease) both;
    animation-delay: 1.7s;
  }

  @keyframes keep-out {
    to {
      opacity: 0;
      transform: scale(0.8);
    }
  }

  @keyframes keep-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
    }
  }

  /* 2：左边一堆杂乱需求，右边从分诊 AI 到合并整个框起来 */
  .joinrow {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(10px, 1.2vw, 20px);
  }

  .pile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .pk {
    margin: 0;
    font-size: clamp(13px, 1vw, 17px);
    color: var(--ink-3);
  }

  .pile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pile li {
    padding: 6px 12px;
    border: 1px dashed var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
    font-size: clamp(13px, 1vw, 17px);
    color: var(--ink-2);
    transform: rotate(var(--r));
  }

  .pile li.on {
    border-style: solid;
    border-color: var(--accent);
    color: var(--ink);
  }

  .sysbox {
    padding: clamp(12px, 1.8vh, 22px) clamp(12px, 1.2vw, 22px);
    border: 2px solid var(--accent);
    border-radius: var(--r);
    background: var(--bg-2);
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.6vh, 18px);
  }

  .sysbox .ck {
    margin: 0;
    color: var(--accent-ink);
  }

  .sysbox .flow {
    justify-content: flex-start;
  }

  .sysbox .chain {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .joinrow {
      grid-template-columns: 1fr;
    }
    .joinrow > .arr {
      transform: rotate(90deg);
      justify-self: start;
    }
  }

  /* 2：04 那条流水线，写 HAN-1688 走过的真实时间 */
  .chainbox {
    margin-top: clamp(18px, 3.4vh, 40px);
    padding: clamp(12px, 1.6vh, 20px) clamp(12px, 1.2vw, 20px);
    border-radius: var(--r);
    background: var(--bg-2);
  }

  .ck {
    margin: 0 0 clamp(8px, 1.2vh, 14px);
    font-size: clamp(13px, 1vw, 17px);
    font-weight: 600;
    color: var(--ink-2);
  }

  .chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(6px, 0.6vw, 12px);
    counter-reset: c;
  }

  .chain li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0.6em 0.7em;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--line-2);
    background: var(--card);
  }

  .chain li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: calc(-1 * clamp(6px, 0.6vw, 12px));
    top: 50%;
    transform: translate(50%, -50%);
    font-size: 12px;
    color: var(--ink-3);
  }

  .chain b {
    font-size: clamp(13px, 1.05vw, 18px);
    font-weight: 600;
    white-space: nowrap;
  }

  .chain span {
    font-size: clamp(12px, 0.9vw, 15px);
    color: var(--ink-3);
  }

  .chain li.gate {
    border-style: dashed;
  }

  .chain li.done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .chain li.done span {
    color: color-mix(in srgb, var(--bg) 75%, transparent);
  }

  /* 4：回到用户 */
  .ret {
    align-self: flex-start;
    margin: clamp(14px, 2.4vh, 28px) 0 0;
    padding: 6px 16px;
    border-radius: var(--r-pill);
    font-size: clamp(14px, 1.2vw, 20px);
    font-weight: 600;
    color: var(--bg);
    background: var(--ok);
  }

  /* 5：两条时间线 */
  .tl {
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 4.4vh, 48px);
  }

  .lh {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0 0 clamp(20px, 3vh, 34px);
  }

  .lh b {
    font-size: clamp(22px, 2vw, 34px);
    font-weight: 600;
  }

  .lh span {
    color: var(--ink-3);
    font-size: clamp(14px, 1.15vw, 20px);
  }

  .lh em {
    font-style: normal;
    font-weight: 600;
    color: var(--accent-ink);
    font-size: clamp(15px, 1.3vw, 23px);
  }

  .lh small {
    color: var(--ink-3);
    font-size: clamp(13px, 1vw, 17px);
  }

  .track {
    position: relative;
    height: 2px;
    margin: 0 9px 30px;
  }

  .wait {
    position: absolute;
    left: 0;
    top: 0;
    border-top: 2px dashed var(--line-2);
  }

  .wait small {
    position: absolute;
    left: 0;
    bottom: 10px;
    white-space: nowrap;
    font-size: clamp(12px, 0.95vw, 15px);
    color: var(--ink-3);
  }

  .run {
    position: absolute;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--accent);
  }

  .dot {
    position: absolute;
    top: 1px;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    padding: 0;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
    cursor: pointer;
    transition: transform 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .dot.end {
    background: var(--ok);
    border-color: var(--ok);
  }

  .dot:hover,
  .dot:focus-visible,
  .dot[aria-pressed='true'] {
    outline: none;
    transform: scale(1.35);
    background: var(--accent);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .dot.end:hover,
  .dot.end:focus-visible,
  .dot.end[aria-pressed='true'] {
    background: var(--ok);
    box-shadow: 0 0 0 6px var(--ok-soft);
  }

  .t0,
  .t1 {
    position: absolute;
    top: 14px;
    font-family: var(--mono);
    font-size: clamp(11px, 0.85vw, 14px);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .t0 {
    left: -9px;
  }

  .t1 {
    right: -9px;
  }

  .out {
    margin: 0;
    min-height: 1.5em;
    font-size: clamp(16px, 1.45vw, 26px);
    color: var(--ink-3);
  }

  .out.on {
    color: var(--accent-ink);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .flow {
      flex-direction: column;
      align-items: stretch;
    }
    .flow > .arr {
      transform: rotate(90deg);
      align-self: center;
    }
    .lanes {
      flex-direction: row;
      justify-content: center;
    }
    .clockbox,
    .butler {
      align-self: stretch;
    }
    .chain {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .chain li::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame .pill.flip span {
      animation: none !important;
    }
    .pill.flip .new {
      opacity: 0;
    }
    .pill.flip .ok {
      opacity: 1;
    }
    .dot {
      transition: none;
    }
  }
</style>

<script>
  // 时间线：悬停、聚焦或点一个点，下面一行写这一步的时间和事；点一下钉住
  document.querySelectorAll<HTMLElement>('[data-tl]').forEach((root) => {
    const out = root.querySelector<HTMLElement>('[data-tl-out]')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    let pinned: HTMLButtonElement | null = null;
    const show = (b: HTMLButtonElement | null) => {
      out.textContent = b ? `${b.dataset.at} · ${b.dataset.k}` : out.dataset.hint!;
      out.classList.toggle('on', !!b);
      dots.forEach((x) => x.setAttribute('aria-pressed', String(x === pinned)));
    };
    dots.forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      b.addEventListener('mouseenter', () => show(b));
      b.addEventListener('mouseleave', () => show(pinned));
      b.addEventListener('focus', () => show(b));
      b.addEventListener('blur', () => show(pinned));
      b.addEventListener('click', () => {
        pinned = pinned === b ? null : b;
        show(pinned ?? b);
      });
    });
  });
</script>
