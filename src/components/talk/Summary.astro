---
/**
 * 演讲 07 总结：回答封面的三个问题，每张卡「以前 → 现在」；← → 或悬停一问一问讲，讲过的保持亮着。
 * 「谢谢」和微信二维码在下一页 08 交流与合作。
 */
import { talk } from '../../i18n/talk';

const s = talk.sum;
---

<section class="slide t-slide sum" data-slide data-notes={s.notes} aria-labelledby="sum-title">
  <header class="t-head">
    <p class="no">{s.no}</p>
    <h2 id="sum-title">{s.title}</h2>
    <p class="lead">{s.lead}</p>
  </header>

  <div class="body t-body" data-stepper data-hover>
    <ol role="tablist" aria-label={s.title}>
      {
        s.items.map((it, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i>{String(i + 1).padStart(2, '0')}</i>
              <b class="serif">{it.q}</b>
              <p class="was" aria-label={`${s.beforeK}：${it.before}`}>{it.before}</p>
              <p class="now" aria-label={`${s.nowK}：${it.now}`}><i aria-hidden="true">→</i>{it.now}</p>
              <em>{it.ref}</em>
            </button>
          </li>
        ))
      }
    </ol>
    <p class="t-hint">{s.hint}</p>
  </div>
</section>

<style>
  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 4vh, 48px);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 36px);
  }

  button {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(12px, 2vh, 22px);
    min-height: min(46vh, 480px);
    padding: clamp(20px, 2.4vw, 44px);
    font: inherit;
    text-align: left;
    color: var(--ink-3);
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--line-2);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), border-color 0.3s;
  }

  button.seen {
    opacity: 1;
    color: var(--ink-2);
  }

  button[aria-selected='true'] {
    border-top-color: var(--accent);
    transform: translateY(-4px);
    color: var(--ink);
  }

  button i {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(13px, 1vw, 17px);
    color: var(--accent-ink);
  }

  button b {
    font-size: clamp(22px, 2.3vw, 42px);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }

  button span {
    font-size: clamp(16px, 1.35vw, 24px);
    line-height: 1.5;
  }

  button em {
    margin-top: auto;
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.9vw, 15px);
    color: var(--ink-3);
  }

  button p {
    margin: 0;
    line-height: 1.3;
  }

  /* 以前：划掉但看得清（投影上浅灰会消失） */
  .was {
    font-size: clamp(17px, 1.6vw, 28px);
    color: var(--ink-2);
    text-decoration: line-through;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .now {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--serif);
    font-size: clamp(26px, 2.9vw, 54px);
    line-height: 1.15;
    font-weight: 600;
    color: var(--accent);
  }

  .now i {
    font-style: normal;
    font-size: 0.7em;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    ol {
      grid-template-columns: 1fr;
    }
    button {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
