---
/**
 * 演讲 07 总结：回答封面的三个问题，每张卡「以前 → 现在」；← → 或悬停一问一问讲，讲过的保持亮着。
 * 「谢谢」和微信二维码在下一页 08 交流与合作。
 */
import { talk } from '../../i18n/talk';

const s = talk.sum;
---

<section class="slide t-slide sum" data-slide data-notes={s.notes} aria-labelledby="sum-title">
  <header class="t-head">
    <p class="no">{s.no}</p>
    <h2 id="sum-title">{s.title}</h2>
    <p class="lead">{s.lead}</p>
  </header>

  <div class="body t-body" data-stepper data-hover>
    <ol role="tablist" aria-label={s.title}>
      {
        s.items.map((it, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i>{String(i + 1).padStart(2, '0')}</i>
              <b class="serif">{it.q}</b>
              <p class="was"><small>{s.beforeK}</small>{it.before}</p>
              <p class="now"><small>{s.nowK}</small>{it.now}</p>
              <em>{it.ref}</em>
            </button>
          </li>
        ))
      }
    </ol>
    <p class="t-hint">{s.hint}</p>
  </div>
</section>

<style>
  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 4vh, 48px);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 36px);
  }

  button {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: clamp(18px, 2vw, 36px);
    font: inherit;
    text-align: left;
    color: var(--ink-3);
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--line-2);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), border-color 0.3s;
  }

  button.seen {
    opacity: 1;
    color: var(--ink-2);
  }

  button[aria-selected='true'] {
    border-top-color: var(--accent);
    transform: translateY(-4px);
    color: var(--ink);
  }

  button i {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(13px, 1vw, 17px);
    color: var(--accent-ink);
  }

  button b {
    font-size: clamp(24px, 2.3vw, 42px);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }

  button span {
    font-size: clamp(16px, 1.35vw, 24px);
    line-height: 1.5;
  }

  button em {
    margin-top: auto;
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.9vw, 15px);
    color: var(--ink-3);
  }

  button p {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.45;
  }

  button p small {
    font-family: var(--mono);
    font-size: clamp(11px, 0.8vw, 14px);
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .was {
    font-size: clamp(15px, 1.2vw, 21px);
    color: var(--ink-3);
  }

  .now {
    font-size: clamp(18px, 1.55vw, 28px);
    font-weight: 600;
    color: var(--ink);
  }

  .now small {
    color: var(--accent-ink);
  }

  @media (max-width: 900px) {
    ol {
      grid-template-columns: 1fr;
    }
    button {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
