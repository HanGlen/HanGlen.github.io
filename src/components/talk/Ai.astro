---
/**
 * 演讲 05「怎么用上 AI 能力」：用小程序的规则问答讲 AI 功能的四步（理解 → 查原文 → 回答 → 逐句核对），
 * 右边是真实截图；下面把「规则书」换成企业自己的资料，再给三条落地要点。← → 或悬停一步步讲。
 */
import { talk } from '../../i18n/talk';

const a = talk.ai;
---

<section class="slide t-slide ai" data-slide data-notes={a.notes} aria-labelledby="ai-title">
  <header class="t-head">
    <p class="kicker">{a.no} · {a.kicker}</p>
    <h2 id="ai-title">{a.title}</h2>
    <p class="lead">{a.lead}</p>
  </header>

  <div class="body t-body" data-stepper data-hover>
    <div class="left">
      <ol class="steps" role="tablist" aria-label={a.title}>
        {
          a.steps.map((s, i) => (
            <li>
              <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
                <i>{i + 1}</i>
                <b>{s.k}</b>
                <em>{s.en}</em>
              </button>
            </li>
          ))
        }
      </ol>
      <div class="detail">
        {
          a.steps.map((s, i) => (
            <p data-pane={String(i)} hidden={i !== 0}>
              {s.v}
            </p>
          ))
        }
      </div>

      <div class="map">
        <p class="mk">{a.map.k}</p>
        {
          a.map.rows.map((r) => (
            <p class="mr">
              <s>{r.from}</s>
              <span aria-hidden="true">→</span>
              <b>{r.to}</b>
            </p>
          ))
        }
      </div>

      <ul class="rules">
        {
          a.rules.map((r) => (
            <li>
              <b class="serif">{r.k}</b>
              <span>{r.v}</span>
            </li>
          ))
        }
      </ul>
      <p class="end serif">{a.end}</p>
    </div>

    <figure class="shot">
      <img src={a.img.src} alt={a.img.alt} width="750" height="1416" loading="lazy" decoding="async" />
      <figcaption>
        <b>{a.caseK}</b>
        {a.caseV}
        <span>{a.img.cap}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 4vw, 72px);
    align-items: center;
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2.2vh, 24px);
    min-width: 0;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .steps li + li {
    position: relative;
  }

  .steps li + li::before {
    content: '→';
    position: absolute;
    left: -5px;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--ink-3);
    font-size: 13px;
  }

  .steps button {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 12px 14px;
    font: inherit;
    text-align: left;
    color: var(--ink-2);
    background: var(--card);
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: border-color 0.25s, background 0.25s, color 0.25s, transform 0.35s var(--ease);
  }

  .steps i {
    font-style: normal;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .steps b {
    font-size: clamp(16px, 1.45vw, 26px);
    white-space: nowrap;
  }

  .steps em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(10px, 0.8vw, 13px);
    color: var(--accent-ink);
  }

  .steps button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-3px);
  }

  .steps li:last-child button {
    border-color: var(--ok);
  }

  .steps li:last-child button[aria-selected='true'] {
    background: var(--ok-soft);
  }

  .detail {
    min-height: 3.2em;
  }

  .detail p {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 26px);
    line-height: 1.5;
  }

  .detail p[hidden] {
    display: none;
  }

  .map {
    padding: 12px 16px;
    border-radius: var(--r-sm);
    background: var(--bg-2);
  }

  .map p {
    margin: 0;
  }

  .mk {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-bottom: 4px !important;
  }

  .mr {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
    font-size: clamp(15px, 1.25vw, 21px);
  }

  .mr s {
    color: var(--ink-3);
  }

  .mr span {
    color: var(--accent);
  }

  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .rules li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 10px;
    border-top: 3px solid var(--accent);
  }

  .rules b {
    font-size: clamp(20px, 1.8vw, 32px);
    font-weight: 600;
  }

  .rules span {
    font-size: clamp(13px, 1.05vw, 18px);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .end {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 26px);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    max-width: 30vw;
  }

  .shot img {
    display: block;
    height: min(60vh, 640px);
    width: auto;
    filter: drop-shadow(var(--shadow-drop));
  }

  figcaption {
    max-width: 22em;
    font-size: clamp(13px, 1vw, 16px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  figcaption b {
    display: block;
    color: var(--ink);
  }

  figcaption span {
    display: block;
    color: var(--ink-3);
    font-size: 0.9em;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .steps,
    .rules {
      grid-template-columns: 1fr 1fr;
    }
    .steps li + li::before {
      display: none;
    }
    .shot {
      max-width: none;
    }
    .shot img {
      height: auto;
      width: min(70vw, 300px);
    }
  }
</style>
