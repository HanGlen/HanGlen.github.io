---
/**
 * 演讲 03「AI 前后，写软件变了多少」：模型能力 → 成本 → 软件更新速度 → 一家公司 → 我自己 → 案例。
 * 每一步前后用同一个指标；按 level.kind 画横条（bars）、以前 | 现在两张卡（vs）、每月柱状图（mine）或做法清单（how）。
 * 版式同 04、05（.t-steps）：← → 一步步亮，左边一张图，右边一个问题 + 一句大白话，例子在底部色块。
 * 每张图都能悬停、聚焦读数（Talk.astro 的 [data-reads]）。口径不同的数各自成行，不放进同一个比较。
 * 依据 docs/research/talk-03-team.md（HAN-1864）；我自己的每月 PR 来自 src/data/dnd.json。
 */
import data from '../../data/dnd.json';
import { talk } from '../../i18n/talk';
import { rich } from '../../lib/rich';

const t = talk.team;
const L = t.levels;
const months = Object.entries(data.monthlyPRs as Record<string, number>);
const mmax = Math.max(...months.map(([, v]) => v));
const mlabel = (m: string) => `${Number(m.slice(5))} 月`;
const smax = Math.max(...t.swe.pts.map((p) => p.v));
---

<section class="slide t-slide team" data-slide data-notes={t.notes} aria-labelledby="team-title">
  <header class="t-head">
    <p class="no">{t.no}</p>
    <h2 id="team-title">{t.title}</h2>
    <p class="lead">{t.lead}</p>
  </header>

  <div class="body t-body t-steps" data-stepper style={`--n: ${L.length}`}>
    <ol class="line" role="tablist" aria-label={t.title}>
      {
        L.map((l, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true">{i + 1}</i>
              <span>{l.k}</span>
              <em>{l.tag}</em>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="main">
      <div class="stage">
        {
          L.map((l, i) => (
            <div class="frame" data-pane={String(i)} hidden={i !== 0} data-reads>
              {l.kind === 'vs' && (
                <div class="vs">
                  {'x' in l && l.x && <p class="times serif fin" style="--d:1">{l.x}</p>}
                  <ul class="vbars">
                    {(l.vs ?? []).map((v, j, all) => (
                      <li class={`fin${j ? ' now' : ''}`} style={`--d:${j + 2}`} tabindex="0" data-read={`${j ? t.nowK : t.beforeK}（${v.at}）：${v.big}，${v.k}`}>
                        <span class="vh">
                          <b>{j ? t.nowK : t.beforeK}</b>
                          <em>{v.at}</em>
                        </span>
                        <span class="track">
                          <i style={`--w:${Math.max(0.5, (v.n / Math.max(...all.map((x) => x.n))) * 100)}%; --d:${j + 2}`} />
                        </span>
                        <span class="vv">
                          <b class="serif">{v.big}</b>
                          <small>{v.k}</small>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {l.kind === 'bars' && (
                <div class="fin" style="--d:1">
                  <p class="unit">{t.swe.k}</p>
                  <ul class="hbars">
                    {t.swe.pts.map((p, j) => (
                      <li tabindex="0" data-read={`${p.at} ${p.who}：${p.label}`}>
                        <span class="hk">{p.at}<small>{p.who}</small></span>
                        <span class="track">
                          <i class={j === t.swe.pts.length - 1 ? 'hot' : ''} style={`--w:${Math.max(0.6, (p.v / smax) * 100)}%`} />
                        </span>
                        <b class="serif">{p.label}</b>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {l.kind === 'mine' && (
                <>
                  <p class="unit fin">{t.mine.unit}</p>
                  <ol class="cols">
                    {months.map(([m, v], j) => (
                      <li class="fin" tabindex="0" style={`--d:${j + 1}`} data-read={`${mlabel(m)}：合入 ${v} 个 PR`}>
                        <span class="col" style={`--h:${(v / mmax) * 86}%`}>
                          <b class="serif">{v}</b>
                          <i class={`${v === mmax ? 'hot' : ''}${j === 0 || j === months.length - 1 ? ' part' : ''}`} />
                        </span>
                        <em>{mlabel(m)}</em>
                      </li>
                    ))}
                  </ol>
                  <p class="cost fin" style="--d:8">
                    <span>{t.mine.costK}</span>
                    {t.mine.cost.map((c, j) => <>{j > 0 && <i aria-hidden="true">→</i>}<b>{c.k} {c.v}</b></>)}
                  </p>
                </>
              )}
              {l.kind === 'how' && (
                <ol class="how">
                  {t.how.map((h, j) => (
                    <li class="fin" tabindex="0" style={`--d:${j + 1}`} data-read={`${h.k}：${h.v}`}>
                      <i aria-hidden="true">{j + 1}</i>
                      <b class="serif">{h.k}</b>
                      <span>{h.v}</span>
                    </li>
                  ))}
                </ol>
              )}
              <p class="t-read" aria-live="polite" data-read-out data-hint={l.kind === 'mine' ? t.mine.partial : t.readK}>{l.kind === 'mine' ? t.mine.partial : t.readK}</p>
            </div>
          ))
        }
      </div>

      <aside class="side" aria-live="polite">
        {
          L.map((l, i) => (
            <div class="sp" data-pane={String(i)} hidden={i !== 0}>
              <h3 class="serif">{l.q}</h3>
              <p class="plain">{l.plain}</p>
            </div>
          ))
        }
        <p class="t-hint">{t.hint}</p>
      </aside>
    </div>

    {
      L.map((l, i) => (
        <div class="ex" data-pane={String(i)} hidden={i !== 0}>
          <b>{t.caseK}</b>
          <p>{l.case}</p>
          <details class="src">
            <summary>{t.srcK}</summary>
            <p set:html={rich(l.src)} />
          </details>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stage {
    min-width: 0;
  }

  /* 2–4：一个大倍数，下面两根按真实比例画的横条（以前 | 现在），差距一眼看得出 */
  .vs {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vh, 48px);
  }

  .vs .times {
    margin: 0;
    font-size: clamp(64px, 8vw, 156px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .vbars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.6vh, 28px);
  }

  .vbars li {
    display: grid;
    grid-template-columns: clamp(110px, 9vw, 170px) minmax(0, 1fr) clamp(150px, 13vw, 240px);
    align-items: center;
    gap: clamp(12px, 1.2vw, 20px);
    padding: 6px 8px;
    border-radius: var(--r-sm);
    outline: none;
    transition: background 0.2s;
  }

  .vbars li[data-on],
  .vbars li:focus-visible {
    background: var(--bg-2);
  }

  .vh,
  .vv {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .vh b {
    font-size: clamp(16px, 1.3vw, 23px);
    font-weight: 600;
    color: var(--ink-2);
  }

  .vh em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.95vw, 16px);
    color: var(--ink-3);
  }

  .vv b {
    font-size: clamp(26px, 2.6vw, 48px);
    font-weight: 600;
    line-height: 1.05;
    white-space: nowrap;
    color: var(--ink-2);
  }

  .vv small {
    font-size: clamp(13px, 1vw, 17px);
    color: var(--ink-3);
  }

  .vbars .track {
    height: clamp(30px, 5vh, 56px);
  }

  .vbars .track i {
    background: var(--ink-3);
  }

  .vbars .now .track i {
    background: var(--accent);
  }

  .vbars .now .vh b,
  .vbars .now .vv b {
    color: var(--accent-ink);
  }

  /* 5：每月订阅花费一行 */
  .cost {
    margin: clamp(8px, 1.4vh, 16px) 0 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    font-size: clamp(14px, 1.1vw, 19px);
    color: var(--ink-2);
  }

  .cost span {
    color: var(--ink-3);
  }

  .cost i {
    font-style: normal;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .vbars li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  /* 案例：四件事，编号 + 一句 */
  .how {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 20px);
  }

  .how li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 6px 12px;
    padding: clamp(14px, 1.6vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    transition: border-color 0.2s, transform 0.2s var(--ease);
  }

  .how li[data-on],
  .how li:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .how i {
    grid-row: span 2;
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(14px, 1.1vw, 18px);
    color: var(--accent-ink);
  }

  .how b {
    font-size: clamp(22px, 2vw, 36px);
    font-weight: 600;
    line-height: 1.2;
  }

  .how span {
    font-size: clamp(16px, 1.3vw, 23px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .unit {
    margin: 0;
    font-size: clamp(13px, 1vw, 17px);
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  /* 横条：名字 | 条 | 数 */
  .hbars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2vh, 22px);
  }

  .hbars li {
    display: grid;
    grid-template-columns: clamp(110px, 9vw, 170px) minmax(0, 1fr) clamp(120px, 11vw, 200px);
    align-items: center;
    gap: 16px;
    padding: 6px 8px;
    border-radius: var(--r-sm);
    transition: background 0.2s;
  }

  .hbars li[data-on],
  .hbars li:focus-visible {
    background: var(--bg-2);
  }

  .hk {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: clamp(15px, 1.25vw, 22px);
    color: var(--ink-2);
  }

  .hk small {
    font-size: clamp(12px, 0.85vw, 15px);
    color: var(--ink-3);
  }

  .hbars b {
    font-size: clamp(20px, 1.9vw, 34px);
    font-weight: 600;
    white-space: nowrap;
  }

  .track {
    height: clamp(22px, 3.4vh, 40px);
    border-radius: var(--r-sm);
    background: var(--heat-0);
    overflow: hidden;
  }

  .track i {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: var(--r-sm);
    background: var(--cat-blue);
    transform-origin: left;
    animation: grow 0.9s var(--ease) both;
    animation-delay: calc(0.3s + var(--d, 0) * 0.12s);
  }

  .track i.hot {
    background: var(--accent);
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }

  /* 我自己：每月柱子 */
  .cols {
    list-style: none;
    margin: 0;
    padding: 0;
    height: clamp(220px, 38vh, 420px);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 26px);
    align-items: end;
  }

  .cols li {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 4px;
    border-radius: var(--r-sm);
    transition: background 0.2s;
  }

  .cols li[data-on] {
    background: var(--bg-2);
  }

  .cols b {
    font-size: clamp(16px, 1.4vw, 26px);
    font-weight: 600;
  }

  /* 柱子和数字都按 --h 从底部量，避免百分比高度在弹性盒里算错 */
  .col {
    flex: 1;
    width: 100%;
    position: relative;
  }

  .col b {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--h) + 6px);
    text-align: center;
  }

  .col i {
    position: absolute;
    left: 0;
    bottom: 0;
    display: block;
    width: 100%;
    height: var(--h);
    border-radius: var(--r-sm) var(--r-sm) 2px 2px;
    background: var(--heat-3);
    transform-origin: bottom;
    animation: rise 0.9s var(--ease) both;
    animation-delay: calc(0.3s + var(--d, 0) * 0.08s);
  }

  .col i.hot {
    background: var(--accent);
  }

  .col i.part {
    background: repeating-linear-gradient(-45deg, var(--heat-2) 0 6px, var(--heat-1) 6px 12px);
  }

  .cols em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.95vw, 16px);
    color: var(--ink-3);
  }

  @keyframes rise {
    from {
      transform: scaleY(0);
    }
  }

  @media (max-width: 900px) {
    .hbars li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .how {
      grid-template-columns: 1fr;
    }
    .cols {
      height: 220px;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track i,
    .col i {
      animation: none;
    }
  }
</style>
