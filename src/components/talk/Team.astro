---
/**
 * 演讲 03「AI 前后，写软件变了多少」：一个人 → 一个团队 → 一个产品 → 工具 → 我自己 → 怎么做到的。
 * 前四步左「以前」右「现在」；口径不同的不相除（docs/research/talk-03-before-after.md，HAN-1891）。
 * 版式同 04、05（.t-steps）：← → 一步步亮，左边一张图，右边一个问题 + 一句大白话，例子在底部色块。
 * 每张图都能悬停、聚焦读数（Talk.astro 的 [data-reads]）。口径不同的数各自成行，不放进同一个比较。
 * 依据 docs/research/talk-03-team.md（HAN-1864）；我自己的每月 PR 来自 src/data/dnd.json。
 */
import data from '../../data/dnd.json';
import { talk } from '../../i18n/talk';
import { rich } from '../../lib/rich';

const t = talk.team;
const L = t.levels;
const months = Object.entries(data.monthlyPRs as Record<string, number>);
const mmax = Math.max(...months.map(([, v]) => v));
const mlabel = (m: string) => `${Number(m.slice(5))} 月`;
---

<section class="slide t-slide team" data-slide data-notes={t.notes} aria-labelledby="team-title">
  <header class="t-head">
    <p class="no">{t.no}</p>
    <h2 id="team-title">{t.title}</h2>
    <p class="lead">{t.lead}</p>
  </header>

  <div class="body t-body t-steps" data-stepper style={`--n: ${L.length}`}>
    <ol class="line" role="tablist" aria-label={t.title}>
      {
        L.map((l, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true">{i + 1}</i>
              <span>{l.k}</span>
              <em>{l.tag}</em>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="main">
      <div class="stage">
        <!-- 1–4 以前 | 现在 -->
        {
          L.slice(0, 4).map((l, i) => (
            <div class="frame" data-pane={String(i)} hidden={i !== 0} data-reads>
              <div class="vs">
                {(l.vs ?? []).map((v, j) => (
                  <div class={`side-${j ? 'now' : 'before'} fin`} style={`--d:${j * 2 + 1}`} tabindex="0" data-read={`${j ? t.nowK : t.beforeK}（${v.at}）：${v.big}，${v.k}`}>
                    <p class="vk">{j ? t.nowK : t.beforeK}</p>
                    <em>{v.at}</em>
                    <b class="serif">{v.big}</b>
                    <span>{v.k}</span>
                  </div>
                ))}
                <span class="vsarr fin" style="--d:2" aria-hidden="true">→</span>
              </div>
              <p class="t-read" aria-live="polite" data-read-out data-hint={t.readK}>{t.readK}</p>
            </div>
          ))
        }

        <!-- 5 我自己：每月合入的 PR -->
        <div class="frame" data-pane="4" hidden data-reads>
          <p class="unit fin">{t.mine.unit}</p>
          <ol class="cols">
            {
              months.map(([m, v], i) => (
                <li class="fin" style={`--d:${i + 1}`} data-read={`${mlabel(m)}：合入 ${v} 个 PR${i === months.length - 1 ? `（${t.mine.partial}）` : ''}`}>
                  <span class="col">
                    <b class="serif">{v}</b>
                    <i class={`${v === mmax ? 'hot' : ''}${i === months.length - 1 ? ' part' : ''}`} style={`--h:${(v / mmax) * 88}%`} />
                  </span>
                  <em>{mlabel(m)}</em>
                </li>
              ))
            }
          </ol>
          <p class="cost fin" style="--d:8">
            <span>{t.mine.costK}</span>
            {t.mine.cost.map((c, i) => <>{i > 0 && <i aria-hidden="true">→</i>}<b>{c.k} {c.v}</b></>)}
          </p>
          <p class="t-read" aria-live="polite" data-read-out data-hint={t.mine.partial}>{t.mine.partial}</p>
        </div>

        <!-- 6 怎么做到的：左边模型得分，右边 Agentic Engineering -->
        <div class="frame" data-pane="5" hidden data-reads>
          <div class="why">
            <div class="fin" style="--d:1">
              <p class="unit">{t.swe.k}</p>
              <ul class="hbars">
                {
                  t.swe.pts.map((p, i) => (
                    <li data-read={`${p.at} ${p.who}：${p.v}%`}>
                      <span class="hk">{p.at}</span>
                      <span class="track">
                        <i class={i === t.swe.pts.length - 1 ? 'hot' : ''} style={`--w:${p.v}%`} />
                      </span>
                      <b class="serif">{p.v.toFixed(1)}%</b>
                    </li>
                  ))
                }
              </ul>
            </div>
            <span class="plus fin" style="--d:3" aria-hidden="true">+</span>
            <div class="ae fin" style="--d:4">
              <b class="serif">{t.swe.ae}</b>
              <span>{t.swe.aeV}</span>
              <em>{t.swe.next}</em>
            </div>
          </div>
          <p class="t-read" aria-live="polite" data-read-out data-hint={t.readK}>{t.readK}</p>
        </div>
      </div>

      <aside class="side" aria-live="polite">
        {
          L.map((l, i) => (
            <div class="sp" data-pane={String(i)} hidden={i !== 0}>
              <h3 class="serif">{l.q}</h3>
              <p class="plain">{l.plain}</p>
            </div>
          ))
        }
        <p class="t-hint">{t.hint}</p>
      </aside>
    </div>

    {
      L.map((l, i) => (
        <div class="ex" data-pane={String(i)} hidden={i !== 0}>
          <b>{t.caseK}</b>
          <p>{l.case}</p>
          <details class="src">
            <summary>{t.srcK}</summary>
            <p set:html={rich(l.src)} />
          </details>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stage {
    min-width: 0;
  }

  /* 1–4：以前 | 现在，两张卡，中间一个箭头 */
  .vs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(12px, 1.6vw, 28px);
  }

  .vs .side-before {
    grid-column: 1;
    grid-row: 1;
  }

  .vs .vsarr {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    font-size: clamp(22px, 2vw, 36px);
    color: var(--ink-3);
  }

  .vs .side-now {
    grid-column: 3;
    grid-row: 1;
  }

  .vs > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(16px, 1.8vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    outline: none;
    transition: box-shadow 0.25s, transform 0.25s var(--ease);
  }

  .vs > div[data-on],
  .vs > div:focus-visible {
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .vs .side-now {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .vk {
    margin: 0;
    font-size: clamp(12px, 0.9vw, 15px);
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .side-now .vk {
    color: var(--accent-ink);
  }

  .vs em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.9vw, 15px);
    color: var(--ink-3);
  }

  .vs b {
    font-size: clamp(34px, 3.6vw, 68px);
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink-2);
  }

  .side-now b {
    color: var(--accent);
  }

  .vs span {
    font-size: clamp(14px, 1.15vw, 20px);
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* 5：每月订阅花费一行 */
  .cost {
    margin: clamp(8px, 1.4vh, 16px) 0 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    font-size: clamp(14px, 1.1vw, 19px);
    color: var(--ink-2);
  }

  .cost span {
    color: var(--ink-3);
  }

  .cost i {
    font-style: normal;
    color: var(--ink-3);
  }

  /* 6：模型得分 + Agentic Engineering */
  .why {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(12px, 1.6vw, 28px);
  }

  .why .hbars li {
    grid-template-columns: clamp(70px, 5vw, 96px) minmax(0, 1fr) clamp(70px, 5.5vw, 110px);
    gap: 10px;
  }

  .plus {
    font-size: clamp(28px, 2.6vw, 48px);
    color: var(--ink-3);
  }

  .ae {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(16px, 1.8vw, 32px);
    border: 2px solid var(--accent);
    border-radius: var(--r);
    background: var(--accent-soft);
  }

  .ae b {
    font-size: clamp(22px, 2vw, 38px);
    font-weight: 600;
  }

  .ae span {
    font-size: clamp(14px, 1.15vw, 20px);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .ae em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.9vw, 15px);
    color: var(--accent-ink);
  }

  @media (max-width: 900px) {
    .vs,
    .why {
      grid-template-columns: 1fr;
    }
    .vs .side-before,
    .vs .vsarr,
    .vs .side-now {
      grid-column: 1;
      grid-row: auto;
    }
    .vs .vsarr,
    .plus {
      transform: rotate(90deg);
      justify-self: start;
    }
  }


  .unit {
    margin: 0;
    font-size: clamp(13px, 1vw, 17px);
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  /* 横条：名字 | 条 | 数 */
  .hbars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2vh, 22px);
  }

  .hbars li {
    display: grid;
    grid-template-columns: clamp(110px, 9vw, 170px) minmax(0, 1fr) clamp(120px, 11vw, 200px);
    align-items: center;
    gap: 16px;
    padding: 6px 8px;
    border-radius: var(--r-sm);
    transition: background 0.2s;
  }

  .hbars li[data-on] {
    background: var(--bg-2);
  }

  .hk {
    font-size: clamp(15px, 1.25vw, 22px);
    color: var(--ink-2);
  }

  .hbars b {
    font-size: clamp(20px, 1.9vw, 34px);
    font-weight: 600;
    white-space: nowrap;
  }

  .track {
    height: clamp(22px, 3.4vh, 40px);
    border-radius: var(--r-sm);
    background: var(--heat-0);
    overflow: hidden;
  }

  .track i {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: var(--r-sm);
    background: var(--cat-blue);
    transform-origin: left;
    animation: grow 0.9s var(--ease) both;
    animation-delay: calc(0.3s + var(--d, 0) * 0.12s);
  }

  .track i.hot {
    background: var(--accent);
  }

  .days .track {
    height: clamp(16px, 2.4vh, 28px);
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }

  .times {
    margin: 0;
    align-self: flex-end;
    font-size: clamp(56px, 7vw, 132px);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }

  /* 时间线：三个点 */
  .tl {
    list-style: none;
    margin: 0;
    padding: clamp(18px, 3vh, 36px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 28px);
    position: relative;
  }

  .tl::before {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    top: calc(clamp(18px, 3vh, 36px) + 8px);
    height: 2px;
    background: var(--line-2);
  }

  .tl li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 30px 12px 12px;
    border-radius: var(--r-sm);
    transition: background 0.2s;
  }

  .tl li[data-on] {
    background: var(--bg-2);
  }

  .tl li::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .tl li.mid::before {
    background: var(--accent);
  }

  .tl em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.95vw, 16px);
    color: var(--accent-ink);
  }

  .tl b {
    font-size: clamp(24px, 2.4vw, 44px);
    font-weight: 600;
    line-height: 1.15;
  }

  .tl span {
    font-size: clamp(14px, 1.15vw, 20px);
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* 一个人：三张卡 */
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 24px);
  }

  .people li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(14px, 1.4vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    transition: transform 0.3s var(--ease), border-color 0.3s;
  }

  .people li[data-on] {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .people p {
    margin: 0;
  }

  .pw {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pw b {
    font-size: clamp(15px, 1.2vw, 21px);
  }

  .pw span {
    font-size: clamp(12px, 0.9vw, 15px);
    color: var(--ink-3);
  }

  .pb {
    margin-top: 8px !important;
    font-size: clamp(32px, 3.2vw, 60px);
    font-weight: 600;
    line-height: 1.05;
    color: var(--accent);
  }

  .pk {
    font-size: clamp(14px, 1.1vw, 19px);
    color: var(--ink);
  }

  .ph {
    margin-top: auto !important;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: clamp(12px, 0.9vw, 15px);
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* 我自己：每月柱子 */
  .cols {
    list-style: none;
    margin: 0;
    padding: 0;
    height: clamp(220px, 38vh, 420px);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 26px);
    align-items: end;
  }

  .cols li {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 4px;
    border-radius: var(--r-sm);
    transition: background 0.2s;
  }

  .cols li[data-on] {
    background: var(--bg-2);
  }

  .cols b {
    font-size: clamp(16px, 1.4vw, 26px);
    font-weight: 600;
  }

  .col {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .col i {
    display: block;
    width: 100%;
    height: var(--h);
    border-radius: var(--r-sm) var(--r-sm) 2px 2px;
    background: var(--heat-3);
    transform-origin: bottom;
    animation: rise 0.9s var(--ease) both;
    animation-delay: calc(0.3s + var(--d, 0) * 0.08s);
  }

  .col i.hot {
    background: var(--accent);
  }

  .col i.part {
    background: repeating-linear-gradient(-45deg, var(--heat-2) 0 6px, var(--heat-1) 6px 12px);
  }

  .cols em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(12px, 0.95vw, 16px);
    color: var(--ink-3);
  }

  @keyframes rise {
    from {
      transform: scaleY(0);
    }
  }

  @media (max-width: 900px) {
    .hbars li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .tl,
    .people {
      grid-template-columns: 1fr;
    }
    .tl::before {
      display: none;
    }
    .cols {
      height: 220px;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track i,
    .col i {
      animation: none;
    }
  }
</style>
