---
/**
 * 演讲 08 交流与合作：左边一句邀请，右边微信二维码和「谢谢」。不分类（车主 2026-11-19 定）。
 * 「谢谢」是主角，邀请一句在下面；二维码保持白底（深色模式也能扫），去色成近黑，和全场配色一致。
 */
import { talk } from '../../i18n/talk';

const c = talk.contact;
---

<section class="slide t-slide contact" data-slide data-notes={c.notes} aria-labelledby="contact-title">
  <header class="t-head">
    <p class="no">{c.no}</p>
    <h2 id="contact-title">{c.title}</h2>
  </header>

  <div class="body t-body">
    <div class="words">
      <b class="end serif">{c.end}</b>
      <p class="say">{c.say}</p>
    </div>

    <aside class="qr">
      <img src={c.qr.src} alt={c.qr.alt} width="776" height="771" loading="lazy" />
      <p>{c.askV}</p>
      <small>{c.site}</small>
    </aside>

  </div>
</section>

<style>
  .body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(220px, 1fr);
    gap: clamp(16px, 3vh, 40px) clamp(24px, 5vw, 96px);
    align-items: center;
  }

  .words {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vh, 48px);
  }

  .say {
    margin: 0;
    max-width: 22em;
    font-size: clamp(20px, 1.9vw, 34px);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .qr img {
    width: min(100%, clamp(180px, 40vh, 360px));
    height: auto;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    filter: grayscale(1) contrast(1.2);
    transition: transform 0.25s var(--ease);
  }

  .qr img:hover {
    transform: translateY(-3px);
  }

  .qr p {
    margin: 8px 0 0;
    font-size: clamp(16px, 1.35vw, 24px);
    color: var(--ink);
  }

  .qr small {
    font-family: var(--mono);
    font-size: clamp(13px, 1vw, 17px);
    color: var(--ink-3);
  }

  .end {
    font-size: clamp(72px, 9vw, 176px);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qr img {
      transition: none;
    }
  }
</style>
