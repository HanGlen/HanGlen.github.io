---
/**
 * 演讲 06「这套系统只能写代码吗？」：版式同 04、05（.t-steps）：顶上步骤条，左图右文，例子在底部色块。
 * 三步是三类任务（写代码 / AI 赋能 / 科研调研）；左边的图每步都是同一条「拆开 → 动手 → 检查 → 交付」，
 * 四格的步名不变，只换里面的真事，让台下看到「骨架是同一个」。
 */
import { talk } from '../../i18n/talk';

const a = talk.any;
const L = a.levels;
---

<section class="slide t-slide any" data-slide data-notes={a.notes} aria-labelledby="any-title">
  <header class="t-head">
    <p class="no">{a.no}</p>
    <h2 id="any-title">{a.title}</h2>
    <p class="lead">{a.lead}</p>
  </header>

  <div class="body t-body t-steps" data-stepper style={`--n: ${L.length}`}>
    <ol class="line" role="tablist" aria-label={a.title}>
      {
        L.map((l, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true">{i + 1}</i>
              <span>{l.k}</span>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="main">
      <div class="stage">
        {
          L.map((l, i) => (
            <div class="frame" data-pane={String(i)} hidden={i !== 0}>
              <p class="in fin" style="--d:0">
                <b>{a.inK}</b>
                <span>{l.input}</span>
              </p>
              <ol class="chain">
                {l.cells.map((c, j) => (
                  <li class={`fin${j === l.cells.length - 1 ? ' done' : ''}`} style={`--d:${1 + j * 1.4}`}>
                    <p class="ck">
                      <i>{String(j + 1).padStart(2, '0')}</i>
                      {a.cols[j]}
                    </p>
                    <p class="cv">{c}</p>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>

      <aside class="side">
        {
          L.map((l, i) => (
            <div class="sp" data-pane={String(i)} hidden={i !== 0}>
              <h3 class="serif">{l.q}</h3>
              <p class="plain">{l.plain}</p>
            </div>
          ))
        }
        <p class="t-hint">{a.hint}</p>
      </aside>
    </div>

    {
      L.map((l, i) => (
        <div class="ex" data-pane={String(i)} hidden={i !== 0}>
          <b>{a.caseK}</b>
          <p>{l.case}</p>
          <details class="src">
            <summary>{a.srcK}</summary>
            <p>{l.src}</p>
          </details>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stage {
    min-width: 0;
  }

  /* 起点：一句话需求，像便签贴在链条上方 */
  .in {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    padding: 0.55em 1.1em;
    border: 1.5px dashed var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
    font-size: clamp(16px, 1.4vw, 26px);
  }

  .in b {
    font-family: var(--mono);
    font-size: clamp(12px, 0.9vw, 15px);
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }

  /* 四格：步名固定，内容换成这件事；格与格之间画箭头 */
  .chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(22px, 2.4vw, 44px);
  }

  .chain li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.6vh, 18px);
    min-height: clamp(130px, 20vh, 220px);
    padding: clamp(16px, 1.6vw, 28px);
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--line-2);
    border-radius: var(--r);
    box-shadow: var(--shadow);
  }

  .chain li + li::before {
    content: '→';
    position: absolute;
    left: calc(-1 * clamp(22px, 2.4vw, 44px));
    width: clamp(22px, 2.4vw, 44px);
    top: 50%;
    transform: translateY(-50%);
    text-align: center;
    font-size: clamp(16px, 1.4vw, 26px);
    color: var(--ink-3);
  }

  .chain li.done {
    border-top-color: var(--accent);
    background: var(--accent-soft);
  }

  .ck {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(20px, 1.9vw, 34px);
    font-weight: 600;
    color: var(--ink);
  }

  .ck i {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(11px, 0.8vw, 14px);
    color: var(--accent-ink);
  }

  .cv {
    margin: 0;
    font-size: clamp(16px, 1.3vw, 23px);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .done .cv {
    color: var(--accent-ink);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .chain {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .chain li {
      min-height: 0;
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      padding: 12px 14px;
    }
    .chain li + li::before {
      display: none;
    }
    .ck {
      flex: none;
      width: 4.2em;
      font-size: 17px;
    }
    .cv {
      font-size: 15px;
    }
  }
</style>
