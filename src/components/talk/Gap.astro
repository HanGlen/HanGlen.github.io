---
/**
 * 演讲 02「AI 用得多，做成的少」：AI 调用（折线）→ 企业在用（折线）→ 做成的（两年对比横条）。
 * 每张一个大数，下面一行来源，点开看可信度和原文。← → 一张张讲（没讲到的先淡着，讲完出结论）；悬停或聚焦看读数。
 * 依据 docs/research/talk-02-data-v2.md（HAN-1890）。陶土红 = AI 用量，蓝 = 企业。
 */
import { talk } from '../../i18n/talk';

const g = talk.gap;
const d = g.done;
const W = 300;
const H = 150;
const PAD = { l: 8, r: 8, t: 14, b: 8 };
/** 横轴统一 2023 年初到 2026 年中，四张图对得上时间 */
const X0 = 2023.3;
const X1 = 2026.6;
const px = (x: number) => PAD.l + ((x - X0) / (X1 - X0)) * (W - PAD.l - PAD.r);
const py = (v: number, max: number) => H - PAD.b - (v / max) * (H - PAD.t - PAD.b);
const years = [2024, 2025, 2026];
---

<section class="slide t-slide gap" data-slide data-notes={g.notes} aria-labelledby="gap-title">
  <header class="t-head">
    <p class="no">{g.no}</p>
    <h2 id="gap-title">{g.title}</h2>
    <p class="lead">{g.lead}</p>
  </header>

  <div class="body t-body" data-stepper data-gap>
    <div class="lines">
      {
        g.lines.map((l, li) => (
          <section class={`card k-${l.kind}`} data-card={li} data-reads>
            <button type="button" class="ch" data-step role="tab" aria-selected={li === 0 ? 'true' : 'false'}>
              <h3 class="serif">{l.k}</h3>
              <b class="big serif">{l.big}</b>
              <span class="bk">{l.bigK}</span>
            </button>
            <svg viewBox={`0 0 ${W} ${H}`} class="chart" role="img" aria-label={`${l.k}：${l.pts.map((p) => `${p.t} ${p.label}`).join('，')}`}>
              <line x1={PAD.l} x2={W - PAD.r} y1={H - PAD.b} y2={H - PAD.b} class="axis" />
              {years.map((y) => (
                <g>
                  <line x1={px(y)} x2={px(y)} y1={PAD.t} y2={H - PAD.b} class="grid" />
                  <text x={px(y) + 3} y={PAD.t - 3} class="yr">
                    {y}
                  </text>
                </g>
              ))}
              <polyline class="ln" points={l.pts.map((p) => `${px(p.x)},${py(p.v, l.max)}`).join(' ')} pathLength="1" />
              {l.pts.map((p) => (
                <circle
                  cx={px(p.x)}
                  cy={py(p.v, l.max)}
                  r="5"
                  class={'soft' in p && p.soft ? 'pt soft' : 'pt'}
                  data-read={`${p.t}：${p.label}，${p.k}`}
                />
              ))}
            </svg>
            <p class="t-read" aria-live="polite" data-read-out data-hint={l.say}>
              {l.say}
            </p>
            <details class="src">
              <summary>
                <b>{g.srcK}</b>
                {l.src}
              </summary>
              <div class="pop">
                <p>
                  <b>{g.trustK}</b>
                  {l.trust}
                </p>
                {l.href && (
                  <a href={l.href} target="_blank" rel="noopener">
                    {g.openK} ↗
                  </a>
                )}
              </div>
            </details>
          </section>
        ))
      }
      <section class={`card k-${d.kind}`} data-card={g.lines.length} data-reads>
        <button type="button" class="ch" data-step role="tab" aria-selected="false">
          <h3 class="serif">{d.k}</h3>
          <b class="big serif">{d.big}</b>
          <span class="bk">{d.bigK}</span>
        </button>
        <div class="bars" role="img" aria-label={d.rows.map((r) => `${r.k}：${d.years[0]} 年 ${r.a}%，${d.years[1]} 年 ${r.b}%`).join('；')}>
          <p class="yrs">
            <span><i class="y0" />{d.years[0]}</span>
            <span><i class="y1" />{d.years[1]}</span>
          </p>
          {
            d.rows.map((r) => (
              <div class="row" tabindex="0" data-read={`${r.k}：${d.years[0]} 年 ${r.a}%，${d.years[1]} 年 ${r.b}%`}>
                <span class="rk">{r.k}</span>
                <span class="tr">
                  <i class="y0" style={`--w:${r.a}%`} />
                  <i class="y1" style={`--w:${r.b}%`} />
                </span>
                <b>{r.b}%</b>
              </div>
            ))
          }
        </div>
        <p class="t-read" aria-live="polite" data-read-out data-hint={d.say}>
          {d.say}
        </p>
        <details class="src">
          <summary>
            <b>{g.srcK}</b>
            {d.src}
          </summary>
          <div class="pop">
            <p>
              <b>{g.trustK}</b>
              {d.trust}
            </p>
            <a href={d.href} target="_blank" rel="noopener">
              {g.openK} ↗
            </a>
          </div>
        </details>
      </section>
    </div>
    <p class="end serif">{g.end}</p>
    <p class="t-hint">{g.hint}</p>
  </div>
</section>

<style>
  .k-ai {
    --c: var(--accent);
    --c-soft: var(--accent-soft);
  }

  .k-dig {
    --c: var(--cat-blue);
    --c-soft: var(--blue-soft);
  }

  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(12px, 2.4vh, 28px);
  }

  .lines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 32px);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.4vh, 14px);
    padding: clamp(14px, 1.3vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    transition: opacity 0.5s var(--ease), transform 0.45s var(--ease), border-color 0.3s;
  }

  /* 渐进披露：还没讲到的先淡着，正在讲的那条抬起来 */
  [data-at] .card:not(.seen) {
    opacity: 0.3;
  }

  .card.on {
    border-color: var(--c);
    transform: translateY(-4px);
  }

  .ch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 0;
    font: inherit;
    text-align: left;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .ch h3 {
    margin: 0;
    font-size: clamp(18px, 1.5vw, 28px);
    font-weight: 600;
    color: var(--ink-2);
  }

  .big {
    font-size: clamp(30px, 3vw, 58px);
    font-weight: 600;
    line-height: 1.05;
    color: var(--c);
    white-space: nowrap;
  }

  .bk {
    font-size: clamp(13px, 1vw, 17px);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .chart {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .axis {
    stroke: var(--line-2);
    stroke-width: 1.5;
  }

  .grid {
    stroke: var(--line);
    stroke-dasharray: 2 4;
  }

  .yr {
    font-family: var(--mono);
    font-size: 10px;
    fill: var(--ink-3);
  }

  .ln {
    fill: none;
    stroke: var(--c);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .card.seen .ln {
    animation: draw 1.1s var(--ease) both;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  .pt {
    fill: var(--card);
    stroke: var(--c);
    stroke-width: 2.5;
    transition: r 0.2s;
    outline: none;
  }

  .pt.soft {
    stroke-dasharray: 2 2;
  }

  .pt[data-on],
  .pt:focus-visible {
    fill: var(--c);
    r: 8;
  }

  .card .t-read {
    min-height: 2.9em;
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .card .t-read.on {
    color: var(--ink);
    font-weight: 600;
  }

  .src {
    position: relative;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    font-size: clamp(11px, 0.8vw, 14px);
    line-height: 1.45;
    color: var(--ink-3);
  }

  .src summary {
    cursor: pointer;
  }

  .src summary b {
    margin-right: 6px;
    color: var(--ink-2);
    font-weight: 600;
  }

  .src summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 可信度向上弹出，不把卡片撑高 */
  .pop {
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    width: min(30em, 80vw);
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--card);
    box-shadow: var(--shadow);
    color: var(--ink-2);
    z-index: 5;
  }

  .card:last-child .pop {
    left: auto;
    right: 0;
  }

  .pop p {
    margin: 0 0 6px;
  }

  .pop b {
    margin-right: 6px;
    color: var(--accent-ink);
  }

  .pop a {
    color: var(--accent-ink);
  }

  .end {
    margin: 0;
    font-size: clamp(20px, 2vw, 36px);
    font-weight: 600;
    color: var(--accent-ink);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }

  .body:not(.at-end) .end {
    opacity: 0;
    transform: translateY(8px);
  }


  /* 第三张：两年对比的横条，浅色是上一年，深色是今年 */
  .bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(8px, 1.4vh, 14px);
    flex: 1;
  }

  .yrs {
    margin: 0;
    display: flex;
    gap: 14px;
    font-size: clamp(11px, 0.8vw, 13px);
    color: var(--ink-3);
  }

  .yrs i {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 5px;
    border-radius: 2px;
    vertical-align: -1px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 10px;
    align-items: center;
    padding: 4px 6px;
    border-radius: var(--r-sm);
    cursor: pointer;
    outline: none;
  }

  .row[data-on],
  .row:focus-visible {
    background: var(--c-soft);
  }

  .row .rk {
    grid-column: 1 / -1;
    font-size: clamp(12px, 0.95vw, 15px);
    color: var(--ink-2);
  }

  .row .tr {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .row .tr i {
    display: block;
    height: 8px;
    width: var(--w);
    border-radius: 4px;
  }

  .y0 {
    background: var(--line-2);
  }

  .y1 {
    background: var(--c);
  }

  .row b {
    font-family: var(--mono);
    font-size: clamp(13px, 1vw, 17px);
    color: var(--c);
  }

  @media (max-width: 1200px) and (min-width: 901px) {
    .lines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .chart {
      max-height: 16vh;
    }
  }

  @media (max-width: 900px) {
    .lines {
      grid-template-columns: 1fr;
    }
    [data-at] .card:not(.seen) {
      opacity: 1;
    }
    .body:not(.at-end) .end {
      opacity: 1;
      transform: none;
    }
    .pop,
    .card:last-child .pop {
      position: static;
      width: auto;
      margin-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .end {
      transition: none;
    }
    .card.seen .ln {
      animation: none;
    }
  }
</style>

<script>
  // 讲到第几条：这条抬起来、讲过的亮着，最后一条讲完出结论
  document.querySelectorAll<HTMLElement>('[data-gap]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const paint = (i: number) => {
      cards.forEach((c, j) => {
        c.classList.toggle('on', j === i);
        if (j <= i) c.classList.add('seen');
      });
      root.classList.toggle('at-end', i === cards.length - 1);
    };
    root.addEventListener('step', (e) => paint((e as CustomEvent<number>).detail));
    paint(Number(root.dataset.at ?? 0));
  });
</script>
