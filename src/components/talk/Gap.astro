---
/**
 * 演讲 02「先数字化，再 AI 化」：左右两块色块图（每格 1%）。
 * 每个数一种颜色，全部同时画出来：数从大到小排，颜色从浅到深，越深 = 用得越深（后一个数是前一个的子集）。
 * ← → 或悬停一行，色块图只亮这一个数占的格；最下面一行小字是编号对应的来源。
 */
import { talk } from '../../i18n/talk';

const g = talk.gap;
const circled = (n: number) => String.fromCharCode(0x2460 + n - 1);
/** 第 i 格属于第几层：有几个数大于 i，就是第几层（0 = 没填） */
const level = (items: { v: number }[], i: number) => items.filter((it) => it.v > i).length;
---

<section class="slide t-slide gap" data-slide data-notes={g.notes} aria-labelledby="gap-title">
  <header class="t-head">
    <p class="no">{g.no}</p>
    <h2 id="gap-title">{g.title}</h2>
    <p class="lead">{g.lead}</p>
  </header>

  <div class="body t-body" data-stepper data-hover data-gap>
    <div class="blocks">
      {
        g.blocks.map((b, bi) => (
          <section class={`block b${bi}`} data-block={bi}>
            <header class="bh">
              <h3 class="serif">{b.k}</h3>
              <span>{b.who} · {g.unit}</span>
            </header>
            <div class="inner">
              <div class="waffle" data-waffle={bi} aria-hidden="true">
                {Array.from({ length: 100 }, (_, i) => (
                  <i class={`lv${level(b.items, i)}`} style={`--i:${i}`} />
                ))}
              </div>
              <ol class="items" role="tablist" aria-label={b.k}>
                {b.items.map((it, k) => (
                  <li>
                    <button type="button" role="tab" data-step data-b={bi} data-lv={k + 1} aria-selected="false">
                      <i class={`sw lv${k + 1}`} aria-hidden="true" />
                      <b class="serif">{it.big}</b>
                      <span>
                        {it.text}
                        <sup>{circled(it.ref)}</sup>
                      </span>
                    </button>
                  </li>
                ))}
                {b.note && (
                  <li class="note">
                    <button type="button" role="tab" data-step data-b={bi} data-lv="0" aria-selected="false">
                      <i class="sw low" aria-hidden="true" />
                      <b class="serif">{b.note.big}</b>
                      <span>
                        {b.note.text}
                        <sup>{circled(b.note.ref)}</sup>
                      </span>
                    </button>
                  </li>
                )}
              </ol>
            </div>
          </section>
        ))
      }
    </div>

    <div class="tie">
      <button type="button" role="tab" data-step data-b="link" aria-selected="false">
        <span class="lk">数字化 → AI 化</span>
        <b class="serif">{g.link.big}</b>
        <span>
          {g.link.text}
          <sup>{circled(g.link.ref)}</sup>
        </span>
      </button>
      <p class="end serif">{g.end}</p>
    </div>

    <ol class="refs">
      {
        g.refs.map((r, i) => (
          <li>
            {circled(i + 1)} {r}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .gap {
    /* 每块一个色相，由浅到深 = 由浅到深地用 */
    --d1: var(--blue-soft);
    --d2: var(--cat-blue);
    --a1: var(--heat-1);
    --a2: var(--heat-3);
    --a3: var(--heat-4);
  }

  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(12px, 2.2vh, 26px);
  }

  .blocks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2.4vw, 44px);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(16px, 1.8vw, 30px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    transition: border-color 0.3s, transform 0.4s var(--ease);
  }

  .block.on {
    border-color: var(--line-2);
    transform: translateY(-3px);
  }

  .bh {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bh h3 {
    margin: 0;
    font-size: clamp(22px, 2vw, 36px);
    font-weight: 600;
  }

  .bh span {
    font-size: clamp(12px, 0.95vw, 15px);
    color: var(--ink-3);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(14px, 1.8vw, 32px);
    align-items: center;
  }

  .waffle {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: clamp(2px, 0.3vw, 5px);
    width: min(100%, 32vh);
    aspect-ratio: 1;
  }

  .waffle i {
    border-radius: 3px;
    background: var(--heat-0);
    transition: opacity 0.35s ease calc(var(--i) * 3ms), transform 0.35s var(--ease) calc(var(--i) * 3ms);
  }

  .b0 .lv1 {
    background: var(--d1);
  }
  .b0 .lv2 {
    background: var(--d2);
  }
  .b1 .lv1 {
    background: var(--a1);
  }
  .b1 .lv2 {
    background: var(--a2);
  }
  .b1 .lv3 {
    background: var(--a3);
  }

  /* 选中某个数：只亮这个数占的格（这一层和更深的层），其余变淡 */
  .waffle[data-hl] i {
    opacity: 0.22;
  }
  .waffle[data-hl='1'] i:is(.lv1, .lv2, .lv3),
  .waffle[data-hl='2'] i:is(.lv2, .lv3),
  .waffle[data-hl='3'] i.lv3 {
    opacity: 1;
    transform: scale(1.04);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .items button,
  .tie button {
    width: 100%;
    display: grid;
    grid-template-columns: 14px clamp(78px, 6.6vw, 128px) 1fr;
    align-items: baseline;
    gap: 10px;
    padding: 8px 12px;
    text-align: left;
    font: inherit;
    color: var(--ink-2);
    background: transparent;
    border: 1.5px solid transparent;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }

  .sw {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    align-self: center;
  }
  .b0 .sw.lv1 {
    background: var(--d1);
  }
  .b0 .sw.lv2 {
    background: var(--d2);
  }
  .b1 .sw.lv1 {
    background: var(--a1);
  }
  .b1 .sw.lv2 {
    background: var(--a2);
  }
  .b1 .sw.lv3 {
    background: var(--a3);
  }
  .sw.low {
    background: transparent;
    border: 1.5px dashed var(--ink-3);
  }

  .items b {
    font-size: clamp(20px, 1.9vw, 34px);
    line-height: 1;
    font-weight: 600;
    color: var(--ink);
  }

  .items span {
    font-size: clamp(14px, 1.15vw, 20px);
    line-height: 1.4;
  }

  .note {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--line-2);
  }

  .note b {
    color: var(--ink-3) !important;
  }

  sup {
    font-size: 0.7em;
    color: var(--ink-3);
    margin-left: 2px;
  }

  .items button[aria-selected='true'],
  .tie button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--line-2);
    background: var(--bg-2);
  }

  .tie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px clamp(16px, 2.4vw, 44px);
  }

  .tie button {
    width: auto;
    grid-template-columns: auto auto auto;
    gap: 14px;
    padding: 10px 18px;
    border-color: var(--line-2);
  }

  .lk {
    font-size: 13px;
    letter-spacing: 0.06em;
  }

  .tie b {
    font-size: clamp(22px, 2vw, 36px);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-ink);
  }

  .tie span {
    font-size: clamp(14px, 1.2vw, 21px);
  }

  .end {
    margin: 0;
    font-size: clamp(20px, 1.9vw, 34px);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .refs {
    list-style: none;
    margin: 0;
    padding: 10px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    font-size: clamp(11px, 0.78vw, 13px);
    line-height: 1.5;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .blocks,
    .inner {
      grid-template-columns: 1fr;
    }
    .waffle {
      width: min(70vw, 260px);
    }
    .tie button {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .waffle i,
    .block {
      transition: none;
    }
  }
</style>

<script>
  // 选中一行：对应那块色块图只亮这个数占的格；note 行（不在色块图里的对比数）和底部连接行不高亮格子
  document.querySelectorAll<HTMLElement>('[data-gap]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const blocks = [...root.querySelectorAll<HTMLElement>('[data-block]')];
    const waffles = [...root.querySelectorAll<HTMLElement>('[data-waffle]')];
    const paint = (s: HTMLElement) => {
      const b = s.dataset.b!;
      const lv = s.dataset.lv;
      waffles.forEach((w) => {
        if (w.dataset.waffle === b && lv && lv !== '0') w.dataset.hl = lv;
        else delete w.dataset.hl;
      });
      blocks.forEach((bl) => bl.classList.toggle('on', bl.dataset.block === b || b === 'link'));
    };
    root.addEventListener('step', (e) => paint(steps[(e as CustomEvent<number>).detail]));
    paint(steps[Number(root.dataset.at ?? 0)] ?? steps[0]);
  });
</script>
