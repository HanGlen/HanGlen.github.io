---
/**
 * 演讲 02「AI 用得广，但用得浅」：四层数字，左边一个大圆环跟着走。
 * ← → 或悬停右边每一层切换；圆环、大数字、出处一起换。
 */
import { talk } from '../../i18n/talk';

const g = talk.gap;
const R = 120;
const L = 2 * Math.PI * R;
---

<section class="slide t-slide gap" data-slide data-notes={g.notes} aria-labelledby="gap-title">
  <header class="t-head">
    <p class="no">{g.no}</p>
    <h2 id="gap-title">{g.title}</h2>
    <p class="lead">{g.lead}</p>
  </header>

  <div class="body" data-stepper data-hover data-at="0" data-gap>
    <div class="ring-box">
      <svg viewBox="0 0 300 300" class="ring" aria-hidden="true">
        <circle cx="150" cy="150" r={R} class="track" />
        <circle cx="150" cy="150" r={R} class="arc" data-arc style={`stroke-dasharray:${L};stroke-dashoffset:${L * (1 - g.steps[0].v / 100)}`} data-len={L} transform="rotate(-90 150 150)" />
      </svg>
      {
        g.steps.map((s, i) => (
          <div class="mid" data-pane={String(i)} hidden={i !== 0}>
            <b class="serif">{s.big}</b>
            <span>{s.text}</span>
          </div>
        ))
      }
    </div>

    <div class="right">
      <ol class="steps" role="tablist" aria-label={g.title}>
        {
          g.steps.map((s, i) => (
            <li>
              <button type="button" role="tab" data-step data-v={s.v} aria-selected={i === 0 ? 'true' : 'false'}>
                <span class="k">{s.k}</span>
                <b class="serif">{s.big}</b>
                <span class="t">{s.text}</span>
              </button>
            </li>
          ))
        }
      </ol>

      {
        g.steps.map((s, i) => (
          <div class="detail" data-pane={String(i)} hidden={i !== 0}>
            <p class="sub">{s.sub}</p>
            <p class="t-src">{s.src}</p>
          </div>
        ))
      }

      <blockquote class="quote">
        <p class="q serif">{g.quote}</p>
        <p class="qw">{g.quoteWho}</p>
      </blockquote>
      <p class="end serif">{g.end}</p>
    </div>
  </div>
</section>

<style>
  .body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 80px);
    align-items: center;
  }

  .ring-box {
    position: relative;
    width: min(100%, 56vh, 560px);
    aspect-ratio: 1;
    justify-self: center;
  }

  .ring {
    width: 100%;
    height: 100%;
  }

  .track {
    fill: none;
    stroke: var(--heat-0);
    stroke-width: 26;
  }

  .arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 26;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .mid {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 18%;
    gap: 8px;
  }

  .mid[hidden],
  .detail[hidden] {
    display: none;
  }

  .mid b {
    font-size: clamp(56px, 7vw, 128px);
    line-height: 1;
    color: var(--accent-ink);
    font-weight: 600;
  }

  .mid span {
    font-size: clamp(16px, 1.6vw, 28px);
    line-height: 1.35;
  }

  .right {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.4vh, 28px);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .steps button {
    width: 100%;
    display: grid;
    grid-template-columns: 3em 5.2em 1fr;
    align-items: baseline;
    gap: 12px;
    padding: 10px 16px;
    text-align: left;
    font: inherit;
    color: var(--ink-3);
    background: transparent;
    border: 1.5px solid transparent;
    border-radius: var(--r);
    cursor: pointer;
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }

  .steps .k {
    font-size: clamp(13px, 1vw, 16px);
    letter-spacing: 0.06em;
  }

  .steps b {
    font-size: clamp(22px, 2vw, 36px);
    line-height: 1;
    font-weight: 600;
  }

  .steps .t {
    font-size: clamp(15px, 1.35vw, 23px);
  }

  .steps button.seen {
    color: var(--ink-2);
  }

  .steps button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .steps button[aria-selected='true'] b {
    color: var(--accent-ink);
  }

  .detail {
    min-height: 4.5em;
  }

  .detail p {
    margin: 0 0 4px;
  }

  .sub {
    font-size: clamp(16px, 1.4vw, 24px);
    color: var(--ink-2);
  }

  .quote {
    margin: 0;
    padding: 2px 0 2px 18px;
    border-left: 3px solid var(--accent);
  }

  .q {
    margin: 0;
    font-size: clamp(22px, 2.1vw, 36px);
    font-weight: 600;
  }

  .qw {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }

  .end {
    margin: 0;
    font-size: clamp(22px, 2.1vw, 36px);
    font-weight: 600;
    color: var(--accent-ink);
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .ring-box {
      width: min(80vw, 320px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc {
      transition: none;
    }
  }
</style>

<script>
  // 圆环跟着当前层走
  document.querySelectorAll<HTMLElement>('[data-gap]').forEach((root) => {
    const arc = root.querySelector<SVGCircleElement>('[data-arc]')!;
    const len = Number(arc.dataset.len);
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    root.addEventListener('step', (e) => {
      const v = Number(steps[(e as CustomEvent<number>).detail].dataset.v);
      arc.style.strokeDashoffset = String(len * (1 - v / 100));
    });
  });
</script>
