---
/**
 * 演讲 02「企业的数字化和 AI，做到哪了」：一张横条图，同一把 0–100% 的尺子。
 * 蓝 = 数字化，陶土红 = AI；中小企业的 AI 一行，浅色是「在用」、深色是「用进核心业务」。
 * ← → 或悬停一行：这一行亮起，还没讲到的行先淡着（渐进披露）；页底是编号对应的来源。
 */
import { talk } from '../../i18n/talk';

const g = talk.gap;
const circled = (n: number) => String.fromCharCode(0x2460 + n - 1);
let idx = 0;
const groups = g.groups.map((gr) => ({ ...gr, rows: gr.rows.map((r) => ({ ...r, i: idx++ })) }));
---

<section class="slide t-slide gap" data-slide data-notes={g.notes} aria-labelledby="gap-title">
  <header class="t-head">
    <p class="no">{g.no}</p>
    <h2 id="gap-title">{g.title}</h2>
    <p class="lead">{g.lead}</p>
  </header>

  <div class="body t-body" data-stepper data-hover>
    <div class="chart" role="tablist" aria-label={g.title}>
      <div class="axis" aria-hidden="true">
        {[0, 25, 50, 75, 100].map((t) => <span style={`--x:${t}%`}>{t}%</span>)}
      </div>
      {
        groups.map((gr) => (
          <section class="grp">
            <h3 class="gk serif">{gr.k}</h3>
            <div class="rows">
              {gr.rows.map((r) => (
                <button type="button" role="tab" data-step data-i={r.i} class={`row k-${r.kind}`} aria-selected="false" style={`--i:${r.i}`}>
                  <span class="txt">
                    {r.text}
                    <sup>{circled(r.ref)}</sup>
                  </span>
                  <span class="track">
                    <i class="bar" style={`--v:${r.v}%`} aria-hidden="true" />
                    {'deep' in r && <i class="bar deep" style={`--v:${r.deep}%`} aria-hidden="true" />}
                    <b class="big serif" style={`--v:${r.v}%`}>{r.big}</b>
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div class="foot">
      <p class="legend" aria-hidden="true">
        {g.legend.map((l) => (
          <span class={`k-${l.k}`}>
            <i />
            {l.v}
          </span>
        ))}
      </p>
      <p class="end serif">{g.end}</p>
    </div>

    <ol class="refs">
      {
        g.refs.map((r, i) => (
          <li>
            {circled(i + 1)} {r}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .gap {
    --dig: var(--cat-blue);
    --ai: var(--heat-3);
    --ai-soft: var(--heat-1);
  }

  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(14px, 2.6vh, 30px);
  }

  .chart {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2vh, 22px);
    --lab: clamp(220px, 24vw, 420px);
    --gk: clamp(120px, 10vw, 190px);
  }

  .axis {
    position: relative;
    height: 1.4em;
    margin-left: calc(var(--gk) + var(--lab));
    margin-right: 4em;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .axis span {
    position: absolute;
    left: var(--x);
    transform: translateX(-50%);
  }

  .grp {
    display: grid;
    grid-template-columns: var(--gk) 1fr;
    align-items: center;
    padding-top: clamp(8px, 1.6vh, 18px);
    border-top: 1px solid var(--line);
  }

  .gk {
    margin: 0;
    font-size: clamp(20px, 1.9vw, 34px);
    font-weight: 600;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1.2vh, 14px);
  }

  .row {
    display: grid;
    grid-template-columns: var(--lab) 1fr;
    align-items: center;
    padding: 4px 0;
    font: inherit;
    color: var(--ink);
    text-align: left;
    background: none;
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: opacity 0.45s var(--ease);
  }

  .txt {
    padding-right: 16px;
    font-size: clamp(15px, 1.35vw, 24px);
    color: var(--ink-2);
  }

  .txt sup {
    margin-left: 2px;
    font-size: 0.6em;
    color: var(--ink-3);
  }

  .track {
    position: relative;
    height: clamp(26px, 3.4vh, 42px);
    margin-right: 4em;
    background: repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px 25%);
    border-left: 1px solid var(--line-2);
  }

  .bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--v);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    background: var(--dig);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .k-ai .bar {
    background: var(--ai);
  }

  /* 中小企业的 AI：浅色在用，深色用进核心业务 */
  .k-ai .bar:has(+ .deep) {
    background: var(--ai-soft);
  }

  .bar.deep {
    background: var(--ai);
  }

  .big {
    position: absolute;
    left: var(--v);
    top: 50%;
    transform: translate(10px, -50%);
    font-size: clamp(22px, 2.3vw, 42px);
    font-weight: 600;
    white-space: nowrap;
    line-height: 1;
    transition: opacity 0.45s var(--ease);
  }

  .k-dig .big {
    color: var(--dig);
  }

  .k-ai .big {
    color: var(--accent-ink);
  }

  /* 渐进披露：讲到的行亮着，没讲到的行淡着、条还没长出来 */
  .row[aria-selected='true'] .txt {
    color: var(--ink);
    font-weight: 600;
  }

  [data-at] .row:not(.seen) {
    opacity: 0.28;
  }

  [data-at] .row:not(.seen) .bar {
    transform: scaleX(0);
  }

  [data-at] .row:not(.seen) .big {
    opacity: 0;
  }

  /* 结论讲到最后一行才出来 */
  .end {
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }

  .body:not([data-at='4']) .end {
    opacity: 0;
    transform: translateY(8px);
  }

  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 24px;
  }

  .legend {
    margin: 0;
    display: flex;
    gap: 18px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend i {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--dig);
  }

  .legend .k-ai i {
    background: var(--ai);
  }

  .end {
    margin: 0;
    font-size: clamp(20px, 2vw, 36px);
    font-weight: 600;
  }

  .refs {
    list-style: none;
    margin: 0;
    padding: 10px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 2px 20px;
    font-size: 11px;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .chart {
      --lab: 0px;
      --gk: 0px;
    }
    .axis {
      display: none;
    }
    .grp {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      opacity: 1 !important;
    }
    .track {
      margin-right: 5em;
    }
    [data-at] .row:not(.seen) .bar {
      transform: none;
    }
    [data-at] .row:not(.seen) .big {
      opacity: 1;
    }
    .body:not([data-at='4']) .end {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .big,
    .row {
      transition: none;
    }
  }
</style>
