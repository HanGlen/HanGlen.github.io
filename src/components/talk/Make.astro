  .one li.spec-step {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .one li.gate {
    border-color: var(--ok);
  }

  .one li.done {
    border-color: var(--ink);
    background: var(--ink);
  }

  .spin {
    position: absolute;
    right: -0.55em;
    bottom: -0.55em;
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    background: var(--bg);
