---
/**
 * 演讲 04「Agentic Engineering 系统」：工具 → 模型 → 地基（代码仓库）→ 最小单 → 一个大需求（Project + 定时任务）
 * → 一堆需求（AI 切片）→ 验证（poteto 金字塔）。每步右栏大字是核心句，下面一行「参考」写参考了谁。
 * 顶上是步骤 tab，← → 下一步；左边一张图，右边只放两层：一个问题、一句备注。
 * 每步的例子统一放在底部一条独立色块里，依据在色块右边点开才看（渐进披露）。
 * 4 → 5、5 → 6 用 View Transition 串起来（data-vt 列出哪两步之间变形，切换时写进 data-vt-pair）：
 * 「一张单」缩进定时任务里；「一个大需求」缩成一堆需求里的 Project A。
 */
import { talk } from '../../i18n/talk';
import { rich } from '../../lib/rich';

const m = talk.make;
const L = m.levels;
// 工具：八类各一张卡，国内 / 国外各露 3 个
const SHOW = 3;
const used = m.toolsUsed;
---

<section class="slide t-slide make" data-slide data-notes={m.notes} aria-labelledby="make-title">
  <header class="t-head">
    <p class="no">{m.no}</p>
    <h2 id="make-title">{m.title}</h2>
    <p class="lead">{m.lead}</p>
  </header>

  <div class="body t-body t-steps" data-stepper data-vt="3-4 4-5" style={`--n: ${L.length}`}>
    <ol class="line" role="tablist" aria-label={m.title}>
      {
        L.map((l, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true">{i + 1}</i>
              <span>{l.k}</span>
              <em>{l.tag}</em>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="main">
      <div class="stage">
        <!-- 1 工具：八类，一类一张卡（国内 / 国外各露 3 个，名字链官网），我在用的标红点；悬停一类看完整清单 -->
        <div class="frame" data-pane="0" data-reads>
          <ul class="kit">
            {
              m.tools.map((t, i) => (
                <li class="fin" style={`--d:${i + 1}`} tabindex="0" data-read={`${t.k}　${m.toolsHead[1]}：${t.cn.map(([n]) => n).join('、')}；${m.toolsHead[2]}：${t.en.map(([n]) => n).join('、')}`}>
                  <b class="serif">{t.k}</b>
                  {[[m.toolsHead[1], t.cn], [m.toolsHead[2], t.en]].map(([k, xs]) => (
                    <p>
                      <em>{k}</em>
                      {(xs as [string, string][]).slice(0, SHOW).map(([name, href]) => (
                        <a href={href} target="_blank" rel="noopener" class={used.includes(name) ? 'mine' : undefined}>
                          {name}
                        </a>
                      ))}
                    </p>
                  ))}
                </li>
              ))
            }
          </ul>
          <p class="t-read" aria-live="polite" data-read-out data-hint={m.toolsHint}>{m.toolsHint}</p>
        </div>

        <!-- 2 模型：每个领域只写第一名，悬停一行看前三和口径，点榜单打开原页 -->
        <div class="frame" data-pane="1" hidden>
          <div class="models" data-rows>
            <table class="board">
              <thead>
                <tr class="fin">
                  {[m.modelsHead[0], m.modelsHead[1], m.modelsHead[4]].map((h) => <th scope="col">{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  m.models.map((x, i) => (
                    <tr class="fin" style={`--d:${i + 1}`} tabindex="0" data-row={`${x.k}　${x.top.map(([n, sc], j) => `${j + 1}. ${n}${sc ? `（${sc}）` : ''}`).join('　')}。${x.note}`}>
                      <th scope="row">{x.k}</th>
                      <td class="first">
                        <b>{x.top[0][0]}</b>
                      </td>
                      <td class="bd">
                        <a href={x.href} target="_blank" rel="noopener">
                          {x.board} ↗
                        </a>
                        <span>{x.at}</span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="tip" aria-live="polite" data-row-out data-hint={m.modelsHint}>{m.modelsHint}</p>
          </div>
        </div>

        <!-- 3 地基：中间模型，中圈现成 Harness（左边六个 AI 都能插进来），外圈代码仓库 -->
        <div class="frame" data-pane="2" hidden>
          <div class="harness" data-harness data-unplug={m.harness.unplug}>
            <div class="rig">
            <div class="swap fin" style="--d:3">
              <p>{m.harness.swapK}</p>
              <ul>
                {m.harness.swap.map((x) => (
                  <li>
                    <button type="button" class="plug" data-plug={x}>{x}</button>
                  </li>
                ))}
              </ul>
            </div>
            <div class="ring fin" style="--d:0">
              <p class="rk"><b class="serif">{m.harness.ring}</b>{m.harness.ringV}</p>
              <ul class="parts">
                {m.harness.parts.map((p, i) => (
                  <li class={`p${i}`}>
                    <button type="button" data-tip={p.tip}>{p.k}</button>
                  </li>
                ))}
              </ul>
              <div class="mid fin" style="--d:1">
                <p class="mk"><b class="serif">{m.harness.mid}</b></p>
                <ul class="mparts">
                  {m.harness.midParts.map((p, i) => (
                    <li class={`m${i}`}>
                      <button type="button" data-tip={p.tip}>{p.k}</button>
                    </li>
                  ))}
                </ul>
                <div class="core fin" style="--d:2">
                  <b class="serif">{m.harness.model}</b>
                  <span>{m.harness.modelV}</span>
                </div>
              </div>
            </div>
            </div>
            <p class="tip" aria-live="polite" data-tip-out data-hint={m.harness.hint}>{m.harness.hint}</p>
          </div>
        </div>

        <!-- 4 一张单：上面专业说法，下面同一个过程的真实例子 -->
        <div class="frame" data-pane="3" hidden>
          <ol class="pipe vt-ticket">
            {
              m.ticket.map((t, i) => (
                <li class={`fin ${i === 0 ? 'spec-step' : ''} ${i === 3 || i === 4 ? 'gate' : ''} ${i === 5 ? 'done' : ''}`} style={`--d:${i}`}>
                  <span class="pk">{t.k}</span>
                  <span class="pe">{t.en}</span>
                  <span class="px">{t.ex}</span>
                </li>
              ))
            }
          </ol>
          <div class="retry fin" style="--d:6">
            <div class="loop" aria-hidden="true"><i class="tick" /></div>
            <p>↻ {m.retry}</p>
          </div>
        </div>

        <!-- 5 一个大需求：横着一条线；上一步那张单缩进「定时任务」里（View Transition） -->
        <div class="frame" data-pane="4" hidden>
          <div class="flow vt-need">
            <div class="req">
              <em>{m.need.project}</em>
              <b class="serif">{m.need.req}</b>
            </div>
            <span class="arr fin" style="--d:1">→</span>
            <span class="chip hot fin" style="--d:2">{m.need.ana}</span>
            <span class="arr fin" style="--d:3">→</span>
            <div class="slices fin" style="--d:4">
              <p>{m.need.slice}</p>
              <ol>{[1, 2, 3, 4, 5, 6].map(() => <li />)}</ol>
            </div>
            <span class="arr fin" style="--d:5">→</span>
            <div class="loopbox">
              <p class="lh"><span class="clock" aria-hidden="true">◷</span>{m.need.loop}<small>{m.need.loopV}</small></p>
              <div class="one vt-ticket">
                <span>{m.need.one}</span>
                <ol aria-hidden="true">
                  {m.ticket.map((_, i) => (
                    <li class={i === 0 ? 'spec-step' : i === 3 || i === 4 ? 'gate' : i === 5 ? 'done' : ''} />
                  ))}
                </ol>
              </div>
              <span class="spin" aria-hidden="true">↻</span>
            </div>
            <span class="arr fin" style="--d:7">→</span>
            <span class="chip done fin" style="--d:8">{m.need.done}</span>
          </div>
          <p class="who fin" style="--d:9">
            <b>{m.need.whoK}</b>
            {
              m.need.who.map((w) => (
                <span>
                  <i class="serif">{w.ai}</i>
                  {w.v}
                </span>
              ))
            }
          </p>
        </div>

        <!-- 6 一堆需求：先框成一堆 → 分诊 → 一个个 Project（里面全是最小的单）→ 定时任务一直跑 -->
        <div class="frame" data-pane="5" hidden>
          <div class="flow">
            <div class="pile">
              <em>{m.triage.pile}</em>
              <ul>
                {m.triage.sources.map((x) => <li class="chip">{x}</li>)}
              </ul>
            </div>
            <span class="arr fin" style="--d:1">→</span>
            <div class="butler fin" style="--d:2">
              <b>{m.triage.butler}</b>
              <span>{m.triage.butlerV}</span>
            </div>
            <span class="arr fin" style="--d:3">→</span>
            <ul class="projects">
              {
                m.triage.projects.map((x, i) => (
                  <li class={i === 0 ? 'vt-need' : 'fin'} style={`--d:${4 + i}`}>
                    <em>{x}</em>
                    <ol>
                      {Array.from({ length: 6 - i }, () => (
                        <li />
                      ))}
                    </ol>
                  </li>
                ))
              }
            </ul>
            <span class="arr fin" style="--d:7">→</span>
            <div class="loopbox small">
              <p class="lh"><span class="clock" aria-hidden="true">◷</span>{m.triage.loop}<small>{m.triage.loopV}</small></p>
              <span class="spin" aria-hidden="true">↻</span>
            </div>
            <span class="arr fin" style="--d:9">→</span>
            <span class="chip done fin" style="--d:10">{m.triage.done}</span>
          </div>
        </div>

        <!-- 7 验证：poteto 金字塔，上宽下窄，越往下越贵；每层悬停看小程序里的例子 -->
        <div class="frame" data-pane="6" hidden>
          <div class="pyr" data-reads>
            <p class="cost up fin" style="--d:6" aria-hidden="true"><span>{[...m.pyramid.sure].map((ch) => <i>{ch}</i>)}</span></p>
            <ol>
              {
                m.pyramid.layers.map((x, i) => (
                  <li class="fin" style={`--d:${i + 1}; --k:${i}`} data-read={`${x.k}（${x.v}）。小程序里：${x.ex}`}>
                    <b class="serif">{x.k}</b>
                    <em>{x.en}</em>
                    <span>{x.v}</span>
                  </li>
                ))
              }
            </ol>
            <p class="cost fin" style="--d:6" aria-hidden="true"><span>{[...m.pyramid.cost].map((ch) => <i>{ch}</i>)}</span></p>
            <p class="t-read" aria-live="polite" data-read-out data-hint={m.pyramid.hint}>{m.pyramid.hint}</p>
          </div>
        </div>
      </div>

      <aside class="side" aria-live="polite">
        {
          L.map((l, i) => (
            <div class="sp" data-pane={String(i)} hidden={i !== 0}>
              <h3 class="serif">{l.q}</h3>
              <p class="plain">{l.plain}</p>
              {'ref' in l && l.ref && <p class="ref"><b>{m.refK}</b><span set:html={rich(l.ref)} /></p>}
            </div>
          ))
        }
        <p class="t-hint">{m.hint}</p>
      </aside>
    </div>

    <!-- 每步的例子：固定在底部，单独一条色块 -->
    {
      L.map((l, i) => (
        <div class="ex" data-pane={String(i)} hidden={i !== 0}>
          <b>{m.caseK}</b>
          <p>{l.case}</p>
          {l.src && (
            <details class="src">
              <summary>{m.srcK}</summary>
              <p set:html={rich(l.src)} />
            </details>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* 参考了谁：右栏大白话下面一行小字，名字链到原文 */
  .ref {
    margin: clamp(10px, 1.6vh, 18px) 0 0;
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: clamp(13px, 0.95vw, 16px);
    line-height: 1.5;
    color: var(--ink-3);
  }

  .ref b {
    flex: none;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
  }

  .ref :global(a) {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
  }

  .ref :global(a:hover),
  .ref :global(a:focus-visible) {
    color: var(--accent-ink);
    text-decoration-color: var(--accent);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em 0.9em;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--line-2);
    background: var(--card);
    font-size: clamp(14px, 1.3vw, 24px);
    white-space: nowrap;
  }

  .chip.hot {
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .chip.done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .arr {
    color: var(--ink-3);
    font-size: clamp(14px, 1.2vw, 20px);
  }

  /* 工具：八类 4 × 2 张卡；类名大字，下面国内 / 国外各一行，我在用的标红点 */
  .kit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 16px);
  }

  .kit li {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1vh, 10px);
    padding: clamp(12px, 1.2vw, 20px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    outline: none;
    transition: border-color 0.2s, transform 0.2s var(--ease);
  }

  .kit li[data-on],
  .kit li:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .kit b {
    font-size: clamp(18px, 1.6vw, 28px);
    font-weight: 600;
    line-height: 1.2;
  }

  .kit p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px clamp(8px, 0.7vw, 12px);
  }

  .kit em {
    flex: 0 0 100%;
    font-style: normal;
    font-size: clamp(11px, 0.8vw, 13px);
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .kit a {
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.4;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }

  .kit a.mine {
    font-weight: 600;
    color: var(--ink);
  }

  .kit a.mine::before {
    content: '';
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-right: 0.3em;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.2em;
  }

  .kit a:hover,
  .kit a:focus-visible {
    outline: none;
    color: var(--accent-ink);
    border-bottom-color: var(--accent);
  }

  .frame[data-pane='0'] .t-read {
    margin-top: clamp(8px, 1.6vh, 18px);
  }

  .board {
    width: 100%;
    border-collapse: collapse;
  }

  .board th,
  .board td {
    padding: clamp(6px, 1.1vh, 14px) clamp(10px, 1vw, 18px);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }

  .board thead th {
    padding-top: 0;
    font-size: clamp(12px, 0.9vw, 15px);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    border-bottom: 1.5px solid var(--line-2);
  }

  .board tbody th {
    width: 1%;
    font-size: clamp(15px, 1.25vw, 22px);
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
  }

  /* 模型能力：领域 × 领先的那家 × 榜单 */
  .models {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.4vh, 16px);
  }

  .board tbody tr {
    cursor: default;
    transition: background 0.2s;
  }

  .board tbody tr:hover,
  .board tbody tr:focus-visible,
  .board tbody tr[aria-selected='true'] {
    outline: none;
    background: var(--accent-soft);
  }

  /* 只写第一名：大字、强调色 */
  .board td.first b {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(20px, 1.9vw, 34px);
    line-height: 1.2;
    color: var(--accent-ink);
  }

  .board td.bd {
    white-space: nowrap;
    font-size: clamp(13px, 1.05vw, 18px);
    color: var(--ink-3);
  }

  .board td.bd a {
    margin-right: 8px;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }

  .board td.bd a:hover,
  .board td.bd a:focus-visible {
    outline: none;
    color: var(--accent-ink);
    border-bottom-color: var(--accent);
  }

  .board td.bd span {
    font-family: var(--mono);
  }

  /* 地基：三圈。中间模型，中圈现成 Harness，外圈你加上的规矩 */
  .harness {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(8px, 1.4vh, 16px);
  }

  /* 左边六个 AI 都插进中圈；点一个拔掉，其余照跑 */
  .rig {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2vw, 36px);
  }

  .swap p {
    margin: 0 0 8px;
    font-size: clamp(11px, 0.85vw, 14px);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .swap ul {
    list-style: none;
    margin: 0;
    padding: 0 clamp(14px, 1.6vw, 28px) 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-right: 2px solid var(--ink-3);
  }

  .swap li {
    position: relative;
  }

  /* 每个 AI 一根线连到右边的总线 */
  .swap li::after {
    content: '';
    position: absolute;
    left: 100%;
    right: calc(-1 * clamp(14px, 1.6vw, 28px));
    top: 50%;
    border-top: 2px solid var(--ink-3);
    transition: opacity 0.25s;
  }

  .harness .plug {
    width: 100%;
    padding: 0.25em 0.8em;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--line-2);
    background: var(--card);
    color: var(--ink);
    font-size: clamp(12px, 1vw, 17px);
    text-align: left;
  }

  .harness .plug:hover {
    transform: translateX(-2px);
    background: var(--bg-2);
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .harness .plug[aria-pressed='true'] {
    transform: translateX(-10px);
    background: transparent;
    border-style: dashed;
    color: var(--ink-3);
    text-decoration: line-through;
  }

  .swap li:has(.plug[aria-pressed='true'])::after {
    opacity: 0;
  }

  .ring {
    position: relative;
    flex: 0 1 auto;
    width: min(100%, 60vh);
    aspect-ratio: 1.45;
    border-radius: 50%;
    border: 3px dashed var(--accent);
    background: var(--accent-soft);
    display: grid;
    place-items: center;
  }

  .rk,
  .mk {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
    line-height: 1.25;
  }

  .rk {
    top: 5%;
    color: var(--accent-ink);
    font-size: clamp(12px, 1vw, 17px);
  }

  .rk b {
    font-size: clamp(17px, 1.6vw, 28px);
    font-weight: 600;
  }

  .mid {
    position: relative;
    width: 48%;
    aspect-ratio: 1.45;
    margin-top: 10%;
    border-radius: 50%;
    border: 2px solid var(--line-2);
    background: var(--card);
    box-shadow: var(--shadow);
    display: grid;
    place-items: center;
  }

  .mk {
    top: 6%;
    color: var(--ink-2);
    font-size: clamp(11px, 0.85vw, 14px);
  }

  .mk b {
    font-size: clamp(14px, 1.25vw, 22px);
    font-weight: 600;
    color: var(--ink);
  }

  .parts,
  .mparts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .parts li,
  .mparts li {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .harness button {
    padding: 0.3em 0.8em;
    border-radius: var(--r-pill);
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.25s var(--ease), background 0.25s, color 0.25s;
  }

  .parts button {
    background: var(--card);
    border: 1.5px solid var(--accent);
    color: var(--ink);
    font-size: clamp(13px, 1.2vw, 22px);
  }

  .mparts button {
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    color: var(--ink-2);
    font-size: clamp(11px, 0.9vw, 16px);
    padding: 0.2em 0.65em;
  }

  .harness button:hover,
  .harness button[aria-pressed='true'] {
    transform: translateY(-2px);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .harness button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .p0 { left: 15%; top: 36%; }
  .p1 { left: 85%; top: 36%; }
  .p2 { left: 15%; top: 66%; }
  .p3 { left: 85%; top: 66%; }

  .m0 { left: 14%; top: 42%; }
  .m1 { left: 86%; top: 42%; }
  .m2 { left: 22%; top: 76%; }
  .m3 { left: 78%; top: 76%; }

  .core {
    width: 34%;
    margin-top: 10%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  .core b {
    font-size: clamp(18px, 1.9vw, 34px);
  }

  .core span {
    font-size: clamp(11px, 0.85vw, 15px);
    opacity: 0.8;
  }

  .tip {
    margin: 0;
    min-height: 1.5em;
    font-size: clamp(13px, 1.05vw, 18px);
    color: var(--ink-3);
    text-align: center;
  }

  .tip.on {
    color: var(--ink);
  }

  /* 一张单：每一步下面直接是例子 */
  .pipe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .pipe li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 12px 14px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  .pipe li + li::before {
    content: '→';
    position: absolute;
    left: -5px;
    top: 16px;
    transform: translateX(-50%);
    font-size: 13px;
    color: var(--ink-3);
  }

  .pk {
    font-size: clamp(15px, 1.3vw, 23px);
    font-weight: 600;
    white-space: nowrap;
  }

  .pe {
    font-family: var(--mono);
    font-size: clamp(10px, 0.78vw, 13px);
    color: var(--ink-3);
  }

  .px {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line-2);
    font-size: clamp(13px, 1.05vw, 18px);
    line-height: 1.45;
    color: var(--accent-ink);
  }

  .pipe .spec-step {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .pipe .gate {
    border-color: var(--ok);
  }

  .pipe .gate .pk {
    color: var(--ok);
  }

  .pipe .done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .pipe .done .pe,
  .pipe .done .px {
    color: var(--bg);
    opacity: 0.85;
  }

  /* 打回：一根虚线从评审（第 4 格）、门禁（第 5 格）底下绕回 AI 开发（第 2 格），说明写在线下面 */
  .retry {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0 10px;
    margin-top: -4px;
  }

  .retry .loop {
    grid-column: 2 / 6;
    position: relative;
    height: 26px;
    margin: 0 calc(100% / 8);
    border: 2px dashed var(--accent);
    border-top: 0;
    border-radius: 0 0 var(--r-sm) var(--r-sm);
  }

  /* 箭头朝上，指回 AI 开发 */
  .retry .loop::before {
    content: '';
    position: absolute;
    left: -7px;
    top: -6px;
    border: 6px solid transparent;
    border-bottom: 8px solid var(--accent);
    border-top: 0;
  }

  /* 评审那一格也伸下来一根 */
  .retry .tick {
    position: absolute;
    left: calc(200% / 3);
    top: 0;
    bottom: 0;
    border-left: 2px dashed var(--accent);
  }

  .retry p {
    grid-column: 2 / 6;
    margin: 8px 0 0;
    text-align: center;
    color: var(--accent-ink);
    font-size: clamp(13px, 1.1vw, 18px);
    font-weight: 600;
  }

  /* 一个大需求 / 一堆需求：横着一条线 */
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px clamp(6px, 0.8vw, 14px);
  }

  .req,
  .pile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(10px, 1vw, 18px) clamp(12px, 1.2vw, 20px);
    border-radius: var(--r);
    border: 2px solid var(--ink);
    background: var(--card);
  }

  .req em,
  .pile em,
  .projects em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(11px, 0.85vw, 14px);
