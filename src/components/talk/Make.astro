---
/**
 * 演讲 03「怎么做出来」：工具准备 → 地基 Harness → 一张单 → 一个大需求（Project + 定时任务）→ 一堆需求（分诊）。
 * 顶上是步骤 tab，← → 下一步；左边一张图，右边只放一个问题、一句大白话、一个例子，依据点开才看（渐进披露）。
 * 3 → 4、4 → 5 用 View Transition 串起来：同名的 view-transition-name 元素从上一步的位置变形到下一步
 * （整条「一张单」流水线缩进定时任务里；一个大需求变成框起来的一堆需求）。
 */
import { talk } from '../../i18n/talk';

const m = talk.make;
const L = m.levels;
---

<section class="slide t-slide make" data-slide data-notes={m.notes} aria-labelledby="make-title">
  <header class="t-head">
    <p class="kicker">{m.no} · {m.kicker}</p>
    <h2 id="make-title">{m.title}</h2>
    <p class="lead">{m.lead}</p>
  </header>

  <div class="body t-body" data-stepper data-vt>
    <ol class="line" role="tablist" aria-label={m.title}>
      {
        L.map((l, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true">{i + 1}</i>
              <span>{l.k}</span>
              <em>{l.tag}</em>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="main">
      <div class="stage">
        <!-- 1 工具准备：类型 × 入门 / 进阶 -->
        <div class="frame" data-pane="0">
          <table class="tools">
            <thead>
              <tr class="fin">
                {m.toolsHead.map((h) => <th scope="col">{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                m.tools.map((t, i) => (
                  <tr class="fin" style={`--d:${i + 1}`}>
                    <th scope="row">
                      {t.k}
                      {t.opt && <em>{t.opt}</em>}
                    </th>
                    {t.same ? (
                      <td colspan="2" class="same">
                        <b class="serif">{t.v[0]}</b>
                        <span>{t.same}</span>
                      </td>
                    ) : (
                      <>
                        <td>
                          {t.v.map((v) => (
                            <b class="serif">{v}</b>
                          ))}
                        </td>
                        <td class="pro">
                          {t.pro.map((v) => (
                            <b class="serif">{v}</b>
                          ))}
                        </td>
                      </>
                    )}
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="links fin" style="--d:5">
            <b>{m.models.k}</b>
            {
              m.models.links.map((x) => (
                <a href={x.href} target="_blank" rel="noopener">
                  {x.k} ↗
                </a>
              ))
            }
          </p>
        </div>

        <!-- 2 地基 Harness -->
        <div class="frame" data-pane="1" hidden>
          <div class="harness">
            <div class="ring fin" style="--d:0">
              <p class="rk"><b>{m.harness.ring}</b>{m.harness.ringV}</p>
              <ul class="parts">
                {m.harness.parts.map((p, i) => (
                  <li class={`p${i}`}>{p}</li>
                ))}
              </ul>
              <div class="core fin" style="--d:2">
                <b class="serif">{m.harness.model}</b>
                <span>{m.harness.modelV}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3 一张单：上面专业说法，下面同一个过程的真实例子 -->
        <div class="frame" data-pane="2" hidden>
          <p class="exk fin">{m.exK}</p>
          <ol class="pipe" style="view-transition-name: mk-ticket">
            {
              m.ticket.map((t, i) => (
                <li class={`fin ${i === 0 ? 'spec-step' : ''} ${i === 3 || i === 4 ? 'gate' : ''} ${i === 5 ? 'done' : ''}`} style={`--d:${i}`}>
                  <span class="pk">{t.k}</span>
                  <span class="pe">{t.en}</span>
                  <span class="px">{t.ex}</span>
                </li>
              ))
            }
          </ol>
          <div class="retry fin" style="--d:6" aria-label={m.retry}>
            <i class="tick" aria-hidden="true" />
            <span>↻ {m.retry}</span>
          </div>
        </div>

        <!-- 4 一个大需求：横着一条线；上一步那张单缩进「定时任务」里（View Transition） -->
        <div class="frame" data-pane="3" hidden>
          <div class="flow">
            <div class="req" style="view-transition-name: mk-req">
              <em>{m.need.project}</em>
              <b class="serif">{m.need.req}</b>
            </div>
            <span class="arr fin" style="--d:1">→</span>
            <span class="chip hot fin" style="--d:2">{m.need.ana}</span>
            <span class="arr fin" style="--d:3">→</span>
            <div class="slices fin" style="--d:4">
              <p>{m.need.slice}</p>
              <ol>{[1, 2, 3, 4, 5, 6].map(() => <li />)}</ol>
            </div>
            <span class="arr fin" style="--d:5">→</span>
            <div class="loopbox" style="view-transition-name: mk-loop">
              <p class="lh"><span class="clock" aria-hidden="true">◷</span>{m.need.loop}<small>{m.need.loopV}</small></p>
              <div class="one" style="view-transition-name: mk-ticket">
                <span>{m.need.one}</span>
                <ol aria-hidden="true">
                  {m.ticket.map((_, i) => (
                    <li class={i === 0 ? 'spec-step' : i === 3 || i === 4 ? 'gate' : i === 5 ? 'done' : ''} />
                  ))}
                </ol>
              </div>
              <span class="spin" aria-hidden="true">↻</span>
            </div>
            <span class="arr fin" style="--d:7">→</span>
            <span class="chip done fin" style="--d:8">{m.need.done}</span>
          </div>
          <p class="who fin" style="--d:9">
            <b>{m.need.whoK}</b>
            {
              m.need.who.map((w) => (
                <span>
                  <i class="serif">{w.ai}</i>
                  {w.v}
                </span>
              ))
            }
          </p>
        </div>

        <!-- 5 一堆需求：先框成一堆 → 分诊 → 一个个 Project（里面全是最小的单）→ 定时任务一直跑 -->
        <div class="frame" data-pane="4" hidden>
          <div class="flow">
            <div class="pile" style="view-transition-name: mk-req">
              <em>{m.triage.pile}</em>
              <ul>
                {m.triage.sources.map((x) => <li class="chip">{x}</li>)}
              </ul>
            </div>
            <span class="arr fin" style="--d:1">→</span>
            <div class="butler fin" style="--d:2">
              <b>{m.triage.butler}</b>
              <span>{m.triage.butlerV}</span>
            </div>
            <span class="arr fin" style="--d:3">→</span>
            <ul class="projects">
              {
                m.triage.projects.map((x, i) => (
                  <li class="fin" style={`--d:${4 + i}`}>
                    <em>{x}</em>
                    <ol>
                      {Array.from({ length: 6 - i }, () => (
                        <li />
                      ))}
                    </ol>
                  </li>
                ))
              }
            </ul>
            <span class="arr fin" style="--d:7">→</span>
            <div class="loopbox small" style="view-transition-name: mk-loop">
              <p class="lh"><span class="clock" aria-hidden="true">◷</span>{m.triage.loop}<small>{m.triage.loopV}</small></p>
              <span class="spin" aria-hidden="true">↻</span>
            </div>
            <span class="arr fin" style="--d:9">→</span>
            <span class="chip done fin" style="--d:10">{m.triage.done}</span>
          </div>
        </div>
      </div>

      <aside class="side" aria-live="polite">
        {
          L.map((l, i) => (
            <div class="sp" data-pane={String(i)} hidden={i !== 0}>
              <p class="lk">
                {l.k} · <span>{l.tag}</span>
              </p>
              <h3 class="serif">{l.q}</h3>
              <p class="plain">{l.plain}</p>
              <p class="case">
                <b>{m.caseK}</b>
                {l.case}
              </p>
              {l.src && (
                <details class="src">
                  <summary>{m.srcK}</summary>
                  {l.src}
                </details>
              )}
            </div>
          ))
        }
        <p class="t-hint">{m.hint}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2.4vh, 28px);
  }

  /* 顶部步骤 */
  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    position: relative;
  }

  .line::before {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    height: 2px;
    background: var(--line-2);
  }

  .line button {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 0;
    font: inherit;
    color: var(--ink-3);
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
  }

  .line i {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-style: normal;
    font-family: var(--mono);
    font-size: 13px;
    background: var(--bg);
    border: 2px solid var(--line-2);
    transition: background 0.3s, border-color 0.3s, color 0.3s, transform 0.3s;
  }

  .line span {
    font-size: clamp(15px, 1.3vw, 23px);
    font-weight: 600;
  }

  .line em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(11px, 0.8vw, 14px);
    color: var(--ink-3);
  }

  .line button.seen {
    color: var(--ink-2);
  }

  .line button.seen i {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .line button[aria-selected='true'] {
    color: var(--ink);
  }

  .line button[aria-selected='true'] em {
    color: var(--accent-ink);
  }

  .line button[aria-selected='true'] i {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    transform: scale(1.15);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .main {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(280px, 1fr);
    gap: clamp(24px, 3.4vw, 64px);
    align-items: center;
  }

  .frame {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 22px);
  }

  .frame[hidden],
  .sp[hidden] {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em 0.9em;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--line-2);
    background: var(--card);
    font-size: clamp(14px, 1.3vw, 24px);
    white-space: nowrap;
  }

  .chip.hot {
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .chip.done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .arr {
    color: var(--ink-3);
    font-size: clamp(14px, 1.2vw, 20px);
  }

  /* 工具准备：类型 × 入门 / 进阶 */
  .tools {
    width: 100%;
    border-collapse: collapse;
  }

  .tools th,
  .tools td {
    padding: clamp(10px, 1.6vh, 18px) clamp(10px, 1.2vw, 20px);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }

  .tools thead th {
    padding-top: 0;
    font-size: clamp(12px, 0.95vw, 15px);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    border-bottom: 1.5px solid var(--line-2);
  }

  .tools thead th:last-child {
    color: var(--accent-ink);
  }

  .tools tbody th {
    width: 26%;
    font-size: clamp(15px, 1.25vw, 22px);
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .tools tbody th em {
    margin-left: 8px;
    padding: 1px 8px;
    border: 1px dashed var(--ink-3);
    border-radius: var(--r-pill);
    font-style: normal;
    font-size: 0.7em;
    color: var(--ink-3);
  }

  .tools td b {
    display: inline-block;
    margin-right: clamp(12px, 1.2vw, 22px);
    font-size: clamp(20px, 2vw, 36px);
    font-weight: 600;
    line-height: 1.2;
  }

  .tools td.pro b {
    color: var(--accent-ink);
  }

  .tools td.same span {
    font-size: clamp(13px, 1.05vw, 17px);
    color: var(--ink-3);
  }

  .links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    font-size: 14px;
  }

  .links b {
    font-weight: 500;
    color: var(--ink-3);
  }

  .links a {
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }

  .links a:hover {
    color: var(--accent-ink);
  }

  /* 地基：模型在中间，Harness 是一圈 */
  .harness {
    display: grid;
    place-items: center;
  }

  .ring {
    position: relative;
    width: min(100%, 62vh);
    aspect-ratio: 1.35;
    border-radius: 50%;
    border: 3px dashed var(--accent);
    background: var(--accent-soft);
    display: grid;
    place-items: center;
  }

  .rk {
    position: absolute;
    top: 7%;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--accent-ink);
    font-size: clamp(13px, 1.1vw, 19px);
    white-space: nowrap;
  }

  .rk b {
    font-family: var(--mono);
    font-size: clamp(18px, 1.7vw, 30px);
  }

  .parts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .parts li {
    position: absolute;
    padding: 0.35em 0.8em;
    border-radius: var(--r-pill);
    background: var(--card);
    border: 1.5px solid var(--accent);
    font-size: clamp(14px, 1.3vw, 24px);
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .p0 { left: 14%; top: 42%; }
  .p1 { left: 86%; top: 42%; }
  .p2 { left: 24%; top: 80%; }
  .p3 { left: 76%; top: 80%; }

  .core {
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    box-shadow: var(--shadow);
  }

  .core b {
    font-size: clamp(22px, 2.4vw, 44px);
  }

  .core span {
    font-size: clamp(12px, 1vw, 17px);
    opacity: 0.8;
  }

  /* 一张单：每一步下面直接是例子 */
  .exk {
    margin: 0;
    font-size: clamp(13px, 1.05vw, 17px);
    color: var(--ink-3);
  }

  .pipe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .pipe li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 12px 14px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  .pipe li + li::before {
    content: '→';
    position: absolute;
    left: -5px;
    top: 16px;
    transform: translateX(-50%);
    font-size: 13px;
    color: var(--ink-3);
  }

  .pk {
    font-size: clamp(15px, 1.3vw, 23px);
    font-weight: 600;
    white-space: nowrap;
  }

  .pe {
    font-family: var(--mono);
    font-size: clamp(10px, 0.78vw, 13px);
    color: var(--ink-3);
  }

  .px {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line-2);
    font-size: clamp(13px, 1.05vw, 18px);
    line-height: 1.45;
    color: var(--accent-ink);
  }

  .pipe .spec-step {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .pipe .gate {
    border-color: var(--ok);
  }

  .pipe .gate .pk {
    color: var(--ok);
  }

  .pipe .done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .pipe .done .pe,
  .pipe .done .px {
    color: var(--bg);
    opacity: 0.85;
  }

  /* 打回：评审（第 4 格）和门禁（第 5 格）各伸下来一根，连回 AI 开发（第 2 格） */
  .retry {
    position: relative;
    height: 30px;
    margin: -6px calc(100% / 12 * 3 - 5px) 8px calc(100% / 12 * 3 - 5px);
    border: 2px dashed var(--accent);
    border-top: 0;
    border-radius: 0 0 var(--r) var(--r);
  }

  .retry::before {
    content: '▲';
    position: absolute;
    left: -7px;
    top: -10px;
    font-size: 10px;
    color: var(--accent);
  }

  .retry .tick {
    position: absolute;
    left: calc(200% / 3);
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--accent);
    opacity: 0.6;
  }

  .retry span {
    position: absolute;
    left: 33%;
    bottom: -0.8em;
    transform: translateX(-50%);
    padding: 0 10px;
    background: var(--bg);
    color: var(--accent-ink);
    font-size: clamp(13px, 1.1vw, 18px);
    font-weight: 600;
    white-space: nowrap;
  }

  /* 一个大需求 / 一堆需求：横着一条线 */
  .flow {
    display: flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
  }

  .req,
  .pile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(10px, 1vw, 18px) clamp(12px, 1.2vw, 20px);
    border-radius: var(--r);
    border: 2px solid var(--ink);
    background: var(--card);
  }

  .req em,
  .pile em,
  .projects em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(11px, 0.85vw, 14px);
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .req b {
    font-size: clamp(18px, 1.6vw, 30px);
    font-weight: 600;
    white-space: nowrap;
  }

  /* 一堆需求先框起来：虚线框表示「这是一堆」 */
  .pile {
    border-style: dashed;
  }

  .pile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pile .chip {
    font-size: clamp(13px, 1.05vw, 19px);
  }

  .slices p,
  .lh {
    margin: 0 0 6px;
    font-size: clamp(13px, 1.05vw, 18px);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .slices ol,
  .projects ol,
  .one ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }

  .slices ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .slices li,
  .projects ol li {
    width: clamp(14px, 1.3vw, 24px);
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--heat-2);
  }

  .loopbox {
    position: relative;
    padding: clamp(10px, 1vw, 16px);
    border-radius: var(--r);
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .lh {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .lh small {
    font-weight: 400;
    font-size: 0.85em;
    color: var(--ink-2);
  }

  .clock {
    font-size: 1.1em;
  }

  .one {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  .one span {
    font-size: clamp(14px, 1.2vw, 21px);
    font-weight: 600;
    white-space: nowrap;
  }

  .one li {
    width: clamp(12px, 1vw, 18px);
    height: clamp(12px, 1vw, 18px);
    border-radius: 3px;
    border: 1.5px solid var(--line-2);
    background: var(--card);
  }

  .one li.spec-step {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .one li.gate {
    border-color: var(--ok);
  }

  .one li.done {
    border-color: var(--ink);
    background: var(--ink);
  }

  .spin {
    position: absolute;
    right: -0.55em;
    bottom: -0.55em;
    display: grid;
    place-items: center;
    width: 1.5em;
