  }

  .frame:not([hidden]) .spin {
    animation: make-spin 2.4s linear infinite;
  }

  @keyframes make-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .who {
    margin: clamp(14px, 3vh, 36px) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px clamp(16px, 2vw, 36px);
    font-size: clamp(14px, 1.15vw, 20px);
    color: var(--ink-2);
  }

  .who b {
    font-weight: 500;
    font-size: 0.85em;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .who i {
    margin-right: 8px;
    font-style: normal;
    font-size: 1.35em;
    font-weight: 600;
    color: var(--ink);
  }

  .butler {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 9em;
    padding: 0.8em 1em;
    border-radius: var(--r);
    border: 2px solid var(--ink);
    background: var(--card);
  }

  .butler b {
    font-size: clamp(18px, 1.7vw, 30px);
    white-space: nowrap;
  }

  .butler span {
    font-size: clamp(12px, 1vw, 17px);
    color: var(--ink-2);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .projects > li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 10px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  /* Project A 就是上一步那一整套，描深一点 */
  .projects > li.vt-need {
    border-color: var(--ink);
  }

  .loopbox.small {
    padding: clamp(14px, 1.4vw, 24px) clamp(12px, 1.2vw, 20px);
  }

  .loopbox.small .lh {
    flex-direction: column;
    align-items: center;
    margin: 0;
    font-size: clamp(16px, 1.4vw, 24px);
  }

  /* 验证金字塔：倒着放，上宽下窄；右边一根箭头写「越往下越贵」 */
  .pyr {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 10px clamp(12px, 1.4vw, 24px);
  }

  .pyr ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .pyr li {
    width: calc(100% - var(--k) * 15%);
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2px 12px;
    padding: clamp(6px, 1.1vh, 12px) 12px;
    border-radius: var(--r-sm);
    text-align: center;
    background: var(--heat-1);
    color: var(--ink);
    transition: transform 0.25s var(--ease), box-shadow 0.25s;
  }

  .pyr li:nth-child(2) {
    background: var(--heat-2);
  }

  .pyr li:nth-child(3) {
    background: var(--heat-3);
  }

  .pyr li:nth-child(4) {
    background: var(--accent);
    color: var(--bg);
  }

  .pyr li:nth-child(5) {
    background: var(--heat-4);
    color: var(--bg);
  }

  .pyr li[data-on] {
    transform: scale(1.03);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .pyr li b {
    font-size: clamp(19px, 1.8vw, 34px);
    font-weight: 600;
  }

  /* 英文原名只留给读屏，投影上不显示 */
  .pyr li em {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .pyr li span {
    flex-basis: 100%;
    font-size: clamp(12px, 0.95vw, 16px);
    opacity: 0.85;
  }

  .cost {
    margin: 0;
    width: 2.4em;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: clamp(13px, 1vw, 17px);
    color: var(--accent-ink);
  }

  .cost::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 10px;
    left: 50%;
    width: 2px;
    background: linear-gradient(var(--line-2), var(--accent));
  }

  .cost::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: calc(50% - 6px);
    border: 6px solid transparent;
    border-top: 10px solid var(--accent);
    border-bottom: 0;
  }

  .cost span {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    line-height: 1.1;
    padding: 8px 4px;
    background: var(--bg);
    letter-spacing: 0.2em;
  }

  .cost i {
    font-style: normal;
  }

  /* 矮屏：每层只留名字，说明进读数行 */
  @media (max-height: 820px) and (min-width: 901px) {
    .pyr li span {
      display: none;
    }
  }

  /* 读数行：只在金字塔那一栏，居中贴在最下面一层下方 */
  .pyr .t-read {
    grid-column: 2;
    min-height: 2.9em;
    margin-top: 4px;
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
  }

  /* 左边那根往上：越往上越确定 */
  .cost.up::before {
    top: 10px;
    bottom: 0;
    background: linear-gradient(var(--accent), var(--line-2));
  }

  .cost.up::after {
    top: 0;
    bottom: auto;
    border-top: 0;
    border-bottom: 10px solid var(--accent);
  }

  /* View Transition：只在相邻两步之间命名，同名元素从上一步变形过来 */
  [data-vt-pair='3-4'] .vt-ticket {
    view-transition-name: mk-ticket;
  }

  [data-vt-pair='4-5'] .vt-need {
    view-transition-name: mk-need;
  }

  ::view-transition-group(mk-ticket),
  ::view-transition-group(mk-need) {
    animation-duration: 0.7s;
    animation-timing-function: var(--ease);
  }

  ::view-transition-old(mk-ticket),
  ::view-transition-new(mk-ticket) {
    height: 100%;
    object-fit: fill;
  }

  /* 整条流水线缩成一个 Project：保持比例，不压扁 */
  ::view-transition-old(mk-need),
  ::view-transition-new(mk-need) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .pipe {
      grid-template-columns: 1fr 1fr;
    }
    .board td.bd {
      white-space: normal;
    }
    .board tbody th {
      font-size: 13px;
    }
    .kit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pipe li + li::before,
    .retry .loop {
      display: none;
    }
    /* 手机上不画回路线，只留打回说明 */
    .retry {
      display: block;
    }
    .rig {
      flex-direction: column;
    }
    .swap ul {
      flex-direction: row;
      flex-wrap: wrap;
      padding: 0;
      border: 0;
    }
    .swap li::after {
      display: none;
    }
    .pyr li {
      width: 100%;
    }
    .flow {
      flex-direction: column;
      align-items: stretch;
    }
    .flow > .arr {
      transform: rotate(90deg);
      align-self: center;
    }
    .slices ol {
      display: flex;
    }
    .ring {
      width: 100%;
    }
    .parts button {
      font-size: 12px;
    }
    .mparts button {
      font-size: 10px;
    }
    .rk {
      font-size: 11px;
    }
    .rk b {
      font-size: 14px;
    }
    .mk {
      display: none;
    }
  }

  @media (max-height: 800px) and (min-width: 901px) {
    .ring {
      width: min(100%, 58vh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame .fin,
    .frame .spin {
      animation: none !important;
    }
  }
</style>

<script>
  // 地基图：悬停或点一个词，下面一行说它指什么
  document.querySelectorAll<HTMLElement>('[data-harness]').forEach((root) => {
    const out = root.querySelector<HTMLElement>('[data-tip-out]')!;
    const btns = [...root.querySelectorAll<HTMLButtonElement>('button[data-tip]')];
    let pinned: HTMLButtonElement | null = null;
    const show = (b: HTMLButtonElement | null) => {
      out.textContent = b ? `${b.textContent}：${b.dataset.tip}` : out.dataset.hint!;
      out.classList.toggle('on', !!b);
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    };
    btns.forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      b.addEventListener('mouseenter', () => show(b));
      b.addEventListener('mouseleave', () => show(pinned));
      b.addEventListener('focus', () => show(b));
      b.addEventListener('blur', () => show(pinned));
      b.addEventListener('click', () => {
        pinned = pinned === b ? null : b;
        show(pinned ?? b);
      });
    });

    // 左边的 AI：点一下拔掉（再点插回），下面一行说「仓库还在，其余照跑」
    root.querySelectorAll<HTMLButtonElement>('button[data-plug]').forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', () => {
        const off = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(off));
        out.textContent = off ? root.dataset.unplug!.replace('{x}', b.dataset.plug!) : out.dataset.hint!;
        out.classList.toggle('on', off);
      });
    });
  });

  // 模型能力：悬停、聚焦或点一行，下面一行写前三名
  document.querySelectorAll<HTMLElement>('[data-rows]').forEach((root) => {
    const out = root.querySelector<HTMLElement>('[data-row-out]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('tr[data-row]')];
    let pinned: HTMLElement | null = null;
    const show = (r: HTMLElement | null) => {
      out.textContent = r ? r.dataset.row! : out.dataset.hint!;
      out.classList.toggle('on', !!r);
      rows.forEach((x) => x.setAttribute('aria-selected', String(x === r)));
    };
    rows.forEach((r) => {
      r.addEventListener('mouseenter', () => show(r));
      r.addEventListener('mouseleave', () => show(pinned));
      r.addEventListener('focus', () => show(r));
      r.addEventListener('blur', () => show(pinned));
      r.addEventListener('click', () => {
        pinned = pinned === r ? null : r;
        show(pinned ?? r);
      });
    });
  });
</script>
