---
/**
 * 演讲 03「怎么做出来」：工具准备 → 地基 Harness → 一张单 → 一个大需求（切片 + Loop）→ 一堆需求（分诊）→ 推荐流程。
 * 顶上是步骤 tab，← → 下一步；左边一张图，右边只放一个问题、一句大白话、一个例子，依据点开才看（渐进披露）。
 */
import { talk } from '../../i18n/talk';

const m = talk.make;
const L = m.levels;
---

<section class="slide t-slide make" data-slide data-notes={m.notes} aria-labelledby="make-title">
  <header class="t-head">
    <p class="kicker">{m.no} · {m.kicker}</p>
    <h2 id="make-title">{m.title}</h2>
    <p class="lead">{m.lead}</p>
  </header>

  <div class="body t-body" data-stepper>
    <ol class="line" role="tablist" aria-label={m.title}>
      {
        L.map((l, i) => (
          <li>
            <button type="button" role="tab" data-step aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true">{i + 1}</i>
              <span>{l.k}</span>
              <em>{l.tag}</em>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="main">
      <div class="stage">
        <!-- 1 工具准备 -->
        <div class="frame" data-pane="0">
          <div class="tools">
            {
              m.tools.map((t, i) => (
                <div class="bc fin" style={`--d:${i}`}>
                  <p class="bk">{t.k}</p>
                  <p class="tags">
                    {t.v.map((v) => (
                      <span>{v}</span>
                    ))}
                  </p>
                </div>
              ))
            }
          </div>
          <p class="links fin" style="--d:4">
            <b>{m.models.k}</b>
            {
              m.models.links.map((x) => (
                <a href={x.href} target="_blank" rel="noopener">
                  {x.k} ↗
                </a>
              ))
            }
          </p>
        </div>

        <!-- 2 地基 Harness -->
        <div class="frame" data-pane="1" hidden>
          <div class="harness">
            <div class="ring fin" style="--d:0">
              <p class="rk"><b>{m.harness.ring}</b>{m.harness.ringV}</p>
              <ul class="parts">
                {m.harness.parts.map((p, i) => (
                  <li class={`p${i}`}>{p}</li>
                ))}
              </ul>
              <div class="core fin" style="--d:2">
                <b class="serif">{m.harness.model}</b>
                <span>{m.harness.modelV}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3 一张单：上面专业说法，下面同一个过程的真实例子 -->
        <div class="frame" data-pane="2" hidden>
          <p class="exk fin">{m.exK}</p>
          <ol class="pipe">
            {
              m.ticket.map((t, i) => (
                <li class={`fin ${i === 0 ? 'spec-step' : ''} ${i === 3 || i === 4 ? 'gate' : ''} ${i === 5 ? 'done' : ''}`} style={`--d:${i}`}>
                  <span class="pk">{t.k}</span>
                  <span class="pe">{t.en}</span>
                  <span class="px">{t.ex}</span>
                </li>
              ))
            }
          </ol>
          <div class="retry fin" style="--d:6" aria-label={m.retry}>
            <i class="tick" aria-hidden="true" />
            <span>↻ {m.retry}</span>
          </div>
        </div>

        <!-- 4 一个大需求：切片 + Loop -->
        <div class="frame" data-pane="3" hidden>
          <div class="need">
            <div class="col fin" style="--d:0">
              <span class="chip">{m.need.req}</span>
              <span class="arr">↓</span>
              <span class="chip hot">{m.need.ana}</span>
              <span class="arr">↓</span>
              <span class="chip">{m.need.slice}</span>
            </div>
            <span class="arr side fin" style="--d:1">→</span>
            <ol class="lanes">
              {
                m.need.lanes.map((l, i) => (
                  <li class="fin" style={`--d:${i + 2}`}>
                    <span class="ln">{l}</span>
                    <span class="loop">{m.need.loop}</span>
                    <span class="blk">{L[2].k}</span>
                    <span class="spin" aria-hidden="true">↻</span>
                  </li>
                ))
              }
            </ol>
            <span class="arr side fin" style="--d:6">→</span>
            <span class="chip done fin" style="--d:7">{m.need.done}</span>
          </div>
        </div>

        <!-- 5 一堆需求：分诊 -->
        <div class="frame" data-pane="4" hidden>
          <div class="team">
            <ul class="src fin" style="--d:0">
              {m.triage.sources.map((s) => <li class="chip">{s}</li>)}
            </ul>
            <span class="arr side fin" style="--d:1">→</span>
            <div class="butler fin" style="--d:2">
              <b>{m.triage.butler}</b>
              <ol>
                {m.triage.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
            </div>
            <span class="arr side fin" style="--d:3">→</span>
            <div class="queue fin" style="--d:4">
              <p>{m.triage.queue}</p>
              <ol>
                {[1, 2, 3, 4, 5, 6].map((n) => (
                  <li>{n}</li>
                ))}
              </ol>
            </div>
            <span class="arr side fin" style="--d:5">→</span>
            <div class="workers fin" style="--d:6">
              <p>{m.triage.workersK}</p>
              {m.triage.workers.map((w) => (
                <span class="chip">{w}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- 6 推荐流程 -->
        <div class="frame" data-pane="5" hidden>
          <ol class="flow">
            {
              m.flow.map((f, i) => (
                <li class={`fin ${f.me ? 'me' : ''} ${f.loop ? 'again' : ''}`} style={`--d:${i}`}>
                  {f.me && <em>{m.meK}</em>}
                  <b class="serif">{f.k}</b>
                  {f.v.map((v) => (
                    <span>{v}</span>
                  ))}
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <aside class="side" aria-live="polite">
        {
          L.map((l, i) => (
            <div class="sp" data-pane={String(i)} hidden={i !== 0}>
              <p class="lk">
                {l.k} · <span>{l.tag}</span>
              </p>
              <h3 class="serif">{l.q}</h3>
              <p class="plain">{l.plain}</p>
              <p class="case">
                <b>{m.caseK}</b>
                {l.case}
              </p>
              {l.src && (
                <details class="src">
                  <summary>{m.srcK}</summary>
                  {l.src}
                </details>
              )}
            </div>
          ))
        }
        <p class="t-hint">{m.hint}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2.4vh, 28px);
  }

  /* 顶部步骤 */
  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    position: relative;
  }

  .line::before {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    height: 2px;
    background: var(--line-2);
  }

  .line button {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 0;
    font: inherit;
    color: var(--ink-3);
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
  }

  .line i {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-style: normal;
    font-family: var(--mono);
    font-size: 13px;
    background: var(--bg);
    border: 2px solid var(--line-2);
    transition: background 0.3s, border-color 0.3s, color 0.3s, transform 0.3s;
  }

  .line span {
    font-size: clamp(15px, 1.3vw, 23px);
    font-weight: 600;
  }

  .line em {
    font-style: normal;
    font-family: var(--mono);
    font-size: clamp(11px, 0.8vw, 14px);
    color: var(--ink-3);
  }

  .line button.seen {
    color: var(--ink-2);
  }

  .line button.seen i {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .line button[aria-selected='true'] {
    color: var(--ink);
  }

  .line button[aria-selected='true'] em {
    color: var(--accent-ink);
  }

  .line button[aria-selected='true'] i {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    transform: scale(1.15);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .main {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(280px, 1fr);
    gap: clamp(24px, 3.4vw, 64px);
    align-items: center;
  }

  .frame {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 22px);
  }

  .frame[hidden],
  .sp[hidden] {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em 0.9em;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--line-2);
    background: var(--card);
    font-size: clamp(14px, 1.3vw, 24px);
    white-space: nowrap;
  }

  .chip.hot {
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .chip.done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .arr {
    color: var(--ink-3);
    font-size: clamp(14px, 1.2vw, 20px);
  }

  /* 工具准备 */
  .tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.4vw, 22px);
  }

  .bc {
    padding: clamp(16px, 2vw, 34px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
  }

  .bc p {
    margin: 0;
  }

  .bk {
    font-size: clamp(14px, 1.1vw, 19px);
    color: var(--ink-3);
    margin-bottom: 10px !important;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
  }

  .tags span {
    font-family: var(--serif);
    font-size: clamp(22px, 2.2vw, 40px);
    font-weight: 600;
  }


  .links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    font-size: 14px;
  }

  .links b {
    font-weight: 500;
    color: var(--ink-3);
  }

  .links a {
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }

  .links a:hover {
    color: var(--accent-ink);
  }

  /* 地基：模型在中间，Harness 是一圈 */
  .harness {
    display: grid;
    place-items: center;
  }

  .ring {
    position: relative;
    width: min(100%, 62vh);
    aspect-ratio: 1.35;
    border-radius: 50%;
    border: 3px dashed var(--accent);
    background: var(--accent-soft);
    display: grid;
    place-items: center;
  }

  .rk {
    position: absolute;
    top: 7%;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--accent-ink);
    font-size: clamp(13px, 1.1vw, 19px);
    white-space: nowrap;
  }

  .rk b {
    font-family: var(--mono);
    font-size: clamp(18px, 1.7vw, 30px);
  }

  .parts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .parts li {
    position: absolute;
    padding: 0.35em 0.8em;
    border-radius: var(--r-pill);
    background: var(--card);
    border: 1.5px solid var(--accent);
    font-size: clamp(14px, 1.3vw, 24px);
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .p0 { left: 14%; top: 42%; }
  .p1 { left: 86%; top: 42%; }
  .p2 { left: 24%; top: 80%; }
  .p3 { left: 76%; top: 80%; }

  .core {
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    box-shadow: var(--shadow);
  }

  .core b {
    font-size: clamp(22px, 2.4vw, 44px);
  }

  .core span {
    font-size: clamp(12px, 1vw, 17px);
    opacity: 0.8;
  }

  /* 一张单：每一步下面直接是例子 */
  .exk {
    margin: 0;
    font-size: clamp(13px, 1.05vw, 17px);
    color: var(--ink-3);
  }

  .pipe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .pipe li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 12px 14px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  .pipe li + li::before {
    content: '→';
    position: absolute;
    left: -5px;
    top: 16px;
    transform: translateX(-50%);
    font-size: 13px;
    color: var(--ink-3);
  }

  .pk {
    font-size: clamp(15px, 1.3vw, 23px);
    font-weight: 600;
    white-space: nowrap;
  }

  .pe {
    font-family: var(--mono);
    font-size: clamp(10px, 0.78vw, 13px);
    color: var(--ink-3);
  }

  .px {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line-2);
    font-size: clamp(13px, 1.05vw, 18px);
    line-height: 1.45;
    color: var(--accent-ink);
  }

  .pipe .spec-step {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .pipe .gate {
    border-color: var(--ok);
  }

  .pipe .gate .pk {
    color: var(--ok);
  }

  .pipe .done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .pipe .done .pe,
  .pipe .done .px {
    color: var(--bg);
    opacity: 0.85;
  }

  /* 打回：评审（第 4 格）和门禁（第 5 格）各伸下来一根，连回 AI 开发（第 2 格） */
  .retry {
    position: relative;
    height: 30px;
    margin: -6px calc(100% / 12 * 3 - 5px) 8px calc(100% / 12 * 3 - 5px);
    border: 2px dashed var(--accent);
    border-top: 0;
    border-radius: 0 0 var(--r) var(--r);
  }

  .retry::before {
    content: '▲';
    position: absolute;
    left: -7px;
    top: -10px;
    font-size: 10px;
    color: var(--accent);
  }

  .retry .tick {
    position: absolute;
    left: calc(200% / 3);
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--accent);
    opacity: 0.6;
  }

  .retry span {
    position: absolute;
    left: 33%;
    bottom: -0.8em;
    transform: translateX(-50%);
    padding: 0 10px;
    background: var(--bg);
    color: var(--accent-ink);
    font-size: clamp(13px, 1.1vw, 18px);
    font-weight: 600;
    white-space: nowrap;
  }

  /* 一个大需求 */
  .need,
  .team {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 16px);
  }

  .col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lanes li {
    display: grid;
    grid-template-columns: 3.5em auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: var(--r-sm);
    background: var(--bg-2);
  }

  .ln {
    font-size: clamp(14px, 1.2vw, 21px);
    font-weight: 600;
  }

  .loop {
    font-size: clamp(12px, 0.95vw, 16px);
    color: var(--accent-ink);
    white-space: nowrap;
  }

  .blk {
    padding: 0.4em 0.8em;
    border-radius: var(--r-sm);
    background: var(--heat-2);
    font-size: clamp(14px, 1.2vw, 21px);
    text-align: center;
  }

  .spin {
    font-size: clamp(18px, 1.6vw, 28px);
    color: var(--accent);
  }

  .frame:not([hidden]) .spin {
    animation: make-spin 2.4s linear infinite;
  }

  @keyframes make-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 一堆需求 */
  .src {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .butler {
    padding: 0.8em 1em;
    border-radius: var(--r);
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .butler b {
    display: block;
    font-size: clamp(18px, 1.7vw, 30px);
    color: var(--accent-ink);
    white-space: nowrap;
  }

  .butler ol {
    margin: 6px 0 0;
    padding-left: 1.2em;
    font-size: clamp(13px, 1.1vw, 19px);
    color: var(--ink-2);
  }

  .queue p,
  .workers p {
    margin: 0 0 6px;
    font-size: 13px;
    color: var(--ink-3);
    text-align: center;
  }

  .queue ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .queue li {
    width: clamp(44px, 4vw, 70px);
    padding: 3px 0;
    border-radius: 4px;
    background: var(--heat-2);
    font-family: var(--mono);
    font-size: 12px;
    text-align: center;
  }

  .workers {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* 推荐流程 */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 14px;
    align-items: stretch;
  }

  .flow li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(14px, 1.4vw, 24px);
    border: 1.5px solid var(--line-2);
    border-radius: var(--r);
    background: var(--card);
  }

  .flow li + li::before {
    content: '→';
    position: absolute;
    left: -7px;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--ink-3);
  }

  .flow b {
    font-size: clamp(17px, 1.55vw, 28px);
    white-space: nowrap;
    font-weight: 600;
  }

  .flow span {
    font-size: clamp(13px, 1.05vw, 18px);
    color: var(--ink-2);
  }

  .flow .me {
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .flow .me b {
    font-size: clamp(24px, 2.3vw, 42px);
    color: var(--accent-ink);
  }

  .flow .me span {
    color: var(--ink);
    font-size: clamp(14px, 1.2vw, 21px);
  }

  .flow em {
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
  }

  .flow .again {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .flow .again span {
    color: var(--bg);
    opacity: 0.8;
  }

  .flow .again b::before {
    content: '↻ ';
  }

  /* 右边：一个问题、一句大白话、一个例子 */
  .side {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sp p {
    margin: 0;
  }

  .lk {
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .lk span {
    font-family: var(--mono);
    color: var(--accent-ink);
  }

  .sp h3 {
    margin: 4px 0 14px;
    font-size: clamp(28px, 2.6vw, 46px);
    font-weight: 600;
    line-height: 1.15;
  }

  .plain {
    margin: 0 0 16px !important;
    font-size: clamp(17px, 1.5vw, 26px);
    line-height: 1.5;
  }

  .case {
    padding-left: 12px;
    border-left: 3px solid var(--accent);
    font-size: clamp(14px, 1.15vw, 19px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .case b {
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  details.src {
    margin-top: 12px;
