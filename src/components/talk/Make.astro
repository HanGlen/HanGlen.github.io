  .pile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pile .chip {
    font-size: clamp(13px, 1.05vw, 19px);
  }

  .slices p,
  .lh {
    margin: 0 0 6px;
    font-size: clamp(13px, 1.05vw, 18px);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .slices ol,
  .projects ol,
  .one ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }

  .slices ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .slices li,
  .projects ol li {
    width: clamp(14px, 1.3vw, 24px);
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--heat-2);
  }

  .loopbox {
    position: relative;
    padding: clamp(10px, 1vw, 16px);
    border-radius: var(--r);
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .lh {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .lh small {
    font-weight: 400;
    font-size: 0.85em;
    color: var(--ink-2);
  }

  .clock {
    font-size: 1.1em;
  }

  .one {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--card);
  }

  .one span {
    font-size: clamp(14px, 1.2vw, 21px);
    font-weight: 600;
    white-space: nowrap;
  }

  .one li {
    width: clamp(12px, 1vw, 18px);
    height: clamp(12px, 1vw, 18px);
