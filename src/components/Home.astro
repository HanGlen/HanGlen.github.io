---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Dnd from './Dnd.astro';
import Signal from './Signal.astro';
import About from './About.astro';
import type { Content } from '../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<Base
  lang={t.lang}
  title={t.meta.title}
  description={t.meta.description}
  altHref={t.nav.switchHref}
  altLang={t.nav.switchHref === '/' ? 'zh-CN' : 'en'}
>
  <Nav t={t} />
  <main>
    <Hero t={t} />
    <Dnd t={t} />
    <Signal t={t} />
    <About t={t} />
  </main>
</Base>
