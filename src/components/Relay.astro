---
/**
 * 可点击的接力图：上面一排是每一棒，点开看那一棒留下的真实记录
 * （Issue 原文、评论、代码改动、检查结果、发版公告）。
 */
export interface Detail {
  kind: 'issue' | 'comment' | 'diff' | 'checks' | 'note';
  head: string;
  ref?: string;
  href?: string;
  lines?: string[];
  diff?: { file: string; rows: [string, string][] }[];
  checks?: [string, string, string][];
  aside?: string;
}

export interface Leg {
  t: string;
  who: string;
  role: 'ai' | 'gate' | 'me';
  v: string;
  d: string;
  detail: Detail;
}

interface Props {
  legs: Leg[];
  hint: string;
  id: string;
}

const { legs, hint, id } = Astro.props;
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
---

<div class="relay" data-relay>
  <div class="track" role="tablist" aria-label={hint}>
    {
      legs.map((l, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class={`leg ${l.role}`}
        >
          {l.d && <span class="gap">{l.d}</span>}
          <span class="node" aria-hidden="true" />
          <time>{l.t}</time>
          <strong>{l.who}</strong>
          <span class="v">{l.v}</span>
        </button>
      ))
    }
  </div>
  <p class="hint">{hint}</p>

  {
    legs.map((l, i) => (
      <article class="panel" role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} hidden={i !== 0}>
        <header>
          <span class="who">{l.detail.head}</span>
          {l.detail.ref &&
            (l.detail.href ? (
              <a class="ref" href={l.detail.href} target="_blank" rel="noopener">
                {l.detail.ref}
              </a>
            ) : (
              <span class="ref">{l.detail.ref}</span>
            ))}
        </header>
        <div class={`body k-${l.detail.kind}`}>
          {l.detail.lines?.map((line) => <p>{line}</p>)}
          {l.detail.diff?.map((f) => (
            <div class="file">
              <div class="fname">{f.file}</div>
              <pre set:html={f.rows.map(([sign, code]) => `<span class="${sign === '+' ? 'add' : sign === '-' ? 'del' : 'ctx'}">${sign} ${esc(code)}</span>`).join('')} />
            </div>
          ))}
          {l.detail.checks && (
            <ul class="checks">
              {l.detail.checks.map(([name, state, dur]) => (
                <li>
                  <span class={`st ${state}`}>{state === 'ok' ? '✓' : '–'}</span>
                  <span class="cn">{name}</span>
                  <span class="cd">{dur}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
        {l.detail.aside && <p class="aside">{l.detail.aside}</p>}
      </article>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-relay]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const p = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
        if (p) p.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + tabs.length) % tabs.length;
        select(n);
        tabs[n].focus();
      });
    });
  });
</script>

<style>
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    position: relative;
  }

  .track::before {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    top: 37px;
    height: 2px;
    background: var(--line-2);
  }

  .leg {
    appearance: none;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    border-radius: 12px;
    padding: 0 10px 14px 0;
    position: relative;
    display: grid;
    align-content: start;
    gap: 2px;
    cursor: pointer;
  }

  .gap {
    position: absolute;
    top: 0;
    left: -50%;
    width: 100%;
    display: flex;
    justify-content: center;
    font-family: var(--mono);
    font-size: 11px;
    white-space: nowrap;
    color: var(--ink-3);
    pointer-events: none;
  }

  .node {
    margin-top: 30px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink-3);
    position: relative;
    z-index: 1;
    transition: transform 0.2s, background 0.2s, border-color 0.2s;
  }

  .ai .node {
    border-color: var(--accent);
  }

  .me .node {
    border-color: var(--ink);
  }

  .leg:hover .node {
    transform: scale(1.2);
  }

  .leg[aria-selected='true'] .node {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  .me[aria-selected='true'] .node {
    background: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 0 0 5px var(--line);
  }

  time {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink-3);
  }

  strong {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    transition: color 0.2s;
  }

  .leg[aria-selected='true'] strong {
    color: var(--accent-ink);
  }

  .v {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
    transition: color 0.2s;
  }

  .leg[aria-selected='true'] .v,
  .leg:hover .v {
    color: var(--ink-2);
  }

  .hint {
    margin: 4px 0 14px;
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow);
    overflow: hidden;
    animation: fade 0.25s ease;
  }

  .panel[hidden] {
    display: none;
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .panel header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
    font-size: 13px;
  }

  .who {
    font-weight: 600;
  }

  .ref {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  a.ref:hover {
    color: var(--accent-ink);
  }

  .body {
    padding: 16px 18px 6px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }

  .body p {
    margin: 0 0 10px;
  }

  .k-issue p:first-child {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
  }

  .file {
    margin-bottom: 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  .fname {
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-3);
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }

  pre {
    margin: 0;
    padding: 8px 0;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
    overflow-x: auto;
    white-space: pre;
  }

  pre :global(span) {
    display: block;
    padding: 0 12px;
  }

  pre :global(.add) {
    background: rgba(63, 155, 98, 0.12);
    color: var(--ink);
  }

  pre :global(.del) {
    background: rgba(200, 70, 50, 0.1);
    color: var(--ink-2);
  }

  .checks {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 13.5px;
  }

  .st {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 11px;
    color: #fff;
    background: #3f9b62;
  }

  .st.skip {
    background: var(--ink-3);
  }

  .cn {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink);
  }

  .cd {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .aside {
    margin: 0;
    padding: 12px 18px 16px;
    font-size: 13.5px;
    color: var(--accent-ink);
    border-top: 1px dashed var(--line);
  }

  @media (max-width: 860px) {
    .track {
      grid-auto-columns: 132px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .track::-webkit-scrollbar {
      display: none;
    }
    .leg {
      scroll-snap-align: start;
    }
    .track::before {
      right: auto;
      width: calc(132px * 7);
    }
  }
</style>
