---
/** 左侧标题、右侧内容的分栏。左栏在宽屏上吸顶。 */
interface Props {
  no?: string;
  title: string;
  lead?: string;
  id?: string;
  wide?: boolean;
}

const { no, title, lead, id, wide = false } = Astro.props;
---

<section class={`wrap rail ${wide ? 'wide' : ''}`} id={id}>
  <header class="rail-head">
    <div class="sticky">
      {no && <span class="no">{no}</span>}
      <h2 class="h-section">{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </header>
  <div class="rail-body">
    <slot />
  </div>
</section>

<style>
  .rail {
    margin-top: var(--gap);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(24px, 4vw, 64px);
    padding-top: 28px;
    position: relative;
  }

  .rail::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--line);
  }

  .sticky {
    position: sticky;
    top: 92px;
  }

  .no {
    display: block;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent-ink);
  }

  .lead {
    margin: 14px 0 0;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }

  .rail-body {
    min-width: 0;
  }

  .wide {
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
  }

  @media (max-width: 860px) {
    .rail,
    .wide {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .sticky {
      position: static;
    }
  }
</style>
