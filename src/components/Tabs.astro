---
/** 分页：每页内容用具名插槽 p0、p1… 传入。方向键切换，Home/End 跳到首尾。 */
interface Props {
  tabs: string[];
  id: string;
}

const { tabs, id } = Astro.props;
const panels = await Promise.all(tabs.map((_, i) => Astro.slots.render(`p${i}`)));
---

<div class="tabs" data-tabs>
  <div class="tablist" role="tablist">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {t}
        </button>
      ))
    }
  </div>
  {
    panels.map((html, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`${id}-panel-${i}`}
        aria-labelledby={`${id}-tab-${i}`}
        tabindex="0"
        hidden={i !== 0}
        set:html={html}
      />
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const k = { ArrowRight: i + 1, ArrowLeft: i - 1 + n, Home: 0, End: n - 1 }[e.key];
        if (k === undefined) return;
        e.preventDefault();
        select(k % n, true);
      });
    });
  });
</script>

<style>
  .tablist {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--bg-2);
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  [role='tab'] {
    flex-shrink: 0;
    padding: 7px 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 14px;
    color: var(--ink-2);
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  [role='tab']:hover {
    color: var(--ink);
  }

  [role='tab'][aria-selected='true'] {
    color: var(--ink);
    background: var(--card);
    box-shadow: 0 1px 2px var(--line-2);
  }

  .panel {
    margin-top: 16px;
  }

  .panel:focus-visible {
    outline-offset: 6px;
  }
</style>
