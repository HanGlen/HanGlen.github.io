---
import type { Content } from '../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const s = t.signal;
const m = t.media;
---

<section class="section">
  <div class="wrap">
    <article class="card sig reveal">
      <header class="sig-head">
        <div>
          <p class="tag">{s.tag}</p>
          <h3>{s.name}</h3>
          <p class="sub">{s.sub}</p>
        </div>
        <p class="summary">{s.summary}</p>
      </header>

      <ol class="arch" aria-label="architecture">
        {
          s.layers.map((l, i) => (
            <li>
              <span class="layer-no">L{i + 1}</span>
              <h4>{l.title}</h4>
              <ul>
                {l.items.map((it) => <li>{it}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>

      <div class="modules">
        {
          s.modules.map((mod) => (
            <div class="module">
              <div class="module-top">
                <h4>{mod.name}</h4>
                {mod.badge && <span class="badge">{mod.badge}</span>}
              </div>
              <p>{mod.desc}</p>
              <p class="mono">{mod.stack}</p>
            </div>
          ))
        }
      </div>

      <footer class="sig-foot">
        <ul class="results">
          {s.results.map((r) => <li>{r}</li>)}
        </ul>
        <ul class="chips">
          {s.stack.map((x) => <li class="chip">{x}</li>)}
        </ul>
      </footer>
    </article>

    <article class="card media reveal">
      <div>
        <p class="tag">{m.tag}</p>
        <h3>{m.name}</h3>
        <p class="sub">{m.sub}</p>
      </div>
      <div>
        <p class="summary">{m.summary}</p>
        <ul class="points">
          {m.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .tag {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--warm);
    letter-spacing: 0.06em;
  }

  h3 {
    margin: 14px 0 0;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 650;
  }

  h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .sub {
    margin: 8px 0 0;
    color: var(--text-3);
    font-size: 14px;
  }

  .summary {
    margin: 0;
    color: var(--text-2);
  }

  .sig {
    padding: clamp(28px, 4vw, 52px);
  }

  .sig-head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
  }

  /* 架构图 */
  .arch {
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    counter-reset: layer;
  }

  .arch > li {
    position: relative;
    padding: 18px 16px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }

  .arch > li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -12px;
    width: 12px;
    height: 1px;
    background: var(--accent);
    opacity: 0.6;
  }

  .arch > li:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(50% - 3px);
    right: -3px;
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
    transform: rotate(45deg);
    opacity: 0.8;
    z-index: 1;
  }

  .layer-no {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }

  .arch h4 {
    margin-top: 6px;
  }

  .arch ul {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .arch ul li {
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.5;
  }

  /* 子项目 */
  .modules {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .module {
    padding: 22px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.015);
  }

  .module-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 6px;
    color: var(--ok);
    background: rgba(111, 214, 168, 0.1);
    border: 1px solid rgba(111, 214, 168, 0.25);
    white-space: nowrap;
  }

  .module p {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.65;
  }

  .module .mono {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }

  .sig-foot {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .results,
  .points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .results li,
  .points li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
  }

  .results li::before,
  .points li::before {
    content: '◆';
    position: absolute;
    left: 0;
    top: 0.1em;
    font-size: 9px;
    color: var(--warm);
  }

  .media {
    margin-top: 16px;
    padding: clamp(28px, 4vw, 44px) clamp(28px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(20px, 4vw, 56px);
  }

  .media .points {
    margin-top: 20px;
  }

  @media (max-width: 960px) {
    .arch {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .arch > li:not(:last-child)::after {
      top: auto;
      bottom: -14px;
      right: auto;
      left: 28px;
      width: 1px;
      height: 14px;
    }
    .arch > li:not(:last-child)::before {
      top: auto;
      right: auto;
      bottom: -4px;
      left: 25px;
      transform: rotate(135deg);
    }
    .arch ul {
      grid-auto-flow: row;
    }
  }

  @media (max-width: 760px) {
    .sig-head,
    .media,
    .sig-foot,
    .modules {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
