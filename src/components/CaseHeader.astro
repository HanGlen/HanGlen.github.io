---
import { rich } from '../lib/rich';

interface Props {
  kind: string;
  name: string;
  line: string;
  stats: { v: string; k: string; src?: string }[];
  back: string;
  backHref: string;
}

const { kind, name, line, stats, back, backHref } = Astro.props;
---

<header class="wrap ch">
  <a class="back" href={backHref}>{back}</a>
  <p class="eyebrow">{kind}</p>
  <h1 class="h-display">{name}</h1>
  <p class="line" set:html={rich(line)} />
  {
    stats.length > 0 && (
      <dl class="stats">
        {stats.map((s) =>
          s.src ? (
            <div class="sourced" tabindex="0">
              <dd class="serif">{s.v}</dd>
              <dt>{s.k}</dt>
              <dd class="src" role="note">{s.src}</dd>
            </div>
          ) : (
            <div>
              <dd class="serif">{s.v}</dd>
              <dt>{s.k}</dt>
            </div>
          ),
        )}
      </dl>
    )
  }
</header>

<style>
  .ch {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .back:hover {
    color: var(--accent-ink);
  }

  h1 {
    margin-top: 14px;
  }

  .line {
    margin: 18px 0 0;
    max-width: 30em;
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .stats {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
  }

  .stats div {
    padding: 16px 16px 0 0;
  }

  dd:not(.src) {
    margin: 0;
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 600;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  dt {
    font-size: 13px;
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 8px;
    }
  }
</style>
