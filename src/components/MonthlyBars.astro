---
import data from '../data/dnd.json';
import { prTypes } from '../lib/prtype';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const zh = lang === 'zh';
const L = prTypes[lang];
const types = data.monthlyTypes as Record<string, { feat: number; fix: number }>;
const months = Object.entries(data.monthlyPRs as Record<string, number>).map(([k, n]) => {
  const { feat = 0, fix = 0 } = types[k] ?? {};
  return { k, n, feat, fix, other: n - feat - fix };
});
const max = Math.max(...months.map((m) => m.n));
const label = (k: string) => (zh ? `${Number(k.slice(5))}月` : ['Jun', 'Jul', 'Aug', 'Sep', 'Oct'][Number(k.slice(5)) - 6] ?? k);
const other = zh ? '其他' : 'Other';
const tip = (m: (typeof months)[number]) =>
  zh
    ? `${label(m.k)}合入 ${m.n} 个：${L.feat} ${m.feat} · ${L.fix} ${m.fix} · ${other} ${m.other}`
    : `${label(m.k)}: ${m.n} merged · ${m.feat} features · ${m.fix} fixes · ${m.other} other`;
const initial = zh ? '鼠标移到柱子上，看每个月新功能和修复各占多少' : 'Hover a bar to split features from fixes';
---

<figure class="mb" data-mb>
  <ol class="bars" aria-label={zh ? '每月合入的 PR 数' : 'Merged PRs per month'}>
    {
      months.map((m, i) => (
        <li style={`--h:${(m.n / max) * 100}%`} class={i === months.length - 1 ? 'last' : ''}>
          <span class="val" aria-hidden="true">{m.n}</span>
          <button type="button" class="bar" data-tip={tip(m)} aria-label={tip(m)}>
            <span class="seg other" style={`flex-grow:${m.other}`} />
            <span class="seg fix" style={`flex-grow:${m.fix}`} />
            <span class="seg feat" style={`flex-grow:${m.feat}`} />
          </button>
          <span class="m" aria-hidden="true">{label(m.k)}</span>
        </li>
      ))
    }
  </ol>
  <figcaption>
    <span class="readout" aria-live="polite">{initial}</span>
    <span class="legend" aria-hidden="true">
      <i class="feat"></i>{L.feat}
      <i class="fix"></i>{L.fix}
      <i class="other"></i>{other}
    </span>
    <span class="fine">{zh ? '按提交标题的 feat / fix 前缀分类；10 月统计到 29 日' : 'Split by the feat / fix prefix in each title; October counted through the 29th'}</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-mb]').forEach((fig) => {
    const readout = fig.querySelector<HTMLElement>('.readout')!;
    const initial = readout.textContent;
    fig.querySelectorAll<HTMLButtonElement>('.bar').forEach((b) => {
      const show = () => (readout.textContent = b.dataset.tip ?? '');
      const hide = () => (readout.textContent = initial);
      b.addEventListener('mouseenter', show);
      b.addEventListener('focus', show);
      b.addEventListener('click', show);
      b.addEventListener('mouseleave', () => document.activeElement !== b && hide());
      b.addEventListener('blur', hide);
    });
  });
</script>

<style>
  .mb {
    margin: 0;
    padding-top: 34px;
  }

  .bars {
    margin: 0;
    padding: 0;
    list-style: none;
    height: 240px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: clamp(10px, 3vw, 28px);
    align-items: end;
    border-bottom: 1px solid var(--line-2);
  }

  li {
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: end;
    position: relative;
  }

  .bar {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: var(--h);
    min-height: 3px;
    padding: 0;
    border: 0;
    border-radius: 6px 6px 0 0;
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .bar:hover,
  .bar:focus-visible {
    transform: translateY(-3px);
  }

  .seg {
    display: block;
    min-height: 0;
    flex-basis: 0;
  }

  .feat {
    background: var(--accent);
  }

  .fix {
    background: var(--heat-2);
  }

  .other {
    background: var(--heat-1);
  }

  .val {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--h) + 6px);
    text-align: center;
    font-family: var(--serif);
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .m {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -26px;
    text-align: center;
    font-size: 13px;
    color: var(--ink-3);
  }

  figcaption {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--ink-3);
  }

  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }

  .legend i:not(:first-child) {
    margin-left: 8px;
  }

  .fine {
    flex-basis: 100%;
    font-size: 12px;
    color: var(--ink-3);
  }
</style>
