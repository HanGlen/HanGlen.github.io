---
import type { Content } from '../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="kicker reveal">{t.hero.eyebrow}</p>
      <h1 class="reveal">
        <span>{t.hero.title[0]}</span>
        <span class="gradient-text">{t.hero.title[1]}</span>
      </h1>
      <p class="lead reveal">{t.hero.lead}</p>
      <div class="cta reveal">
        <a class="btn primary" href="#pipeline">{t.hero.ctaPrimary} <span aria-hidden="true">→</span></a>
        <a class="btn" href="#contact">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <figure class="term card reveal" aria-label={t.terminal.title}>
      <div class="term-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="term-title">{t.terminal.title}</span>
      </div>
      <ol class="term-body">
        {
          t.terminal.lines.map(([tag, text], i) => (
            <li style={`--i:${i}`}>
              <span class={`tag tag-${i === t.terminal.lines.length - 1 ? 'ok' : i === 5 ? 'gate' : 'run'}`}>{tag}</span>
              <span class="text">{text}</span>
            </li>
          ))
        }
        <li class="cursor" style={`--i:${t.terminal.lines.length}`} aria-hidden="true"><span>▍</span></li>
      </ol>
      <figcaption>{t.terminal.footer}</figcaption>
    </figure>
  </div>

  <div class="wrap">
    <dl class="stats">
      {
        t.stats.map((s, i) => (
          <div class="stat reveal" style={`transition-delay:${i * 80}ms`}>
            <dt>{s.label}</dt>
            <dd>
              <span class="num">{s.value}</span>
              <span class="note">{s.note}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: clamp(56px, 9vw, 120px) 0 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  h1 {
    margin: 22px 0 0;
    font-size: clamp(38px, 6.2vw, 76px);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 680;
  }

  :lang(zh-CN) h1 {
    letter-spacing: -0.01em;
    line-height: 1.16;
    font-size: clamp(36px, 5.6vw, 68px);
  }

  h1 span {
    display: block;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 46px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 15px;
    font-weight: 500;
    transition:
      transform 0.2s,
      background 0.2s,
      border-color 0.2s;
  }

  .btn:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn.primary {
    background: var(--text);
    color: var(--bg);
    border-color: transparent;
  }

  .btn.primary:hover {
    background: #fff;
  }

  /* 终端 */
  .term {
    margin: 0;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(20, 23, 32, 0.9), rgba(12, 14, 20, 0.9));
    box-shadow:
      0 40px 120px -40px rgba(143, 162, 255, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-body {
    margin: 0;
    padding: 18px 18px 8px;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .term-body li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    padding: 5px 0;
    opacity: 0;
    animation: line-in 0.5s ease forwards;
    animation-delay: calc(0.5s + var(--i) * 0.32s);
  }

  .no-js .term-body li {
    opacity: 1;
  }

  .tag {
    color: var(--accent);
  }

  .tag-gate {
    color: var(--warm);
  }

  .tag-ok {
    color: var(--ok);
  }

  .text {
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .cursor span {
    grid-column: 1;
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  figcaption {
    padding: 12px 18px 16px;
    font-size: 12px;
    color: var(--text-3);
    border-top: 1px dashed var(--line);
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* 数字 */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(64px, 9vw, 112px) 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    padding: 28px 20px 30px 24px;
    border-left: 1px solid var(--line);
  }

  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  dt {
    font-size: 13px;
    color: var(--text-3);
  }

  dd {
    margin: 6px 0 0;
  }

  .num {
    display: block;
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 650;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .note {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--text-2);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 420px) {
    .term-body li {
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 8px;
    }
    .stat {
      padding-right: 12px;
    }
    .stat:nth-child(even) {
      padding-left: 14px;
    }
  }
</style>
