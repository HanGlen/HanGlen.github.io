---
import Base from '../../layouts/Base.astro';
import CaseHeader from '../CaseHeader.astro';
import Section from '../Section.astro';
import NextWork from '../NextWork.astro';
import Relay from '../Relay.astro';
import Toc from '../Toc.astro';
import type { Content } from '../../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const v = t.tavern;
const base = t.lang === 'zh' ? '' : '/en';
const toc = ['roles', 'gates', 'visuals'].map((id, i) => ({ id, label: v.toc[i] }));
---

<Base lang={t.lang} title={v.title} description={v.description}>
  <CaseHeader kind={v.kind} name={v.name} line={v.line} stats={[]} goal={v.goal} back={t.ui.backHome} backHref={`${base}/`} />

  <section class="wrap hero-wrap">
    <figure class="hero reveal">
      <img src={v.hero} alt={v.heroCap} width="1600" height="900" data-zoom="tavern" />
      <figcaption>{v.heroCap}</figcaption>
    </figure>
  </section>

  <Toc items={toc} label={t.lang === 'zh' ? '目录' : 'Contents'} />

  <Section no="01" title={v.s1} lead={v.s1Lead} id="roles">
    <ul class="roles">
      {
        v.roles.map((r) => (
          <li class="reveal">
            <strong>{r.k}</strong>
            <span>{r.v}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section no="02" title={v.s2} lead={v.s2Lead} id="gates">
    <div class="reveal">
      <Relay legs={v.relay as any} hint={v.relayHint} id="flow" />
    </div>
  </Section>

  <Section no="03" title={v.s3} id="visuals">
    <div class="gallery">
      {
        v.gallery.map((g) => (
          <figure class={`reveal ${g.wide ? 'wide' : ''}`}>
            <img src={g.src} alt={g.cap} loading="lazy" data-zoom="tavern" />
            <figcaption>{g.cap}</figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <NextWork t={t} current="tavern" />
</Base>

<style>
  .hero-wrap {
    margin-top: clamp(48px, 7vw, 88px);
  }

  .hero {
    margin: 0;
  }

  .hero img {
    width: 100%;
    height: auto;
    border-radius: var(--r);
    box-shadow: var(--shadow);
  }

  figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .roles li {
    display: grid;
    gap: 4px;
    padding: 18px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 14px;
    color: var(--ink-2);
  }

  .roles strong {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--ink);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery .wide {
    grid-column: 1 / -1;
  }

  .gallery figure:not(.wide) img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
  }

  .gallery img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .roles {
      grid-template-columns: minmax(0, 1fr);
    }
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
