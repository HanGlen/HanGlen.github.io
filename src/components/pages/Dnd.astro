---
import Base from '../../layouts/Base.astro';
import CaseHeader from '../CaseHeader.astro';
import Section from '../Section.astro';
import Heatmap from '../Heatmap.astro';
import Relay from '../Relay.astro';
import Roles from '../Roles.astro';
import MonthlyBars from '../MonthlyBars.astro';
import UsageChart from '../UsageChart.astro';
import NextWork from '../NextWork.astro';
import Toc from '../Toc.astro';
import Tabs from '../Tabs.astro';
import data from '../../data/dnd.json';
import type { Content } from '../../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const d = t.dnd;
const zh = t.lang === 'zh';
const base = zh ? '' : '/en';
const ids = ['case', 'pipeline', 'throughput', 'feature', 'metrics', 'checks'];
const toc = ids.map((id, i) => ({ id, label: d.toc[i] }));
---

<Base lang={t.lang} title={d.title} description={d.description}>
  <CaseHeader kind={d.kind} name={d.name} line={d.line} stats={d.stats} back={t.ui.backHome} backHref={`${base}/`} />

  <section class="wrap shots-wrap">
    <div class="shots reveal">
      {
        d.shots.map((s) => (
          <figure>
            <img src={s.src} alt={s.cap} loading="lazy" width="455" height="983" />
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="fine">{d.shotsNote}</p>
  </section>

  <Toc items={toc} label={zh ? '目录' : 'Contents'} />

  <Section no="01" title={d.caseTitle} lead={d.caseBody} id="case">
    <div class="reveal">
      <Relay legs={d.relay as any} hint={d.relayHint} id="fb" />
    </div>
  </Section>

  <Section no="02" title={d.roleTitle} lead={d.roleBody} id="pipeline">
    <div class="reveal">
      <Roles start={d.roleStart} mid={d.roleMid} end={d.roleEnd} agents={d.agents} me={zh ? '我' : 'Me'} />
    </div>
  </Section>

  <Section no="03" title={d.trendTitle} lead={d.trendBody} id="throughput">
    <div class="panel reveal"><MonthlyBars lang={t.lang} /></div>
    <div class="panel reveal gap-top"><Heatmap lang={t.lang} /></div>
  </Section>

  <Section no="04" title={d.dayTitle} lead={d.dayBody} id="feature">
    <ol class="day">
      {
        d.day.map((x) => (
          <li class={`reveal ${x.who === 'Claude' ? 'c' : 'x'}`}>
            <time>{x.t}</time>
            <span class="who">{x.who}</span>
            <span>{x.v}</span>
          </li>
        ))
      }
    </ol>
    <p class="aside-note">{d.dayNote}</p>
  </Section>

  <Section no="05" title={d.opsTitle} lead={d.opsBody} id="metrics">
    <div class="reveal">
      <Tabs tabs={d.opsTabs} id="ops">
        <Fragment slot="p0">
          <div class="panel"><UsageChart lang={t.lang} /></div>
          <p class="fine">{d.usageNote}</p>
          <dl class="tiles">
            {
              d.usageStats.map((s) => (
                <div>
                  <dd>{s.v}</dd>
                  <dt>{s.k}</dt>
                </div>
              ))
            }
          </dl>
          <p class="fine">{d.usageSource}</p>
        </Fragment>
        <Fragment slot="p1">
          <dl class="tiles">
            {
              d.feedbackStats.map((s) => (
                <div>
                  <dd>{s.v}</dd>
                  <dt>{s.k}</dt>
                </div>
              ))
            }
          </dl>
          <div class="panel gap-top">
            <MonthlyBars lang={t.lang} series={data.feedback.monthly} label={d.feedbackChart} note={d.feedbackSource} />
          </div>
          <p class="fine">{d.feedbackNote}</p>
        </Fragment>
        <Fragment slot="p2">
          <dl class="tiles three">
            {
              d.contentStats.map((s) => (
                <div>
                  <dd>{s.v}</dd>
                  <dt>{s.k}</dt>
                </div>
              ))
            }
          </dl>
          <p class="fine">{d.contentSource}</p>
        </Fragment>
      </Tabs>
    </div>
  </Section>

  <Section no="06" title={d.gateTitle} lead={d.gateBody} id="checks">
    <ul class="gates">
      {
        d.gates.map((g) => (
          <li class="reveal">
            <span class="x" aria-hidden="true">✕</span>
            <strong>{g.k}</strong>
            <span>{g.v}</span>
          </li>
        ))
      }
    </ul>
    <p class="note-link">
      <a class="link" href="/notes/five-ai-engineers/">{d.noteLink} →</a>
    </p>
    <ul class="chips">
      {d.stack.map((s) => <li class="chip">{s}</li>)}
    </ul>
  </Section>

  <NextWork t={t} current="dnd" />
</Base>

<style>
  .fine {
    margin: 12px 0 0;
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .gap-top {
    margin-top: 16px;
  }

  .shots-wrap {
    margin-top: clamp(48px, 7vw, 88px);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(10px, 1.6vw, 20px);
  }

  .shots figure {
    margin: 0;
    transition: transform 0.3s;
  }

  .shots figure:nth-child(even) {
    margin-top: 28px;
  }

  .shots figure:hover {
    transform: translateY(-6px);
  }

  .shots img {
    width: 100%;
    height: auto;
    border-radius: 22px;
    border: 5px solid #1c1a17;
    box-shadow: var(--shadow);
    background: #1c1a17;
  }

  .shots figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-2);
    text-align: center;
  }

  .panel {
    padding: 22px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
    min-width: 0;
  }

  .tiles {
    margin: 16px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .tiles.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .tiles div {
    padding: 14px 16px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
  }

  .tiles dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
  }

  .tiles dt {
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .aside-note {
    margin: 24px 0 0;
    padding: 14px 16px;
    border-radius: 12px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .day {
    margin: 0;
    padding: 0 0 0 20px;
    list-style: none;
    border-left: 2px solid var(--line-2);
  }

  .day li {
    position: relative;
    display: grid;
    grid-template-columns: 56px 64px minmax(0, 1fr);
    gap: 8px;
    padding: 9px 0;
    font-size: 15px;
  }

  .day li::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 17px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .day li.c::before {
    background: var(--accent);
  }

  time {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    padding-top: 2px;
  }

  .who {
    font-size: 12px;
    font-weight: 600;
    padding-top: 3px;
    color: var(--accent-ink);
  }

  .day li.x .who {
    color: var(--ink-2);
  }

  .gates {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .gates li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .gates .x {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 12px;
    color: var(--accent-ink);
    background: var(--accent-soft);
  }

  .gates strong {
    margin-top: 6px;
    font-size: 16px;
    color: var(--ink);
  }

  .note-link {
    margin: 24px 0 16px;
    font-size: 15px;
  }

  @media (max-width: 960px) {
    .shots {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 40%;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x mandatory;
    }
    .shots figure {
      scroll-snap-align: start;
    }
    .tiles,
    .tiles.three {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .gates {
      grid-template-columns: minmax(0, 1fr);
    }
    .day li {
      grid-template-columns: 48px 56px minmax(0, 1fr);
      font-size: 14px;
    }
  }
</style>
