---
import Base from '../../layouts/Base.astro';
import CaseHeader from '../CaseHeader.astro';
import Heatmap from '../Heatmap.astro';
import Relay from '../Relay.astro';
import Roles from '../Roles.astro';
import MonthlyBars from '../MonthlyBars.astro';
import UsageChart from '../UsageChart.astro';
import NextWork from '../NextWork.astro';
import type { Content } from '../../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const d = t.dnd;
const zh = t.lang === 'zh';
const base = zh ? '' : '/en';
---

<Base lang={t.lang} title={d.title} description={d.description}>
  <CaseHeader kind={d.kind} name={d.name} line={d.line} stats={d.stats} back={t.ui.backHome} backHref={`${base}/`} />

  <section class="wrap section">
    <div class="shots reveal">
      {
        d.shots.map((s) => (
          <figure>
            <img src={s.src} alt={s.cap} loading="lazy" width="455" height="983" />
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="fine">{d.shotsNote}</p>
  </section>

  <section class="wrap section">
    <h2 class="h-section">{d.usageTitle}</h2>
    <div class="usage reveal">
      <div class="panel">
        <UsageChart lang={t.lang} />
        <p class="fine">{d.usageNote}</p>
      </div>
      <dl class="tiles">
        {
          d.usageStats.map((s) => (
            <div>
              <dd class="serif">{s.v}</dd>
              <dt>{s.k}</dt>
            </div>
          ))
        }
      </dl>
    </div>
    <p class="fine">{d.usageSource}</p>
  </section>

  <section class="wrap section">
    <h2 class="h-section">{d.roleTitle}</h2>
    <p class="body">{d.roleBody}</p>
    <div class="reveal gap-top">
      <Roles start={d.roleStart} mid={d.roleMid} end={d.roleEnd} agents={d.agents} me={zh ? '我' : 'Me'} />
    </div>
  </section>

  <section class="wrap section" id="pipeline">
    <h2 class="h-section">{d.caseTitle}</h2>
    <p class="body">{d.caseBody}</p>
    <div class="case-top reveal">
      <blockquote class="quote">
        <p class="serif">“{d.quote}”</p>
        <cite>{d.quoteWho}</cite>
      </blockquote>
      <article class="card-rec">
        <header>{d.issueCard.who}</header>
        {d.issueCard.lines.map((l) => <p>{l}</p>)}
      </article>
    </div>
    <div class="reveal relay-wrap">
      <Relay legs={d.relay} />
    </div>
  </section>

  <section class="wrap section two">
    <div>
      <h2 class="h-section">{d.trendTitle}</h2>
      <p class="body">{d.trendBody}</p>
    </div>
    <div class="panel reveal">
      <MonthlyBars lang={t.lang} />
    </div>
  </section>

  <section class="wrap section">
    <div class="panel reveal">
      <Heatmap lang={t.lang} />
    </div>
  </section>

  <section class="wrap section two">
    <div>
      <h2 class="h-section">{d.dayTitle}</h2>
      <p class="body">{d.dayBody}</p>
      <p class="aside-note">{d.dayNote}</p>
    </div>
    <ol class="day">
      {
        d.day.map((x) => (
          <li class={`reveal ${x.who === 'Claude' ? 'c' : 'x'}`}>
            <time>{x.t}</time>
            <span class="who">{x.who}</span>
            <span>{x.v}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section">
    <h2 class="h-section">{d.gateTitle}</h2>
    <p class="body">{d.gateBody}</p>
    <ul class="gates">
      {
        d.gates.map((g) => (
          <li class="reveal">
            <span class="x" aria-hidden="true">✕</span>
            <strong>{g.k}</strong>
            <span>{g.v}</span>
          </li>
        ))
      }
    </ul>
    <p class="note-link">
      <a class="link" href="/notes/five-ai-engineers/">{d.noteLink} →</a>
    </p>
    <ul class="chips">
      {d.stack.map((s) => <li class="chip">{s}</li>)}
    </ul>
  </section>

  <NextWork t={t} current="dnd" />
</Base>

<style>
  .body {
    margin: 14px 0 0;
    max-width: var(--text);
    font-size: 17px;
    color: var(--ink-2);
  }

  .fine {
    margin: 12px 0 0;
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .gap-top {
    margin-top: 28px;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(10px, 1.6vw, 20px);
  }

  .shots figure {
    margin: 0;
  }

  .shots figure:nth-child(even) {
    margin-top: 28px;
  }

  .shots img {
    width: 100%;
    height: auto;
    border-radius: 22px;
    border: 5px solid var(--ink);
    box-shadow: var(--shadow);
    background: var(--ink);
  }

  .shots figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-2);
    text-align: center;
  }

  .panel {
    padding: 22px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
    min-width: 0;
  }

  .usage {
    margin-top: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.7fr);
    gap: 20px;
  }

  .tiles {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  .tiles div {
    padding: 14px 18px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
  }

  .tiles dd {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
  }

  .tiles dt {
    font-size: 13px;
    color: var(--ink-3);
  }

  .case-top {
    margin: 28px 0 36px;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 20px;
    align-items: stretch;
  }

  .quote {
    margin: 0;
    padding: 22px 24px;
    border-radius: var(--r);
    background: var(--accent-soft);
    border-left: 4px solid var(--accent);
    display: grid;
    align-content: center;
    gap: 8px;
  }

  .quote p {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600;
    line-height: 1.4;
  }

  cite {
    font-style: normal;
    font-size: 13px;
    color: var(--ink-3);
  }

  .card-rec {
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
    padding: 0 0 8px;
    overflow: hidden;
    font-size: 14px;
    color: var(--ink-2);
  }

  .card-rec header {
    padding: 10px 16px;
    font-size: 12.5px;
    font-weight: 600;
    background: var(--bg-2);
    color: var(--ink);
  }

  .card-rec p {
    margin: 10px 16px 0;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.7;
  }

  .relay-wrap {
    padding: 8px 0 0;
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }

  .aside-note {
    margin: 22px 0 0;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--bg-2);
    font-size: 14px;
    color: var(--ink-2);
  }

  .day {
    margin: 0;
    padding: 0 0 0 20px;
    list-style: none;
    border-left: 2px solid var(--line-2);
  }

  .day li {
    position: relative;
    display: grid;
    grid-template-columns: 56px 64px minmax(0, 1fr);
    gap: 8px;
    padding: 9px 0;
    font-size: 15px;
  }

  .day li::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 17px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .day li.c::before {
    background: var(--accent);
  }

  time {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    padding-top: 2px;
  }

  .who {
    font-size: 12px;
    font-weight: 600;
    padding-top: 3px;
    color: var(--accent-ink);
  }

  .day li.x .who {
    color: var(--ink-2);
  }

  .gates {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .gates li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .gates .x {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 12px;
    color: var(--bg);
    background: var(--accent);
  }

  .gates strong {
    margin-top: 6px;
    font-size: 16px;
    color: var(--ink);
  }

  .note-link {
    margin: 28px 0 18px;
    font-size: 15px;
  }

  @media (max-width: 960px) {
    .shots {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 40%;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x mandatory;
    }
    .shots figure {
      scroll-snap-align: start;
    }
    .usage,
    .case-top,
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .gates {
      grid-template-columns: minmax(0, 1fr);
    }
    .day li {
      grid-template-columns: 48px 56px minmax(0, 1fr);
      font-size: 14px;
    }
  }
</style>
