---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import type { Content } from '../../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const n = t.notes;
const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base lang={t.lang} title={n.title} description={n.description}>
  <section class="wrap narrow page">
    <h1 class="h-display">{n.heading}</h1>
    <p class="intro muted">{n.intro}</p>
    <ul class="list">
      {
        notes.map((x) => (
          <li class="reveal">
            <a href={`/notes/${x.id}/`}>
              <span class="meta">
                {x.data.date.toISOString().slice(0, 10)}
                {x.data.draft && <span class="draft">{n.draft}</span>}
              </span>
              <span class="title serif">{x.data.title}</span>
              <span class="sum muted">{x.data.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .intro {
    margin: 16px 0 0;
  }

  .list {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .list a {
    display: grid;
    gap: 4px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .meta {
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .draft {
    font-family: var(--sans);
    font-size: 11px;
    padding: 1px 7px;
    border-radius: 999px;
    border: 1px dashed var(--accent);
    color: var(--accent-ink);
  }

  .title {
    font-size: clamp(21px, 2.6vw, 26px);
    font-weight: 600;
    line-height: 1.35;
    transition: color 0.2s;
  }

  .list a:hover .title {
    color: var(--accent-ink);
  }

  .sum {
    font-size: 15px;
  }
</style>
