---
/**
 * 青岛中小企业会议的网页演讲稿。一屏一页，上下翻页。
 * 不进导航、不让搜索引擎收录；投影时固定浅色。规划见 docs/talk-qingdao-plan.md。
 */
import '../../styles/global.css';
import Cover from '../talk/Cover.astro';
import Network from '../talk/Network.astro';
import Gap from '../talk/Gap.astro';
import Team from '../talk/Team.astro';
import Make from '../talk/Make.astro';
import Keep from '../talk/Keep.astro';
import Any from '../talk/Any.astro';
import Case from '../talk/Case.astro';
import Summary from '../talk/Summary.astro';
import Contact from '../talk/Contact.astro';
import { talk } from '../../i18n/talk';
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{talk.title}</title>
    <meta name="description" content={talk.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="deck" data-deck tabindex="-1">
      <Cover />
      <Network />
      <Gap />
      <Team />
      <Make />
      <Keep />
      <Any />
      <Case />
      <Summary />
      <Contact />
    </main>

    <nav class="dots" aria-label="页码" data-dots></nav>
    <p class="count" aria-hidden="true" data-count></p>
    <p class="keys" aria-hidden="true">{talk.keys}</p>

    <aside class="notes" data-notes-panel hidden aria-live="polite">
      <p class="notes-k">讲者备注 · P 关闭</p>
      <p data-notes-text></p>
    </aside>

    <script>
      const deck = document.querySelector<HTMLElement>('[data-deck]')!;
      const slides = [...deck.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = document.querySelector<HTMLElement>('[data-dots]')!;
      const count = document.querySelector<HTMLElement>('[data-count]')!;
      const notes = document.querySelector<HTMLElement>('[data-notes-panel]')!;
      const notesText = document.querySelector<HTMLElement>('[data-notes-text]')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let cur = 0;

      slides.forEach((s, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', `第 ${i + 1} 页：${s.getAttribute('aria-label') || s.querySelector('h2')?.textContent || ''}`);
        b.addEventListener('click', () => go(i));
        dots.append(b);
      });

      // 宽屏：整页切换（旧页向上淡出、新页从下方浮上来，方向随翻页方向）；窄屏退回普通滚动
      const wide = matchMedia('(min-width: 901px)');
      const fromHash = () => Math.max(0, Math.min(slides.length - 1, (parseInt(location.hash.slice(1), 10) || 1) - 1));
      let lock = 0;

      function mark(i: number) {
        cur = i;
        slides.forEach((s, j) => s.classList.toggle('is-current', j === i));
        [...dots.children].forEach((d, j) => d.toggleAttribute('aria-current', j === i));
        // 页码和页内编号对齐：封面不编号，01 自我介绍就是 01
        count.textContent = i ? `${String(i).padStart(2, '0')} / ${String(slides.length - 1).padStart(2, '0')}` : '';
        document.body.dataset.at = String(i);
        notesText.textContent = slides[i].dataset.notes || '';
        history.replaceState(null, '', i ? `#${i + 1}` : location.pathname);
      }

      function go(i: number) {
        const t = Math.max(0, Math.min(slides.length - 1, i));
        if (!wide.matches) {
          slides[t].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          mark(t);
          return;
        }
        if (t === cur) return;
        // 封面 ↔ 01：封面上的名字变形到 01 的圆心（View Transition）；不支持就走下面的普通翻页
        if (Math.abs(t - cur) === 1 && Math.min(t, cur) === 0 && 'startViewTransition' in document && !reduce) {
          deck.dataset.dir = t > cur ? 'down' : 'up';
          deck.dataset.vtName = '';
          slides.forEach((s) => s.classList.remove('is-leaving', 'vt-in'));
          // 新页的入场动画在变形期间关掉；变形结束后也保持关着（vt-in 留到下次翻页），否则会从头再播一遍，像刷新
          slides[t].classList.add('vt-in');
          document.startViewTransition(() => mark(t)).finished.finally(() => delete deck.dataset.vtName);
          lock = Date.now() + 750;
          return;
        }
        const dir = t > cur ? 'down' : 'up';
        const old = slides[cur];
        slides.forEach((s) => s.classList.remove('vt-in'));
        deck.dataset.dir = dir;
        slides.forEach((s) => s.classList.remove('is-leaving'));
        if (!reduce) {
          old.classList.add('is-leaving');
          setTimeout(() => old.classList.remove('is-leaving'), 750);
        }
        mark(t);
        lock = Date.now() + (reduce ? 200 : 750);
      }

      // 窄屏跟着滚动更新当前页
      const io = new IntersectionObserver(
        (es) => {
          if (wide.matches) return;
          for (const e of es) if (e.isIntersecting) mark(slides.indexOf(e.target as HTMLElement));
        },
        { root: deck, threshold: 0.55 },
      );
      slides.forEach((s) => io.observe(s));

      // 宽屏：滚轮和触摸滑动一次翻一页；页内能滚动的区域先滚完
      deck.addEventListener(
        'wheel',
        (e) => {
          if (!wide.matches) return;
          const inner = (e.target as HTMLElement).closest<HTMLElement>('[data-scroll]');
          if (inner && inner.scrollHeight > inner.clientHeight) return;
          e.preventDefault();
          if (Math.abs(e.deltaY) < 12 || Date.now() < lock) return;
          go(cur + (e.deltaY > 0 ? 1 : -1));
        },
        { passive: false },
      );
      let ty = 0;
      deck.addEventListener('touchstart', (e) => (ty = e.touches[0].clientY), { passive: true });
      deck.addEventListener('touchend', (e) => {
        if (!wide.matches) return;
        const dy = ty - e.changedTouches[0].clientY;
        if (Math.abs(dy) > 50) go(cur + (dy > 0 ? 1 : -1));
      });

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const k = e.key;
        if (k === 'ArrowDown' || k === 'PageDown' || (k === ' ' && !e.shiftKey)) go(cur + 1);
        else if (k === 'ArrowUp' || k === 'PageUp' || (k === ' ' && e.shiftKey)) go(cur - 1);
        else if (k === 'Home') go(0);
        else if (k === 'End') go(slides.length - 1);
        else if (k === 'p' || k === 'P') {
          notes.hidden = !notes.hidden;
          return;
        } else return;
        e.preventDefault();
      });

      // 分步页：[data-stepper] 里的 [data-step] 按钮按顺序排，悬停、聚焦、点击或 ← → 切换；
      // 当前步写进 data-at，[data-pane] 只显示当前那一格
      document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((root) => {
        const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
        const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
        const hover = root.hasAttribute('data-hover');
        // data-vt="2-3 3-4"：列出哪两步之间用 View Transition 变形；切换时把这一对写进 data-vt-pair，
        // 页面 CSS 只在这一对上给元素起 view-transition-name，同名元素就从上一步变形到下一步
        const pairs = (root.dataset.vt ?? '').split(/\s+/).filter(Boolean);
        // 宽屏一页放不下时，把左边的图按比例缩小（zoom 会参与排版），不压到底部的例子色块
        const main = root.querySelector<HTMLElement>('.main');
        const stage = main?.firstElementChild as HTMLElement | null;
        const fit = () => {
          if (!main || !stage) return;
          stage.style.zoom = '';
          if (!wide.matches) return;
          const avail = main.clientHeight;
          const need = stage.getBoundingClientRect().height;
          if (avail > 0 && need > avail) stage.style.zoom = String(Math.max(0.55, Math.floor((avail / need) * 100) / 100));
        };
        if (main) new ResizeObserver(() => fit()).observe(main);
        const sel = (i: number) => {
          const was = Number(root.dataset.at ?? -1);
          if (was === i) return;
          const apply = () => {
            root.dataset.dir = i < was ? 'prev' : 'next';
            root.dataset.at = String(i);
            steps.forEach((s, j) => {
              s.setAttribute('aria-selected', String(i === j));
              s.classList.toggle('seen', j <= i || s.classList.contains('seen'));
            });
            panes.forEach((p) => (p.hidden = p.dataset.pane !== String(i)));
            fit();
            root.dispatchEvent(new CustomEvent('step', { detail: i }));
          };
          const pair = `${Math.min(was, i)}-${Math.max(was, i)}`;
          const morph = pairs.includes(pair) && 'startViewTransition' in document && !reduce && wide.matches;
          if (!morph) {
            delete root.dataset.morph;
            delete root.dataset.vtPair;
            apply();
            return;
          }
          root.dataset.morph = '';
          root.dataset.vtPair = pair;
          document.startViewTransition(apply).finished.finally(() => {
            delete root.dataset.morph;
            delete root.dataset.vtPair;
          });
        };
        steps.forEach((s, i) => {
          s.addEventListener('click', () => sel(i));
          s.addEventListener('focus', () => sel(i));
          if (hover) s.addEventListener('pointerenter', () => sel(i));
        });
        document.addEventListener('keydown', (e) => {
          const slide = root.closest('[data-slide]');
          if (!slide?.classList.contains('is-current')) return;
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          e.preventDefault();
          const at = Number(root.dataset.at ?? -1);
          const n = e.key === 'ArrowRight' ? Math.min(steps.length - 1, at + 1) : Math.max(0, at - 1);
          steps[n].focus({ preventScroll: true });
        });
        root.dataset.at = '-1';
        sel(0);
        delete root.dataset.dir;
      });

      // 读数：[data-reads] 里的 [data-read] 悬停、聚焦或点击时，把它的读数写进同一组的 [data-read-out]；
      // 移开回到 data-hint，点过的那个钉住
      document.querySelectorAll<HTMLElement>('[data-reads]').forEach((root) => {
        const out = root.querySelector<HTMLElement>('[data-read-out]');
        if (!out) return;
        const items = [...root.querySelectorAll<HTMLElement>('[data-read]')];
        let pinned: HTMLElement | null = null;
        const show = (el: HTMLElement | null) => {
          out.textContent = el ? el.dataset.read! : out.dataset.hint || '';
          out.classList.toggle('on', !!el);
          items.forEach((x) => x.toggleAttribute('data-on', x === el));
        };
        items.forEach((el) => {
          if (!el.hasAttribute('tabindex') && !/^(BUTTON|A)$/.test(el.tagName)) el.tabIndex = 0;
          el.addEventListener('mouseenter', () => show(el));
          el.addEventListener('mouseleave', () => show(pinned));
          el.addEventListener('focus', () => show(el));
          el.addEventListener('blur', () => show(pinned));
          el.addEventListener('click', () => {
            pinned = pinned === el ? null : el;
            show(pinned ?? el);
          });
        });
      });

      const first = fromHash();
      mark(first);
      if (!wide.matches && first) slides[first].scrollIntoView({ block: 'start' });
      deck.focus({ preventScroll: true });
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  body {
    font-size: 18px;
    --pad: clamp(16px, 5vw, 96px);
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* 页内左右切换：新的一格按方向横向滑入（→ 从右边来，← 从左边来） */
  [data-stepper][data-dir] [data-pane]:not([hidden]) {
    animation: pane-in 0.5s var(--ease) both;
  }
  /* View Transition 在接管时，格子本身不再滑入，只让同名元素变形 */
  [data-stepper][data-morph] [data-pane]:not([hidden]) {
    animation: none;
  }
  [data-stepper][data-dir='prev'] [data-pane]:not([hidden]) {
    animation-name: pane-in-prev;
  }
  @keyframes pane-in {
    from {
      opacity: 0;
      transform: translateX(48px);
      filter: blur(6px);
    }
  }
  @keyframes pane-in-prev {
    from {
      opacity: 0;
      transform: translateX(-48px);
      filter: blur(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-stepper] [data-pane] {
      animation: none !important;
    }
  }

  body::after {
    z-index: 30;
  }

  /* 封面 ↔ 01 的名字变形：只在这次翻页时起名，两页各有一个同名元素 */
  [data-vt-name] .cover .who b,
  [data-vt-name] .me .center {
    view-transition-name: talk-name;
  }
  [data-vt-name] .slide.is-current,
  [data-vt-name] .slide.is-current .t-body,
  .slide.vt-in.is-current,
  .slide.vt-in.is-current .t-body {
    animation: none !important;
  }
  ::view-transition-group(talk-name) {
    animation-duration: 0.8s;
    animation-timing-function: var(--ease);
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.55s;
  }

  /* 分步页共用版式（03–06）：顶部步骤条、左图右文、底部例子色块。步数写在 style="--n: 5" */
  .t-steps {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2.4vh, 28px);
  }

  /* 顶部步骤 */
  .t-steps .line {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr));
    position: relative;
  }

  .t-steps .line::before {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    height: 2px;
    background: var(--line-2);
  }

  .t-steps .line button {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 0;
    font: inherit;
    color: var(--ink-3);
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
  }

  .t-steps .line i {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-style: normal;
    font-family: var(--mono);
    font-size: 13px;
    background: var(--bg);
    border: 2px solid var(--line-2);
    transition: background 0.3s, border-color 0.3s, color 0.3s, transform 0.3s;
  }

  .t-steps .line span {
    font-size: clamp(15px, 1.3vw, 23px);
    font-weight: 600;
  }

  /* 步骤条只留中文名：英文小标签（Tools、METR…）投影上是噪音，读屏仍能读到中文名 */
  .t-steps .line em {
    display: none;
  }

  .t-steps .line button.seen {
    color: var(--ink-2);
  }

  .t-steps .line button.seen i {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .t-steps .line button[aria-selected='true'] {
    color: var(--ink);
  }

  .t-steps .line button[aria-selected='true'] em {
    color: var(--accent-ink);
  }

  .t-steps .line button[aria-selected='true'] i {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    transform: scale(1.15);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .t-steps .main {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(280px, 1fr);
    gap: clamp(24px, 3.4vw, 64px);
    align-items: center;
  }

  .t-steps .frame {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 22px);
  }

  .t-steps .frame[hidden],
  .t-steps .sp[hidden] {
    display: none;
  }

  /* 右边：一个问题、一句大白话、一个例子 */
  .t-steps .side {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .t-steps .sp p {
    margin: 0;
  }

  .t-steps .sp h3 {
    margin: 0 0 14px;
    font-size: clamp(28px, 2.6vw, 46px);
    font-weight: 600;
    line-height: 1.15;
  }

  .t-steps .plain {
    margin: 0 !important;
    color: var(--ink-2);
    font-size: clamp(17px, 1.5vw, 26px);
    line-height: 1.5;
  }

  /* 底部例子色块 */
  .t-steps .ex {
    display: flex;
    align-items: baseline;
    gap: 8px clamp(12px, 1.4vw, 24px);
    padding: clamp(10px, 1.6vh, 18px) clamp(16px, 1.6vw, 28px);
    border-radius: var(--r);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .t-steps .ex[hidden] {
    display: none;
  }

  .t-steps .ex > b {
    flex: none;
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--bg);
    font-size: clamp(12px, 0.95vw, 15px);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .t-steps .ex > p {
    flex: 1;
    margin: 0;
    font-size: clamp(16px, 1.35vw, 24px);
    line-height: 1.45;
  }

  .t-steps details.src {
    position: relative;
    flex: none;
    font-size: clamp(12px, 0.95vw, 15px);
    color: var(--ink-3);
  }

  .t-steps details.src summary {
    cursor: pointer;
    letter-spacing: 0.08em;
  }

  .t-steps details.src summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 依据向上弹出，不把色块撑高 */
  .t-steps details.src p {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    width: min(36em, 60vw);
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--card);
    box-shadow: var(--shadow);
    line-height: 1.55;
    color: var(--ink-2);
    z-index: 5;
  }

  /* 翻页动效：元素错峰淡入 */
  .t-steps .frame:not([hidden]) .fin {
    animation: t-fin 0.45s var(--ease) both;
    animation-delay: calc(0.2s + var(--d, 0) * 0.07s);
  }

  @keyframes t-fin {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }


  @media (max-width: 900px) {
    .t-steps .main {
      grid-template-columns: 1fr;
    }
    .t-steps .line {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 12px;
    }
    .t-steps .line::before {
      display: none;
    }
    .t-steps .line span {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .t-steps .frame .fin {
      animation: none !important;
    }
  }

  /* 第 2 部分以后的页面共用的页头和版式 */
  .t-slide {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 5vh, 64px) var(--pad) clamp(36px, 6vh, 64px);
    gap: clamp(14px, 2.4vh, 28px);
  }

  .t-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 6px 20px;
  }

  .t-head .no {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(14px, 1.1vw, 18px);
    color: var(--accent-ink);
  }

  .t-head .kicker {
    margin: 0;
    font-size: clamp(14px, 1.1vw, 18px);
    color: var(--accent-ink);
    letter-spacing: 0.08em;
  }

  .t-head h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(32px, 3.4vw, 60px);
    line-height: 1.1;
  }

  .t-head .lead {
    grid-column: 2;
    margin: 0;
    font-size: clamp(16px, 1.4vw, 24px);
    color: var(--ink-2);
  }

  /* 分步页：副标题只在第 1 步出现，往后收起来，把位置让给图（宽屏；手机上是普通滚动，不收） */
  @media (min-width: 901px) {
    .t-head .lead {
      max-height: 3em;
      overflow: hidden;
      transition: max-height 0.45s var(--ease), opacity 0.3s;
    }
    .t-slide:not(.sum):has([data-stepper]:not([data-at='0'])) .t-head .lead {
      max-height: 0;
      opacity: 0;
    }
  }

  .t-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .t-tabs button {
    font: inherit;
    font-size: clamp(15px, 1.25vw, 22px);
    padding: 0.4em 1em;
    border-radius: var(--r-pill);
    border: 1.5px solid var(--line-2);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .t-tabs button[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  /* 分步按钮获得焦点就是被选中，选中样式已经够醒目，不再叠一圈焦点框 */
  .t-slide [data-step]:focus-visible {
    outline: none;
  }

  /* 「← → 下一步」「悬停看读数」这类操作提示只给讲者，投影时不显示；读屏和键盘照常能用 */
  .t-hint {
    display: none;
  }

  [data-hint^='悬停']:not(.on),
  [data-hint^='鼠标']:not(.on) {
    opacity: 0;
  }

  /* 读数行：悬停一个数据点时换成它的读数 */
  .t-read {
    margin: 0;
    min-height: 1.5em;
    font-size: clamp(14px, 1.1vw, 19px);
    color: var(--ink-3);
    transition: color 0.2s;
  }

  .t-read.on {
    color: var(--ink);
  }

  [data-read] {
    cursor: pointer;
  }

  [data-read]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .t-src {
    margin: 0;
    font-size: clamp(12px, 0.9vw, 15px);
    line-height: 1.5;
    color: var(--ink-3);
  }

  .t-src b {
    color: var(--ink-2);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .t-head .lead {
      grid-column: 1 / -1;
    }
  }
</style>

<style>
  .deck {
    position: relative;
    height: 100svh;
    overflow: hidden;
    outline: none;
  }

  /* 宽屏：所有页叠在一起，只显示当前页和正在离开的那页 */
  .deck :global(.slide) {
    position: absolute;
    inset: 0;
    height: 100svh;
    min-height: 560px;
    pointer-events: none;
  }

  /* 不在台上的页直接不渲染：子元素的 visibility 盖不过它，再进来时动画也会重播 */
  .deck :global(.slide:not(.is-current):not(.is-leaving)) {
    display: none;
  }

  .deck :global(.slide.is-current) {
    pointer-events: auto;
    z-index: 2;
    animation: deck-in 0.75s var(--ease) both;
  }

  .deck :global(.slide.is-leaving) {
    z-index: 1;
    animation: deck-out 0.6s var(--ease) both;
  }

  .deck[data-dir='up'] :global(.slide.is-current) {
    animation-name: deck-in-up;
  }

  .deck[data-dir='up'] :global(.slide.is-leaving) {
    animation-name: deck-out-up;
  }

  /* 新页里的标题、导语、正文错峰浮现（模糊 → 清晰） */
  .deck :global(.slide.is-current .t-head > *),
  .deck :global(.slide.is-current > .head > *),
  .deck :global(.slide.is-current .t-body) {
    animation: deck-rise 0.8s var(--ease) both;
  }
  .deck :global(.slide.is-current .t-head > :nth-child(2)),
  .deck :global(.slide.is-current > .head > :nth-child(2)) {
    animation-delay: 0.08s;
  }
  .deck :global(.slide.is-current .t-head > :nth-child(3)),
  .deck :global(.slide.is-current > .head > :nth-child(3)) {
    animation-delay: 0.16s;
  }
  .deck :global(.slide.is-current .t-body) {
    animation-delay: 0.22s;
  }

  @keyframes deck-in {
    from {
      opacity: 0;
      transform: translateY(7vh) scale(0.985);
      filter: blur(10px);
    }
  }

  @keyframes deck-out {
    to {
      opacity: 0;
      transform: translateY(-7vh) scale(0.97);
      filter: blur(8px);
    }
  }

  @keyframes deck-in-up {
    from {
      opacity: 0;
      transform: translateY(-7vh) scale(0.985);
      filter: blur(10px);
    }
  }

  @keyframes deck-out-up {
    to {
      opacity: 0;
      transform: translateY(7vh) scale(0.97);
      filter: blur(8px);
    }
  }

  @keyframes deck-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
  }

  .dots {
    position: fixed;
    right: clamp(10px, 1.6vw, 28px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 20;
  }

  .dots :global(button) {
    width: 10px;
    height: 10px;
    padding: 0;
    border-radius: 50%;
    border: 1.5px solid var(--ink-3);
    background: transparent;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .dots :global(button[aria-current]) {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.25);
  }

  .dots :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .count {
    position: fixed;
    right: clamp(10px, 1.6vw, 28px);
    top: clamp(12px, 2vh, 24px);
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    z-index: 20;
  }

  .keys {
    position: fixed;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    margin: 0;
    font-size: 12px;
    color: var(--ink-3);
    opacity: 0.7;
    z-index: 20;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.4s;
  }

  /* 按键提示只在封面出现一次，翻进正文就收起 */
  :global(body:not([data-at='0'])) .keys {
    opacity: 0;
  }

  .notes {
    position: fixed;
    left: 50%;
    bottom: 40px;
    transform: translateX(-50%);
    width: min(92vw, 760px);
    padding: 16px 20px;
    border-radius: var(--r);
    background: var(--ink);
    color: var(--bg);
    font-size: 17px;
    line-height: 1.6;
    box-shadow: var(--shadow);
    z-index: 50;
  }

  .notes p {
    margin: 0;
  }

  .notes-k {
    margin-bottom: 6px !important;
    font-family: var(--mono);
    font-size: 12px;
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .deck {
      overflow-y: auto;
      overflow-x: hidden;
    }
    .deck :global(.slide),
    .deck :global(.slide:not(.is-current):not(.is-leaving)) {
      display: flex;
      position: relative;
      inset: auto;
      height: auto;
      min-height: 100svh;
      pointer-events: auto;
      animation: none !important;
    }
    .keys,
    .dots {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck :global(.slide),
    .deck :global(.slide *) {
      animation: none !important;
    }
  }
</style>
