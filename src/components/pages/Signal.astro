---
import Base from '../../layouts/Base.astro';
import CaseHeader from '../CaseHeader.astro';
import Toc from '../Toc.astro';
import Section from '../Section.astro';
import NextWork from '../NextWork.astro';
import type { Content } from '../../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const s = t.signal;
const base = t.lang === 'zh' ? '' : '/en';
const ids = ['why', 'architecture', 'built', 'reports', 'competition'];
const toc = ids.map((id, i) => ({ id, label: s.toc[i] }));
---

<Base lang={t.lang} title={s.title} description={s.description}>
  <CaseHeader kind={s.kind} name={s.name} line={s.line} stats={s.stats} badges={s.badges} back={t.ui.backHome} backHref={`${base}/`} />

  <section class="wrap hero-wrap">
    <figure class="hero-shot reveal">
      <img src={s.heroShot} alt={s.heroCap} width="1550" height="1020" data-zoom="signal" />
      <figcaption>{s.heroCap}</figcaption>
    </figure>
  </section>

  <Toc items={toc} label={t.lang === 'zh' ? '目录' : 'Contents'} />

  <Section no="01" title={s.s1} id="why">
    <p class="body">{s.s1Body}</p>
  </Section>

  <Section no="02" title={s.s2} id="architecture">
    <ol class="arch reveal">
      {
        s.arch.map((a, i) => (
          <li>
            <span class="n">L{i + 1}</span>
            <strong class="serif">{a.k}</strong>
            <ul>
              {a.v.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section no="03" title={s.s3} id="built">
    <div class="mods">
      {
        s.modules.map((m) => (
          <article class={`mod reveal ${m.span ? 'span' : ''}`}>
            {m.shot && <img class="mod-img" src={m.shot} alt={m.name} loading="lazy" data-zoom="signal" />}
            <div class="mod-top">
              <h3 class="serif">{m.name}</h3>
              {m.badge && <span class="badge">{m.badge}</span>}
            </div>
            <p>{m.v}</p>
            <p class="mono">{m.stack}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section no="04" title={s.s5} lead={s.s5Lead} id="reports">
    <div class="reports reveal">
      {
        s.reports.map((r) => (
          <figure>
            <img src={r.src} alt={r.cap} loading="lazy" width="557" height="786" data-zoom="signal" />
            <figcaption>{r.cap}</figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <Section no="05" title={s.s4} id="competition">
    <div class="honors reveal">
      <figure class="photo">
        <img src={s.photo} alt={s.photoCap} loading="lazy" width="1080" height="1440" data-zoom="signal" />
        <figcaption>{s.photoCap}</figcaption>
      </figure>
      <div>
        <p class="certs-k">{s.certsTitle}</p>
        <ul class="certs">
          {s.certs.map((c, i) => <li class={i === 0 ? 'top' : ''}>{c}</li>)}
        </ul>
      </div>
    </div>
    <p class="note-link">
      <a class="link" href="/notes/biosignal-devlog/">{s.noteLink} →</a>
    </p>
    <ul class="chips">
      {s.stack.map((x) => <li class="chip">{x}</li>)}
    </ul>
  </Section>

  <NextWork t={t} current="signal" />
</Base>

<style>
  .hero-wrap {
    margin-top: clamp(48px, 7vw, 88px);
  }

  .hero-shot {
    margin: 0;
  }

  .hero-shot img,
  .mod-img {
    width: 100%;
    height: auto;
    border-radius: var(--r);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .mod-img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .honors {
    margin-top: 28px;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 20px;
    align-items: start;
  }

  .photo {
    margin: 0;
  }

  .photo img {
    width: 100%;
    height: auto;
    border-radius: var(--r);
  }



  .body {
    margin: 0;
    font-size: 17px;
    color: var(--ink-2);
  }

  .arch {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    counter-reset: l;
  }

  .arch > li {
    position: relative;
    padding: 18px;
    border-radius: var(--r);
    background: var(--card);
    border: 1px solid var(--line);
    display: grid;
    align-content: start;
    gap: 4px;
  }

  .arch > li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -19px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 14px;
  }

  .n {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent-ink);
  }

  .arch strong {
    font-size: 20px;
  }

  .arch ul {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    color: var(--ink-2);
    display: grid;
    gap: 4px;
  }

  .mods {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 20px;
  }

  .mod p {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }

  .mod-top {
    margin-top: 16px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .mod h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 600;
  }

  .badge {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--accent-ink);
    background: var(--accent-soft);
    white-space: nowrap;
  }

  .mono {
    font-family: var(--mono);
    font-size: 12px !important;
    color: var(--ink-3) !important;
  }

  .certs-k {
    margin: 0 0 10px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .certs li {
    padding: 14px 16px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 15px;
    color: var(--ink-2);
  }

  .certs li.top {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    background: var(--accent-soft);
  }

  .mod.span {
    grid-column: 1 / -1;
  }

  .mod.span .mod-img {
    aspect-ratio: auto;
  }

  .reports {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .reports figure {
    margin: 0;
    transition: transform 0.3s;
  }

  .reports figure:hover {
    transform: translateY(-4px);
  }

  .reports img {
    width: 100%;
    height: auto;
    border-radius: var(--r);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .note-link {
    margin: 32px 0 20px;
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .arch {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .arch > li:not(:last-child)::after {
      content: '↓';
      right: auto;
      left: 24px;
      top: auto;
      bottom: -21px;
      transform: none;
    }
    .arch > li {
      grid-template-columns: 28px 80px minmax(0, 1fr);
      align-items: baseline;
    }
    .arch ul {
      margin: 0;
    }
    .honors {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .mods {
      grid-template-columns: minmax(0, 1fr);
    }
    .arch > li {
      grid-template-columns: 28px minmax(0, 1fr);
    }
    .arch ul {
      grid-column: 2;
    }
  }
</style>
