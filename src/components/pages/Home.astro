---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import Heatmap from '../Heatmap.astro';
import type { Content } from '../../i18n/zh';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const h = t.home;
const zh = t.lang === 'zh';
const base = zh ? '' : '/en';
const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const [lead, ...rest] = t.work;
---

<Base lang={t.lang} title={h.title} description={h.description}>
  <section class="wrap hero">
    <p class="eyebrow reveal">{h.hello}</p>
    <h1 class="reveal">{h.line}</h1>
    <p class="sub reveal">{h.sub}</p>
    <div class="cta reveal">
      <a class="btn primary" href={`${base}/work/dnd/#case`}>{h.cta} →</a>
      <a class="btn" href={`${base}/about/#cv`}>{h.openLink}</a>
      <span class="open"><span class="pulse" aria-hidden="true"></span>{h.open}</span>
    </div>
    <dl class="proof reveal">
      {
        h.proof.map((p) => (
          <div>
            <dd>{p.v}</dd>
            <dt>{p.k}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  <Section no="01" title={h.workTitle} lead={h.workLead} id="work">
    <a class="feature reveal" href={`${base}/work/${lead.slug}/`}>
      <div class="f-text">
        <p class="eyebrow">{lead.kind}</p>
        <h3>{lead.name}</h3>
        <p class="muted">{lead.line}</p>
        <p class="stat">{lead.stat}</p>
        <span class="more">{t.ui.readMore} →</span>
      </div>
      <div class="f-shots" aria-hidden="true">
        <img src={lead.shot} alt="" loading="lazy" width="455" height="983" />
        <img src={lead.shot2} alt="" loading="lazy" width="455" height="983" />
      </div>
    </a>
    {
      rest.map((w) => (
        <a class="row reveal" href={`${base}/work/${w.slug}/`}>
          <img src={w.shot} alt="" loading="lazy" />
          <div>
            <p class="eyebrow">{w.kind}</p>
            <h3>{w.name}</h3>
            <p class="muted">{w.line}</p>
            <p class="stat">{w.stat}</p>
          </div>
        </a>
      ))
    }
  </Section>

  <Section no="02" title={h.heatTitle} lead={h.dataLead}>
    <div class="panel reveal"><Heatmap lang={t.lang} compact /></div>
    <a class="link small" href={`${base}/work/dnd/#case`}>{h.heatMore} →</a>
  </Section>

  <Section no="03" title={h.nowTitle}>
    <ul class="now reveal">
      {t.now.short.map((x) => <li>{x}</li>)}
    </ul>
    <a class="link small" href={`${base}/now/`}>{h.nowMore} →</a>
  </Section>

  <Section no="04" title={h.notesTitle}>
    <ul class="notes reveal">
      {
        notes.map((n) => (
          <li>
            <a href={`/notes/${n.id}/`}>
              <span class="nt">{n.data.title}</span>
              <span class="nd">{fmt(n.data.date)}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="link small" href={`${base}/notes/`}>{h.notesMore} →</a>
  </Section>
</Base>

<style>
  .hero {
    padding-top: clamp(64px, 12vw, 160px);
  }

  h1 {
    margin: 18px 0 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(42px, 8vw, 96px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    max-width: 12em;
    white-space: pre-line;
  }

  :lang(zh-CN) h1 {
    letter-spacing: -0.01em;
    font-size: clamp(30px, 8.2vw, 88px);
  }

  .sub {
    margin: 28px 0 0;
    max-width: 34em;
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.7;
    color: var(--ink-2);
  }

  .cta {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-size: 15px;
    transition: transform 0.2s, background 0.2s, border-color 0.2s;
  }

  .btn:hover {
    transform: translateY(-1px);
    border-color: var(--ink-3);
  }

  .primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .primary:hover {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3f9b62;
    box-shadow: 0 0 0 4px rgba(63, 155, 98, 0.18);
  }

  .proof {
    margin: clamp(56px, 8vw, 96px) 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
  }

  .proof div {
    padding: 18px 20px 0 0;
  }

  .proof dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(30px, 3.8vw, 46px);
    font-weight: 600;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .proof dt {
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--ink-3);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 24px;
    align-items: center;
    padding: clamp(22px, 3vw, 36px);
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--card);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s;
  }

  .feature:hover,
  .row:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }

  .feature:hover h3,
  .row:hover h3 {
    color: var(--accent-ink);
  }

  h3 {
    margin: 8px 0 8px;
    font-family: var(--serif);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    transition: color 0.2s;
  }

  .f-text p {
    margin: 0;
  }

  .stat {
    margin-top: 14px !important;
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .more {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .f-shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: -60px;
  }

  .f-shots img,
  .row img {
    width: 100%;
    height: auto;
  }

  .f-shots img {
    border-radius: 22px;
    border: 4px solid #1c1a17;
    background: #1c1a17;
    box-shadow: var(--shadow);
  }

  .f-shots img:last-child {
    margin-top: 48px;
  }

  .row {
    margin-top: 16px;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    padding: 18px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--card);
    transition: border-color 0.25s, transform 0.25s;
  }

  .row img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .row p {
    margin: 0;
  }

  .row h3 {
    font-size: clamp(22px, 2.4vw, 28px);
  }

  .panel {
    padding: 22px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--card);
  }

  .small {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
  }

  .now,
  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .now li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 19px;
  }

  .notes a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .nt {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 600;
    transition: color 0.2s;
  }

  .notes a:hover .nt {
    color: var(--accent-ink);
  }

  .nd {
    flex-shrink: 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  @media (max-width: 760px) {
    .proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 10px;
    }
    .feature,
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .f-shots {
      max-width: 320px;
      margin: 0 auto -80px;
    }
  }
</style>
